---
interface Props {
  src?: string;
  preload?: "none" | "metadata" | "auto";
  ariaLabel: string;
  engineRole?: "daily" | "analysis";
  visualVariant?: "minimal" | "radio";
}

const {
  src,
  preload = "metadata",
  ariaLabel,
  engineRole,
  visualVariant = "minimal",
} = Astro.props;
const engineAttributes: Record<string, string> = {};
if (engineRole === "daily") engineAttributes["data-audio-player"] = "";
if (engineRole === "analysis") engineAttributes["data-analysis-player"] = "";

const waveformHeights = [
  34, 48, 66, 42, 58, 72, 46, 62, 38, 54, 68, 44, 32, 52, 64, 40, 56, 70, 48,
  36, 60, 46, 66, 42, 54, 34, 62, 50, 70, 44, 58, 38, 64, 48, 56, 40, 68, 46,
  60, 34,
];
---

<div
  class={`atlas-audio-player atlas-audio-player--${visualVariant}`}
  data-atlas-audio
  data-playing="false"
>
  <button
    class="atlas-audio-toggle"
    type="button"
    data-atlas-audio-toggle
    aria-label={`Reproducir ${ariaLabel}`}
    aria-pressed="false"
  >
    <span data-atlas-audio-icon aria-hidden="true">▶</span>
  </button>

  <span class="atlas-audio-time" data-atlas-audio-current>00:00</span>

  {
    visualVariant === "radio" ? (
      <div class="atlas-audio-waveform-control">
        <div
          class="atlas-audio-waveform"
          data-atlas-audio-waveform
          aria-hidden="true"
        >
          {waveformHeights.map((height) => (
            <span
              class="atlas-audio-waveform-bar"
              data-atlas-audio-wave-bar
              data-played="false"
              style={`--wave-height: ${height}%`}
            />
          ))}
        </div>
        <input
          class="atlas-audio-progress atlas-audio-progress--waveform"
          data-atlas-audio-progress
          type="range"
          min="0"
          max="1000"
          step="1"
          value="0"
          aria-label={`Posición de ${ariaLabel}`}
          disabled
        />
      </div>
    ) : (
      <input
        class="atlas-audio-progress"
        data-atlas-audio-progress
        type="range"
        min="0"
        max="1000"
        step="1"
        value="0"
        aria-label={`Posición de ${ariaLabel}`}
        disabled
      />
    )
  }

  <span class="atlas-audio-duration" data-atlas-audio-duration>--:--</span>

  <audio
    class="atlas-audio-engine"
    preload={preload}
    aria-label={ariaLabel}
    data-atlas-audio-engine
    {...engineAttributes}
  >
    <source src={src} data-atlas-audio-source type="audio/mpeg" />
  </audio>
</div>

<script>
  const formatAtlasAudioTime = (seconds: number) => {
    if (!Number.isFinite(seconds) || seconds < 0) return "--:--";
    const wholeSeconds = Math.floor(seconds);
    const minutes = Math.floor(wholeSeconds / 60);
    const remainder = wholeSeconds % 60;
    return `${String(minutes).padStart(2, "0")}:${String(remainder).padStart(2, "0")}`;
  };

  const initAtlasAudioPlayer = (root: Element) => {
    if (
      !(root instanceof HTMLElement) ||
      root.dataset.atlasAudioReady === "true"
    ) {
      return;
    }

    const audio = root.querySelector("[data-atlas-audio-engine]");
    const toggle = root.querySelector("[data-atlas-audio-toggle]");
    const icon = root.querySelector("[data-atlas-audio-icon]");
    const current = root.querySelector("[data-atlas-audio-current]");
    const duration = root.querySelector("[data-atlas-audio-duration]");
    const progress = root.querySelector("[data-atlas-audio-progress]");
    const waveformBars = root.querySelectorAll("[data-atlas-audio-wave-bar]");

    if (
      !(audio instanceof HTMLAudioElement) ||
      !(toggle instanceof HTMLButtonElement) ||
      !(icon instanceof HTMLElement) ||
      !(current instanceof HTMLElement) ||
      !(duration instanceof HTMLElement) ||
      !(progress instanceof HTMLInputElement)
    ) {
      return;
    }

    root.dataset.atlasAudioReady = "true";

    const originalLabel =
      audio.getAttribute("aria-label") || "audio de ATLAS NEWS";

    const setPlaying = (playing: boolean) => {
      root.dataset.playing = String(playing);
      icon.textContent = playing ? "Ⅱ" : "▶";
      toggle.setAttribute(
        "aria-label",
        `${playing ? "Pausar" : "Reproducir"} ${originalLabel}`,
      );
      toggle.setAttribute("aria-pressed", String(playing));
    };

    const syncDuration = () => {
      const total = audio.duration;
      const ready = Number.isFinite(total) && total > 0;
      duration.textContent = ready ? formatAtlasAudioTime(total) : "--:--";
      progress.disabled = !ready;
    };

    const syncProgress = () => {
      const total = audio.duration;
      const elapsed = Number.isFinite(audio.currentTime)
        ? audio.currentTime
        : 0;
      current.textContent = formatAtlasAudioTime(elapsed);

      const ratio = Number.isFinite(total) && total > 0 ? elapsed / total : 0;
      const normalizedRatio = Math.max(0, Math.min(1, ratio));
      const value = Math.round(normalizedRatio * 1000);
      progress.value = String(value);
      progress.style.setProperty("--audio-progress", `${value / 10}%`);

      const playedBars =
        normalizedRatio > 0
          ? Math.ceil(normalizedRatio * waveformBars.length)
          : 0;
      waveformBars.forEach((bar, index) => {
        if (bar instanceof HTMLElement) {
          bar.dataset.played = String(index < playedBars);
        }
      });
    };

    toggle.addEventListener("click", async () => {
      if (audio.paused || audio.ended) {
        if (audio.ended) audio.currentTime = 0;
        try {
          await audio.play();
        } catch {
          setPlaying(false);
        }
      } else {
        audio.pause();
      }
    });

    progress.addEventListener("input", () => {
      if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
      audio.currentTime = (Number(progress.value) / 1000) * audio.duration;
      syncProgress();
    });

    audio.addEventListener("loadedmetadata", () => {
      syncDuration();
      syncProgress();
    });
    audio.addEventListener("durationchange", syncDuration);
    audio.addEventListener("timeupdate", syncProgress);
    audio.addEventListener("play", () => setPlaying(true));
    audio.addEventListener("pause", () => setPlaying(false));
    audio.addEventListener("ended", () => {
      setPlaying(false);
      syncProgress();
    });
    audio.addEventListener("emptied", () => {
      current.textContent = "00:00";
      duration.textContent = "--:--";
      progress.value = "0";
      progress.style.setProperty("--audio-progress", "0%");
      progress.disabled = true;
      waveformBars.forEach((bar) => {
        if (bar instanceof HTMLElement) bar.dataset.played = "false";
      });
      setPlaying(false);
    });

    setPlaying(!audio.paused && !audio.ended);
    syncDuration();
    syncProgress();
  };

  const initAtlasAudioPlayers = () => {
    document
      .querySelectorAll("[data-atlas-audio]")
      .forEach(initAtlasAudioPlayer);
  };

  initAtlasAudioPlayers();
  document.addEventListener("astro:page-load", initAtlasAudioPlayers);
</script>

<style>
  .atlas-audio-player {
    display: grid;
    grid-template-columns: 2.6rem 3.35rem minmax(0, 1fr) 3.35rem;
    gap: 0.72rem;
    align-items: center;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    padding: 0.68rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--sans);
  }

  .atlas-audio-engine {
    display: none;
  }

  .atlas-audio-toggle {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(31, 29, 23, 0.18);
    border-radius: 0;
    color: var(--ink);
    background: rgba(31, 29, 23, 0.045);
    cursor: pointer;
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      transform 140ms ease;
  }

  .atlas-audio-toggle:hover {
    background: rgba(31, 29, 23, 0.065);
    transform: translateY(-1px);
  }

  .atlas-audio-player[data-playing="true"] .atlas-audio-toggle {
    border-color: rgba(153, 47, 36, 0.42);
    background: rgba(31, 29, 23, 0.045);
  }

  .atlas-audio-toggle:focus-visible,
  .atlas-audio-progress:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .atlas-audio-player--minimal {
    grid-template-columns: 2.6rem 3.35rem minmax(0, 1fr) 3.35rem;
  }

  .atlas-audio-player--minimal .atlas-audio-toggle {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgba(31, 29, 23, 0.18);
    color: var(--ink);
    background: rgba(31, 29, 23, 0.045);
  }

  .atlas-audio-player--minimal[data-playing="true"] .atlas-audio-toggle {
    border-color: rgba(153, 47, 36, 0.42);
    background: rgba(31, 29, 23, 0.045);
  }

  .atlas-audio-player--radio {
    grid-template-columns: 2.8rem 3.35rem minmax(0, 1fr) 3.35rem;
    gap: 0.76rem;
    padding: 0.64rem 0;
  }

  .atlas-audio-player--radio .atlas-audio-toggle {
    width: 2.576rem;
    height: 2.576rem;
    border: 0;
    border-radius: 0.55rem;
    background: rgba(31, 29, 23, 0.022);
  }

  .atlas-audio-player--radio .atlas-audio-toggle:hover {
    background: rgba(31, 29, 23, 0.035);
    transform: none;
  }

  .atlas-audio-player--radio[data-playing="true"] .atlas-audio-toggle {
    border: 0;
    background: rgba(153, 47, 36, 0.035);
  }

  .atlas-audio-player--minimal [data-atlas-audio-icon],
  .atlas-audio-player--radio [data-atlas-audio-icon] {
    position: relative;
    display: block;
    width: 0.82rem;
    height: 0.92rem;
    overflow: visible;
    font-size: 0;
    line-height: 0;
  }

  .atlas-audio-player--minimal [data-atlas-audio-icon]::before,
  .atlas-audio-player--minimal [data-atlas-audio-icon]::after,
  .atlas-audio-player--radio [data-atlas-audio-icon]::before,
  .atlas-audio-player--radio [data-atlas-audio-icon]::after {
    position: absolute;
    inset: 0;
    margin: auto;
    content: "";
    transition:
      opacity 110ms ease-out,
      transform 110ms ease-out;
  }

  .atlas-audio-player--minimal [data-atlas-audio-icon]::before,
  .atlas-audio-player--radio [data-atlas-audio-icon]::before {
    width: 0;
    height: 0;
    border-top: 0.47rem solid transparent;
    border-bottom: 0.47rem solid transparent;
    border-left: 0.72rem solid var(--ink);
    opacity: 1;
    transform: translateX(0.05rem) scale(1);
  }

  .atlas-audio-player--minimal [data-atlas-audio-icon]::after,
  .atlas-audio-player--radio [data-atlas-audio-icon]::after {
    width: 0.82rem;
    height: 0.92rem;
    background: linear-gradient(
      to right,
      var(--accent) 0 0.19rem,
      transparent 0.19rem 0.63rem,
      var(--accent) 0.63rem 0.82rem
    );
    opacity: 0;
    transform: scale(0.9);
  }

  .atlas-audio-player--radio [data-atlas-audio-icon]::before {
    border-left-color: rgba(31, 29, 23, 0.72);
  }

  .atlas-audio-player--radio [data-atlas-audio-icon]::after {
    background: linear-gradient(
      to right,
      rgba(153, 47, 36, 0.62) 0 0.19rem,
      transparent 0.19rem 0.63rem,
      rgba(153, 47, 36, 0.62) 0.63rem 0.82rem
    );
  }

  .atlas-audio-player--minimal[data-playing="true"]
    [data-atlas-audio-icon]::before,
  .atlas-audio-player--radio[data-playing="true"]
    [data-atlas-audio-icon]::before {
    opacity: 0;
    transform: translateX(0.05rem) scale(0.9);
  }

  .atlas-audio-player--minimal[data-playing="true"]
    [data-atlas-audio-icon]::after,
  .atlas-audio-player--radio[data-playing="true"]
    [data-atlas-audio-icon]::after {
    opacity: 1;
    transform: scale(1);
  }

  .atlas-audio-time,
  .atlas-audio-duration {
    color: var(--ink-soft);
    font: 800 0.72rem/1 var(--sans);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.055em;
    white-space: nowrap;
  }

  .atlas-audio-time {
    color: var(--ink);
  }

  .atlas-audio-duration {
    text-align: right;
  }

  .atlas-audio-progress {
    --audio-progress: 0%;

    width: 100%;
    min-width: 0;
    height: 1.55rem;
    margin: 0;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    cursor: pointer;
  }

  .atlas-audio-progress:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .atlas-audio-progress::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(
      to right,
      var(--accent) 0 var(--audio-progress),
      var(--rule) var(--audio-progress) 100%
    );
  }

  .atlas-audio-progress::-webkit-slider-thumb {
    width: 0.82rem;
    height: 0.82rem;
    margin-top: -0.36rem;
    appearance: none;
    -webkit-appearance: none;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 0 0 2px var(--paper);
  }

  .atlas-audio-player[data-playing="true"]
    .atlas-audio-progress::-webkit-slider-thumb {
    border-color: var(--accent);
  }

  .atlas-audio-progress::-moz-range-track {
    height: 2px;
    background: var(--rule);
  }

  .atlas-audio-progress::-moz-range-progress {
    height: 2px;
    background: var(--accent);
  }

  .atlas-audio-progress::-moz-range-thumb {
    width: 0.82rem;
    height: 0.82rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 0 0 2px var(--paper);
  }

  .atlas-audio-player[data-playing="true"]
    .atlas-audio-progress::-moz-range-thumb {
    border-color: var(--accent);
  }

  .atlas-audio-waveform-control {
    position: relative;
    min-width: 0;
    height: 1.65rem;
  }

  .atlas-audio-waveform {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.1rem, 0.3vw, 0.2rem);
    pointer-events: none;
  }

  .atlas-audio-waveform-bar {
    width: 0.13rem;
    min-width: 0.1rem;
    height: var(--wave-height);
    border-radius: 999px;
    background: var(--ink);
  }

  .atlas-audio-waveform-bar[data-played="true"] {
    background: var(--accent);
  }

  .atlas-audio-progress--waveform {
    position: absolute;
    inset: 0;
    height: 100%;
    opacity: 0;
  }

  .atlas-audio-progress--waveform:focus-visible {
    outline: none;
  }

  .atlas-audio-waveform-control:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 42rem) {
    .atlas-audio-player {
      grid-template-columns: 2.35rem 2.85rem minmax(0, 1fr) 2.85rem;
      gap: 0.5rem;
      padding: 0.58rem 0;
    }

    .atlas-audio-toggle,
    .atlas-audio-player--minimal .atlas-audio-toggle {
      width: 2.35rem;
      height: 2.35rem;
    }

    .atlas-audio-player--minimal {
      grid-template-columns: 2.35rem 2.85rem minmax(0, 1fr) 2.85rem;
    }

    .atlas-audio-player--radio {
      grid-template-columns: 2.5rem 2.85rem minmax(0, 1fr) 2.85rem;
      gap: 0.46rem;
      padding: 0.56rem 0;
    }

    .atlas-audio-player--radio .atlas-audio-toggle {
      width: 2.3rem;
      height: 2.3rem;
      border-radius: 0.5rem;
    }

    .atlas-audio-time,
    .atlas-audio-duration {
      font-size: 0.66rem;
      letter-spacing: 0.04em;
    }

    .atlas-audio-waveform {
      gap: 0.08rem;
    }

    .atlas-audio-waveform-bar {
      width: 0.11rem;
      min-width: 0.08rem;
    }
  }
</style>
