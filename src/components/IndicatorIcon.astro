---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<span class="indicator-icon" aria-hidden="true">
  {
    (id === "uf" || id === "utm") && (
      <svg viewBox="0 0 24 24" fill="none">
        <ellipse cx="12" cy="6.25" rx="5.4" ry="2.35" />
        <path d="M6.6 6.25v3.45c0 1.3 2.42 2.35 5.4 2.35s5.4-1.05 5.4-2.35V6.25" />
        <path d="M6.6 9.7v3.45c0 1.3 2.42 2.35 5.4 2.35s5.4-1.05 5.4-2.35V9.7" />
        <path d="M6.6 13.15v3.45c0 1.3 2.42 2.35 5.4 2.35s5.4-1.05 5.4-2.35v-3.45" />
      </svg>
    )
  }

  {id === "dolar" && <span class="indicator-icon__glyph">$</span>}
  {id === "euro" && <span class="indicator-icon__glyph">€</span>}

  {
    id === "brent" && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M12 3.1C9.1 7.2 6.3 10.5 6.3 14.2A5.7 5.7 0 0 0 12 19.9a5.7 5.7 0 0 0 5.7-5.7C17.7 10.5 14.9 7.2 12 3.1Z" />
        <path d="M9.1 15.2c.45 1.15 1.35 1.75 2.7 1.85" />
      </svg>
    )
  }

  {
    id === "cobre" && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="m6.2 8.4 1.65-3.1h5.15l1.65 3.1Z" />
        <path d="m12.8 8.4 1.65-3.1h3.15l1.65 3.1Z" />
        <path d="m3.8 15.7 2.15-4.2h5.7l2.15 4.2Z" />
        <path d="m10.2 15.7 2.15-4.2h5.7l2.15 4.2Z" />
      </svg>
    )
  }

  {
    id === "ipsa" && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M5.2 19.3v-4.2M9.6 19.3v-7.1M14 19.3V9M18.4 19.3V5.3" />
        <path d="m5.1 11.4 4-3.7 3 1.6 5.8-5" />
      </svg>
    )
  }

  {
    id === "sp500" && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="m4.3 17.2 5-5 3.3 2.8 6.9-8.1" />
        <path d="M15.8 6.9h3.7v3.7" />
      </svg>
    )
  }
</span>

<style>
  .indicator-icon {
    display: grid;
    width: var(--indicator-icon-size, 2.65rem);
    height: var(--indicator-icon-size, 2.65rem);
    flex: 0 0 var(--indicator-icon-size, 2.65rem);
    place-items: center;
    border: 1px solid rgb(22 22 17 / 4%);
    border-radius: 50%;
    color: color-mix(in srgb, var(--ink) 78%, var(--paper));
    background: color-mix(in srgb, var(--paper-deep) 64%, transparent);
  }

  .indicator-icon svg {
    width: 1.45rem;
    height: 1.45rem;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .indicator-icon__glyph {
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1;
  }
</style>
