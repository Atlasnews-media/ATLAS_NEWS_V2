<section class="funds-module" aria-labelledby="fondos-mutuo-titulo">
  <header class="funds-heading">
    <h1 id="fondos-mutuo-titulo">Fondos Mutuos</h1>
    <p>
      Resumen de rentabilidades de la oferta comercial de fondos mutuos de
      BancoEstado AGF
    </p>
  </header>

  <p class="data-date" id="funds-data-date" aria-live="polite">
    Datos en preparación
  </p>

  <div class="table-wrap">
    <table aria-describedby="funds-data-date">
      <thead>
        <tr>
          <th scope="col">Fondo</th>
          <th scope="col" class="trend-column">Tend.</th>
          <th scope="col">7D</th>
          <th scope="col">30D</th>
          <th scope="col">60D</th>
          <th scope="col">90D</th>
          <th scope="col">1 Año</th>
        </tr>
      </thead>
      <tbody id="funds-table-body"></tbody>
    </table>
  </div>

  <p class="funds-status" id="funds-status" hidden>
    Los datos de fondos no están disponibles en este momento.
  </p>

  <p class="source-line" id="funds-source" hidden>Fuente: BuscaFondos</p>
</section>

<script>
  const snapshotUrl = "/data/funds-beagf.json";
  const body = document.querySelector("#funds-table-body");
  const dateNode = document.querySelector("#funds-data-date");
  const statusNode = document.querySelector("#funds-status");
  const sourceNode = document.querySelector("#funds-source");

  const trendSymbols = {
    up: "▲",
    down: "▼",
    flat: "→",
  };

  const trendLabels = {
    up: "Al alza",
    down: "A la baja",
    flat: "Sin variación",
  };

  const percentFormatter = new Intl.NumberFormat("es-CL", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  function formatPercent(value) {
    return `${percentFormatter.format(value)}%`;
  }

  function formatDataDate(value) {
    const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
    if (!match) return value;

    const date = new Date(
      Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])),
    );
    return new Intl.DateTimeFormat("es-CL", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    })
      .format(date)
      .replaceAll(".", "")
      .toUpperCase();
  }

  function cell(text, className) {
    const td = document.createElement("td");
    if (className) td.className = className;
    td.textContent = text;
    return td;
  }

  function renderSnapshot(snapshot) {
    if (!Array.isArray(snapshot?.funds) || snapshot.funds.length === 0) {
      throw new Error("Snapshot de fondos vacío.");
    }

    const fragment = document.createDocumentFragment();

    for (const fund of snapshot.funds) {
      const row = document.createElement("tr");
      const name = document.createElement("th");
      name.scope = "row";
      name.textContent = fund.displayName;
      row.append(name);

      const trend = document.createElement("td");
      trend.className = "trend-cell";
      trend.textContent = trendSymbols[fund.trend] ?? "—";
      trend.setAttribute(
        "aria-label",
        trendLabels[fund.trend] ?? "Tendencia no disponible",
      );
      row.append(trend);

      row.append(
        cell(formatPercent(fund.returns.d7), "return-cell"),
        cell(formatPercent(fund.returns.d30), "return-cell"),
        cell(formatPercent(fund.returns.d60), "return-cell"),
        cell(formatPercent(fund.returns.d90), "return-cell"),
        cell(formatPercent(fund.returns.y1), "return-cell"),
      );

      fragment.append(row);
    }

    body?.replaceChildren(fragment);
    if (dateNode) {
      dateNode.textContent = `Datos al ${formatDataDate(snapshot.asOf)}`;
    }
    if (sourceNode) sourceNode.hidden = false;
  }

  fetch(snapshotUrl, { cache: "no-store" })
    .then((response) => {
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return response.json();
    })
    .then(renderSnapshot)
    .catch(() => {
      if (dateNode) dateNode.textContent = "Datos temporalmente no disponibles";
      if (statusNode) statusNode.hidden = false;
    });
</script>

