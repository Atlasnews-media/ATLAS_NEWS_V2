---
import ResponsiveEditorialImage from "./ResponsiveEditorialImage.astro";
import {
  getLatestDaily,
  getLatestMarkets,
  getLatestNational,
} from "../lib/content";
import {
  resolveFrontPageVisual,
  type EditorialVisual,
  type FrontPageSection,
} from "../lib/front-page-visuals";

interface CanonicalSignal {
  slot: string;
  headline: string;
  deck: string;
  development: string;
  anchor: string;
  sources: Array<{
    name: string;
    url: string;
  }>;
}

interface SignalsArtifact {
  status: "READY";
  date: string;
  contract: "atlas-senales-del-dia-v1";
  senalesDelDia: {
    internacional: CanonicalSignal[];
    nacional: CanonicalSignal[];
    mercados: CanonicalSignal[];
  };
}

interface PublicSignal {
  label: string;
  text: string;
  href?: string;
  visual: EditorialVisual;
}

const signalFiles = import.meta.glob("../../data/senales-del-dia/*.json", {
  eager: true,
  query: "?raw",
  import: "default",
}) as Record<string, string>;

const [latestDaily, latestNational, latestMarkets] = await Promise.all([
  getLatestDaily(),
  getLatestNational(),
  getLatestMarkets(),
]);
const expectedDate = latestDaily?.id.slice(0, 10);
const nationalDestination =
  expectedDate && latestNational?.id.startsWith(`${expectedDate}-national-`)
    ? `/nacional/${latestNational.id}/`
    : undefined;
const marketsDestination =
  expectedDate && latestMarkets?.id.startsWith(`${expectedDate}-markets-`)
    ? `/mercados/${latestMarkets.id}/`
    : undefined;

function parseArtifact(raw: string | undefined): unknown {
  if (!raw) return undefined;
  try {
    return JSON.parse(raw);
  } catch {
    return undefined;
  }
}

function isCanonicalSignal(value: unknown): value is CanonicalSignal {
  if (!value || typeof value !== "object") return false;

  const signal = value as CanonicalSignal;

  return (
    typeof signal.slot === "string" &&
    typeof signal.headline === "string" &&
    signal.headline.trim().length > 0 &&
    signal.headline.length <= 72 &&
    typeof signal.deck === "string" &&
    signal.deck.trim().length > 0 &&
    signal.deck.length <= 180 &&
    typeof signal.development === "string" &&
    signal.development.trim().length > 0 &&
    typeof signal.anchor === "string" &&
    signal.anchor.trim().length > 0 &&
    Array.isArray(signal.sources)
  );
}

function isReadyArtifact(
  value: unknown,
  date?: string,
): value is SignalsArtifact {
  if (!value || typeof value !== "object" || !date) return false;

  const artifact = value as SignalsArtifact;
  const internacional = artifact.senalesDelDia?.internacional;
  const nacional = artifact.senalesDelDia?.nacional;
  const mercados = artifact.senalesDelDia?.mercados;

  if (
    artifact.status !== "READY" ||
    artifact.contract !== "atlas-senales-del-dia-v1" ||
    artifact.date !== date ||
    !Array.isArray(internacional) ||
    !Array.isArray(nacional) ||
    !Array.isArray(mercados) ||
    internacional.length !== 2 ||
    nacional.length !== 2 ||
    mercados.length !== 2
  ) {
    return false;
  }

  return [...internacional, ...nacional, ...mercados].every(isCanonicalSignal);
}

const artifactEntry = expectedDate
  ? Object.entries(signalFiles).find(([path]) =>
      path.endsWith(`/${expectedDate}.json`),
    )
  : undefined;

const artifact = parseArtifact(artifactEntry?.[1]);
const readyArtifact = isReadyArtifact(artifact, expectedDate)
  ? artifact
  : undefined;

function publicPair(
  items: CanonicalSignal[],
  section: FrontPageSection,
  date: string,
  destinationBase: string | undefined,
  usedSources: Set<string>,
): PublicSignal[] {
  return items.map((item) => {
    const visual = resolveFrontPageVisual({
      section,
      id: `${date}:${item.slot}:${item.anchor}`,
      title: `${item.headline} ${item.deck}`,
      usedSources,
    });
    usedSources.add(visual.src);

    return {
      label: item.headline,
      text: item.deck,
      href: destinationBase ? `${destinationBase}#${item.anchor}` : undefined,
      visual,
    };
  });
}

const usedSources = new Set<string>();

const groups = readyArtifact
  ? [
      {
        section: "Internacional",
        items: publicPair(
          readyArtifact.senalesDelDia.internacional,
          "international",
          readyArtifact.date,
          latestDaily ? `/internacional/${latestDaily.id}/` : undefined,
          usedSources,
        ),
      },
      {
        section: "Nacional",
        items: publicPair(
          readyArtifact.senalesDelDia.nacional,
          "national",
          readyArtifact.date,
          nationalDestination,
          usedSources,
        ),
      },
      {
        section: "Mercados",
        items: publicPair(
          readyArtifact.senalesDelDia.mercados,
          "markets",
          readyArtifact.date,
          marketsDestination,
          usedSources,
        ),
      },
    ]
  : [];
---

{
  groups.length === 3 && (
    <section class="daily-signals" aria-labelledby="senales-del-dia">
      <h2 id="senales-del-dia" class="daily-signals__title">
        Señales del día
      </h2>

      <div class="daily-signals__groups">
        {groups.map((group) => (
          <section class="daily-signals__group" aria-label={group.section}>
            <h3>{group.section}</h3>
            <div class="daily-signals__items">
              {group.items.map((item) => (
                <article class="daily-signals__item" data-has-visual="true">
                  {item.href ? (
                    <a class="daily-signals__link" href={item.href}>
                      <strong>{item.label}</strong>
                      <p>{item.text}</p>
                      <span class="daily-signals__cta">Ir a la noticia →</span>
                    </a>
                  ) : (
                    <>
                      <strong>{item.label}</strong>
                      <p>{item.text}</p>
                    </>
                  )}
                  <figure class="daily-signals__visual">
                    <ResponsiveEditorialImage
                      src={item.visual.src}
                      alt={item.visual.alt}
                      sizes="(max-width: 42rem) 40vw, (max-width: 79.99rem) 18vw, 8vw"
                      loading="lazy"
                      variant="card"
                      class="daily-signals__image"
                      onerror="this.closest('.daily-signals__item')?.removeAttribute('data-has-visual'); this.closest('figure')?.remove()"
                    />
                    <figcaption>
                      {item.visual.source} · {item.visual.author} ·{" "}
                      {item.visual.license}
                    </figcaption>
                  </figure>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  )
}

<style>
  .daily-signals {
    padding: clamp(1.9rem, 3.8vw, 3.2rem) 0 clamp(2.1rem, 4vw, 3.6rem);
    border-top: 4px double var(--rule);
  }

  .daily-signals__title {
    margin: 0;
    padding: 0 0 clamp(1rem, 1.9vw, 1.45rem);
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font: 700 clamp(2.2rem, 4.4vw, 4.25rem) / 0.95 var(--serif);
    letter-spacing: -0.04em;
  }

  .daily-signals__group {
    padding: clamp(1rem, 1.8vw, 1.45rem) 0 0;
  }

  .daily-signals__group + .daily-signals__group {
    margin-top: clamp(0.7rem, 1.4vw, 1.1rem);
    border-top: 1px solid var(--rule);
  }

  .daily-signals__group h3 {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .daily-signals__items {
    margin-top: 0.45rem;
  }

  .daily-signals__item {
    position: relative;
    padding: clamp(0.8rem, 1.45vw, 1.05rem) 0;
    overflow: hidden;
    isolation: isolate;
  }

  .daily-signals__item[data-has-visual="true"] {
    min-height: 6.1rem;
    padding-right: calc(clamp(5.5rem, 18vw, 8rem) + 0.8rem);
  }

  .daily-signals__visual {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: 0;
    width: clamp(5.5rem, 18vw, 8rem);
    height: clamp(4.5rem, 10vw, 5.35rem);
    margin: 0;
    overflow: hidden;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .daily-signals__visual figcaption {
    position: absolute;
    right: 0.22rem;
    bottom: 0.16rem;
    max-width: 88%;
    color: var(--ink-soft);
    font: 600 0.3rem/1.1 var(--sans);
    text-align: right;
    opacity: 0.7;
  }

  .daily-signals__item + .daily-signals__item {
    border-top: 1px solid var(--rule);
  }

  .daily-signals__link {
    position: relative;
    z-index: 1;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .daily-signals__link:hover strong,
  .daily-signals__link:focus-visible strong {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.14em;
  }

  .daily-signals__cta {
    display: inline-block;
    margin-top: 0.65rem;
    color: var(--accent);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .daily-signals__link:hover .daily-signals__cta,
  .daily-signals__link:focus-visible .daily-signals__cta {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .daily-signals__item strong {
    display: block;
    margin-bottom: 0.35rem;
    font: 800 clamp(0.95rem, 1.45vw, 1.18rem) / 1.1 var(--sans);
    letter-spacing: -0.01em;
  }

  .daily-signals__item p {
    margin: 0;
    color: var(--ink-soft);
    font: 400 clamp(1.08rem, 1.9vw, 1.45rem) / 1.28 var(--serif);
  }

  @media (min-width: 42.01rem) and (max-width: 58rem) {
    .daily-signals {
      padding-left: 0;
      padding-right: 0;
    }
  }

  @media (min-width: 70.01rem) {
    .daily-signals__item strong {
      margin-bottom: 0.2rem;
      font-size: 0.7rem;
      line-height: 1.05;
    }

    .daily-signals__item p {
      font-size: 0.9rem;
      line-height: 1.22;
    }
  }

  @media (max-width: 42rem) {
    .daily-signals {
      padding-top: 1.05rem;
      padding-bottom: 1.65rem;
    }

    .daily-signals__title {
      padding-bottom: 0.85rem;
      font: 700 clamp(1.75rem, 7vw, 2.25rem) / 0.98 var(--serif);
      letter-spacing: -0.03em;
    }

    .daily-signals__group {
      padding-top: 0.85rem;
    }

    .daily-signals__group + .daily-signals__group {
      margin-top: 0.45rem;
    }

    .daily-signals__item {
      padding: 0.72rem 0 0.8rem;
    }

    .daily-signals__item[data-has-visual="true"] {
      min-height: 135px;
      padding-right: 7.2rem;
    }

    .daily-signals__visual {
      top: 9%;
      right: -0.25rem;
      bottom: 9%;
      width: 40%;
      height: auto;
      transform: none;
    }

    .daily-signals__visual figcaption {
      font-size: 0.27rem;
    }

    .daily-signals__item strong {
      margin-bottom: 0.28rem;
      font-size: 0.86rem;
      line-height: 1.08;
    }

    .daily-signals__item p {
      font-size: 1.04rem;
      line-height: 1.3;
    }
  }
</style>

<style is:global>
  .front-page.front-page--v2 .rail-title,
  .front-page.front-page--v2 .daily-signals__title {
    font: 800 clamp(2.2rem, 4.4vw, 4.25rem) / 0.95 var(--sans) !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
  }

  .front-page.front-page--v2 .edition-rail strong {
    letter-spacing: -0.01em !important;
    text-transform: none !important;
  }

  .front-page.front-page--v2 .edition-rail li::before {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem) !important;
    line-height: 1 !important;
  }

  @media (max-width: 42rem) {
    .front-page.front-page--v2 .rail-title,
    .front-page.front-page--v2 .daily-signals__title {
      font: 800 1.23rem/1.2 var(--sans) !important;
      letter-spacing: 0.16em !important;
    }

    .front-page.front-page--v2 .edition-rail li::before {
      font-size: clamp(1.15rem, 4.8vw, 1.35rem) !important;
    }
  }

  @media (min-width: 70.01rem) {
    body .front-page.front-page--v2 .rail-title,
    body .front-page.front-page--v2 .daily-signals__title {
      font-size: clamp(1.55rem, 2.1vw, 1.9rem) !important;
      line-height: 1 !important;
    }

    body .front-page.front-page--v2 .edition-rail li::before {
      font-size: 0.95rem !important;
    }
  }

  @media (min-width: 80rem) {
    body:has(.desktop-workspace-panel) .front-page .rail-title,
    body:has(.desktop-workspace-panel) .front-page .daily-signals__title {
      font-size: clamp(1.65rem, 2.25vw, 2.05rem) !important;
      line-height: 1 !important;
    }

    body:has(.desktop-workspace-panel)
      .front-page.front-page--v2
      .daily-signals__group
      h3 {
      font-size: 0.64rem !important;
    }

    body:has(.desktop-workspace-panel)
      .front-page.front-page--v2
      .daily-signals__item
      strong {
      margin-bottom: 0.2rem !important;
      font: 800 0.7rem/1.05 var(--sans) !important;
      letter-spacing: -0.01em !important;
      text-transform: none !important;
    }

    body:has(.desktop-workspace-panel)
      .front-page.front-page--v2
      .daily-signals__item
      p {
      font-size: 0.9rem !important;
      line-height: 1.22 !important;
    }
  }

  @media (min-width: 80rem) {
    body:has(.desktop-workspace-panel)
      .front-page.front-page--v2
      .daily-signals__item[data-has-visual="true"] {
      min-height: 5rem !important;
      padding-right: 7rem !important;
    }

    body:has(.desktop-workspace-panel)
      .front-page.front-page--v2
      .daily-signals__visual {
      width: 6.25rem !important;
      height: 4.5rem !important;
    }
  }
</style>
