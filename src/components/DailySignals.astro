---
import {
  getLatestDaily,
  getLatestMarkets,
  getLatestNational,
} from "../lib/content";

interface SignalItem {
  label: string;
  text: string;
}

interface SignalSource {
  data: {
    title: string;
    summary: string;
    highlights?: SignalItem[];
  };
}

const [latestDaily, latestNational, latestMarkets] = await Promise.all([
  getLatestDaily(),
  getLatestNational(),
  getLatestMarkets(),
]);

function signalPair(source?: SignalSource): SignalItem[] {
  if (!source) {
    return [
      {
        label: "Señal en preparación",
        text: "Esta vertical todavía no ha publicado su primera señal del día.",
      },
      {
        label: "Segunda señal en preparación",
        text: "La segunda señal aparecerá cuando la vertical complete su edición.",
      },
    ];
  }

  const items = (source.data.highlights ?? [])
    .slice(0, 2)
    .map(({ label, text }) => ({ label, text }));

  if (items.length === 0) {
    items.push({ label: source.data.title, text: source.data.summary });
  } else if (
    items.length === 1 &&
    items[0].label.trim() !== source.data.title.trim()
  ) {
    items.push({ label: source.data.title, text: source.data.summary });
  }

  while (items.length < 2) {
    items.push({
      label: "Señal adicional en preparación",
      text: "La vertical aún no ha publicado una segunda señal independiente.",
    });
  }

  return items.slice(0, 2);
}

const groups = [
  { section: "Internacional", items: signalPair(latestDaily) },
  { section: "Nacional", items: signalPair(latestNational) },
  { section: "Mercados", items: signalPair(latestMarkets) },
];
---

<section class="daily-signals" aria-labelledby="senales-del-dia">
  <h2 id="senales-del-dia" class="daily-signals__title">Señales del día</h2>

  <div class="daily-signals__groups">
    {
      groups.map((group) => (
        <section class="daily-signals__group" aria-label={group.section}>
          <h3>{group.section}</h3>
          <div class="daily-signals__items">
            {group.items.map((item) => (
              <article class="daily-signals__item">
                <strong>{item.label}</strong>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</section>

<style>
  .daily-signals {
    padding: clamp(1.9rem, 3.8vw, 3.2rem) 0 clamp(2.1rem, 4vw, 3.6rem);
    border-top: 4px double var(--rule);
  }

  .daily-signals__title {
    margin: 0;
    padding: 0 0 clamp(1rem, 1.9vw, 1.45rem);
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font: 700 clamp(2.2rem, 4.4vw, 4.25rem) / 0.95 var(--serif);
    letter-spacing: -0.04em;
  }

  .daily-signals__group {
    padding: clamp(1rem, 1.8vw, 1.45rem) 0 0;
  }

  .daily-signals__group + .daily-signals__group {
    margin-top: clamp(0.7rem, 1.4vw, 1.1rem);
    border-top: 1px solid var(--rule);
  }

  .daily-signals__group h3 {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .daily-signals__items {
    margin-top: 0.45rem;
  }

  .daily-signals__item {
    padding: clamp(0.8rem, 1.45vw, 1.05rem) 0;
  }

  .daily-signals__item + .daily-signals__item {
    border-top: 1px solid var(--rule);
  }

  .daily-signals__item strong {
    display: block;
    margin-bottom: 0.35rem;
    font: 700 clamp(1rem, 1.5vw, 1.2rem) / 1.14 var(--serif);
    letter-spacing: -0.01em;
  }

  .daily-signals__item p {
    margin: 0;
    color: var(--ink-soft);
    font: 400 clamp(1.08rem, 1.9vw, 1.45rem) / 1.28 var(--serif);
  }

  @media (min-width: 42.01rem) and (max-width: 58rem) {
    .daily-signals {
      padding-left: 0;
      padding-right: 0;
    }
  }

  @media (max-width: 42rem) {
    .daily-signals {
      padding-top: 1.05rem;
      padding-bottom: 1.65rem;
    }

    .daily-signals__title {
      padding-bottom: 0.85rem;
      font: 700 clamp(1.75rem, 7vw, 2.25rem) / 0.98 var(--serif);
      letter-spacing: -0.03em;
    }

    .daily-signals__group {
      padding-top: 0.85rem;
    }

    .daily-signals__group + .daily-signals__group {
      margin-top: 0.45rem;
    }

    .daily-signals__item {
      padding: 0.72rem 0 0.8rem;
    }

    .daily-signals__item strong {
      margin-bottom: 0.28rem;
      font-size: 0.86rem;
      line-height: 1.12;
    }

    .daily-signals__item p {
      font-size: 1.04rem;
      line-height: 1.3;
    }
  }
</style>
