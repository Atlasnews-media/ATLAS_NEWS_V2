---
import AtlasAudioPlayer from "./AtlasAudioPlayer.astro";

interface Props {
  title: string;
  summary: string;
  expectedSourceId?: string;
  section: "international" | "national" | "markets";
  ariaLabel: string;
}

const { title, summary, expectedSourceId, section, ariaLabel } = Astro.props;
const titleId = `section-analysis-audio-${section}`;
---

<section
  class="section-analysis-audio"
  data-section-analysis-audio
  data-section={section}
  data-expected-source-id={expectedSourceId}
  aria-labelledby={titleId}
  hidden
>
  <div class="audio-copy">
    <div class="audio-heading">
      <span class="audio-accent" aria-hidden="true"></span>
      <p class="audio-kicker" id={titleId} title={title}>
        <span>ATLAS NEWS</span> RADIO
      </p>
      <span class="audio-rule" aria-hidden="true"></span>
    </div>
    <p>{summary}</p>
  </div>
  <div class="audio-player">
    <AtlasAudioPlayer
      preload="metadata"
      ariaLabel={ariaLabel}
      engineRole="analysis"
      visualVariant="radio"
    />
  </div>
</section>

<script>
  const analysisRuntimeWindow = window as typeof window & {
    __atlasAnalysisAudioRuntime?: { dispose: () => void };
  };
  analysisRuntimeWindow.__atlasAnalysisAudioRuntime?.dispose();

  const analysisLifecycle = new AbortController();
  const analysisRetryIntervalMs = 30_000;
  const analysisMaxAttempts = 40;
  let analysisAttempt = 0;
  let analysisRetryTimer: number | undefined;
  let analysisGeneration = 0;

  const analysisRoots = () => [
    ...document.querySelectorAll<HTMLElement>("[data-section-analysis-audio]"),
  ];

  const clearAnalysisRetry = () => {
    if (analysisRetryTimer !== undefined) {
      window.clearTimeout(analysisRetryTimer);
      analysisRetryTimer = undefined;
    }
  };

  const applyAnalysisMetadata = (
    metadata: Record<string, any>,
    roots: HTMLElement[],
  ) => {
    let allReady = true;

    roots.forEach((root) => {
      const section = root.dataset.section;
      const expectedSourceId = root.dataset.expectedSourceId;
      const entry = section ? metadata?.[section] : undefined;
      const ready = Boolean(
        expectedSourceId &&
        entry?.status === "published" &&
        entry?.sourceId === expectedSourceId &&
        entry?.path,
      );

      if (!ready) {
        allReady = false;
        root.hidden = true;
        return;
      }

      const player = root.querySelector("[data-atlas-audio-engine]");
      const source = root.querySelector("[data-atlas-audio-source]");
      if (
        !(player instanceof HTMLAudioElement) ||
        !(source instanceof HTMLSourceElement)
      ) {
        allReady = false;
        return;
      }

      if (source.getAttribute("src") !== entry.path) {
        source.src = entry.path;
        player.load();
      }
      root.hidden = false;
    });

    return allReady;
  };

  const scheduleAnalysisRetry = (generation: number) => {
    if (
      generation !== analysisGeneration ||
      analysisAttempt >= analysisMaxAttempts ||
      analysisRetryTimer !== undefined
    ) {
      return;
    }

    analysisRetryTimer = window.setTimeout(() => {
      analysisRetryTimer = undefined;
      void checkAnalysisAudio(generation);
    }, analysisRetryIntervalMs);
  };

  const checkAnalysisAudio = async (generation: number) => {
    if (generation !== analysisGeneration) return;

    const roots = analysisRoots();
    if (!roots.length) return;

    analysisAttempt += 1;
    try {
      const response = await fetch(
        `/audio/analysis-latest.json?v=${Date.now()}`,
        { cache: "no-store" },
      );
      if (!response.ok) throw new Error("audio metadata unavailable");

      const metadata = await response.json();
      if (generation !== analysisGeneration) return;
      if (applyAnalysisMetadata(metadata, roots)) return;
    } catch {
      if (generation !== analysisGeneration) return;
      roots.forEach((root) => {
        if (!root.querySelector("[data-atlas-audio-source][src]")) {
          root.hidden = true;
        }
      });
    }

    scheduleAnalysisRetry(generation);
  };

  const startAnalysisAudio = () => {
    analysisGeneration += 1;
    analysisAttempt = 0;
    clearAnalysisRetry();

    if (!analysisRoots().length) return;
    void checkAnalysisAudio(analysisGeneration);
  };

  document.addEventListener("astro:page-load", startAnalysisAudio, {
    signal: analysisLifecycle.signal,
  });
  document.addEventListener(
    "visibilitychange",
    () => {
      if (
        document.visibilityState === "visible" &&
        analysisRoots().length &&
        analysisAttempt < analysisMaxAttempts
      ) {
        clearAnalysisRetry();
        void checkAnalysisAudio(analysisGeneration);
      }
    },
    { signal: analysisLifecycle.signal },
  );

  analysisRuntimeWindow.__atlasAnalysisAudioRuntime = {
    dispose: () => {
      analysisGeneration += 1;
      clearAnalysisRetry();
      analysisLifecycle.abort();
    },
  };

  startAnalysisAudio();
</script>

<style>
  .section-analysis-audio {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
    margin-top: 1.75rem;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .section-analysis-audio[hidden] {
    display: none;
  }
  .audio-copy {
    min-width: 0;
  }
  .audio-heading {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    gap: 0.28rem 0.65rem;
    min-width: 0;
    margin-bottom: 0.42rem;
  }
  .audio-accent {
    grid-column: 1;
    grid-row: 1;
    width: clamp(2.8rem, 6vw, 4.4rem);
    height: 0.18rem;
    background: var(--accent);
  }
  .audio-kicker {
    grid-column: 1;
    grid-row: 2;
    margin: 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(0.78rem, 1.75vw, 1.18rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .audio-kicker span {
    color: var(--accent);
  }
  .audio-rule {
    grid-column: 2;
    grid-row: 2;
    width: 100%;
    height: 1px;
    background: rgb(35 35 29 / 72%);
  }
  .audio-copy > p:last-child {
    max-width: 45rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .audio-player {
    min-width: 0;
  }

  @media (max-width: 42rem) {
    .section-analysis-audio {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 1.35rem;
      padding: 1.1rem 0 1.25rem;
    }
    .audio-heading {
      gap: 0.22rem 0.46rem;
      margin-bottom: 0.3rem;
    }
    .audio-accent {
      width: 2.55rem;
      height: 0.15rem;
    }
    .audio-kicker {
      font-size: clamp(0.58rem, 2.55vw, 0.78rem);
      letter-spacing: -0.01em;
    }
  }
</style>
