---
interface Props {
  title: string;
  summary: string;
  src: string;
  ariaLabel: string;
}

const { title, summary, src, ariaLabel } = Astro.props;
const titleId = `section-analysis-audio-${title
  .toLowerCase()
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "")}`;
---

<section class="section-analysis-audio" aria-labelledby={titleId}>
  <div class="audio-copy">
    <p class="audio-kicker" id={titleId}>{title}</p>
    <p>{summary}</p>
  </div>
  <div class="audio-player">
    <audio controls preload="none" aria-label={ariaLabel}>
      <source src={src} type="audio/mpeg" />
    </audio>
  </div>
</section>

<style>
  .section-analysis-audio {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
    margin-top: 1.75rem;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .audio-kicker {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .audio-copy > p:last-child {
    max-width: 45rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .audio-player {
    min-width: 0;
  }
  audio {
    display: block;
    width: 100%;
    min-height: 2.6rem;
  }

  @media (max-width: 42rem) {
    .section-analysis-audio {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 1.35rem;
      padding: 1.1rem 0 1.25rem;
    }
  }
</style>
