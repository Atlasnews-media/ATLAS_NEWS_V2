---
import AtlasAudioPlayer from "./AtlasAudioPlayer.astro";

interface Props {
  title: string;
  summary: string;
  expectedSourceId?: string;
  section: "international" | "national" | "markets";
  ariaLabel: string;
}

const { title, summary, expectedSourceId, section, ariaLabel } = Astro.props;
const titleId = `section-analysis-audio-${section}`;
---

<section
  class="section-analysis-audio"
  data-section-analysis-audio
  data-section={section}
  data-expected-source-id={expectedSourceId}
  aria-labelledby={titleId}
  hidden
>
  <div class="audio-copy">
    <p class="audio-kicker" id={titleId}>{title}</p>
    <p>{summary}</p>
  </div>
  <div class="audio-player">
    <AtlasAudioPlayer
      preload="metadata"
      ariaLabel={ariaLabel}
      engineRole="analysis"
    />
  </div>
</section>

<script is:inline>
  (() => {
    const roots = [...document.querySelectorAll("[data-section-analysis-audio]")];
    if (!roots.length) return;

    const watcherKey = "atlasAnalysisAudioWatcher";
    if (document.documentElement.dataset[watcherKey] === "true") return;
    document.documentElement.dataset[watcherKey] = "true";

    const retryIntervalMs = 30_000;
    const maxAttempts = 40;
    let attempt = 0;
    let retryTimer;

    const applyMetadata = (metadata) => {
      let allReady = true;

      roots.forEach((root) => {
        const section = root.dataset.section;
        const expectedSourceId = root.dataset.expectedSourceId;
        const entry = metadata?.[section];
        const ready = Boolean(
          expectedSourceId &&
            entry?.status === "published" &&
            entry?.sourceId === expectedSourceId &&
            entry?.path,
        );

        if (!ready) {
          allReady = false;
          root.hidden = true;
          return;
        }

        const player = root.querySelector("[data-atlas-audio-engine]");
        const source = root.querySelector("[data-atlas-audio-source]");
        if (!player || !source) {
          allReady = false;
          return;
        }

        if (source.getAttribute("src") !== entry.path) {
          source.src = entry.path;
          player.load();
        }
        root.hidden = false;
      });

      return allReady;
    };

    const scheduleRetry = () => {
      if (attempt >= maxAttempts || retryTimer) return;
      retryTimer = window.setTimeout(() => {
        retryTimer = undefined;
        void checkAudio();
      }, retryIntervalMs);
    };

    const checkAudio = async () => {
      attempt += 1;
      try {
        const response = await fetch(
          `/audio/analysis-latest.json?v=${Date.now()}`,
          { cache: "no-store" },
        );
        if (!response.ok) throw new Error("audio metadata unavailable");

        const metadata = await response.json();
        if (applyMetadata(metadata)) return;
      } catch {
        // Si el audio ya estaba visible, un fallo transitorio no debe ocultarlo.
        roots.forEach((root) => {
          if (!root.querySelector("[data-atlas-audio-source][src]")) {
            root.hidden = true;
          }
        });
      }

      scheduleRetry();
    };

    document.addEventListener("visibilitychange", () => {
      if (
        document.visibilityState === "visible" &&
        attempt < maxAttempts &&
        !roots.every((root) => !root.hidden)
      ) {
        if (retryTimer) {
          window.clearTimeout(retryTimer);
          retryTimer = undefined;
        }
        void checkAudio();
      }
    });

    void checkAudio();
  })();
</script>

<style>
  .section-analysis-audio {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
    margin-top: 1.75rem;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .section-analysis-audio[hidden] {
    display: none;
  }
  .audio-kicker {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .audio-copy > p:last-child {
    max-width: 45rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .audio-player {
    min-width: 0;
  }

  @media (max-width: 42rem) {
    .section-analysis-audio {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 1.35rem;
      padding: 1.1rem 0 1.25rem;
    }
  }
</style>
