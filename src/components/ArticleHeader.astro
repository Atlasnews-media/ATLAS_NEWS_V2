---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  date: string;
  cutoff?: string;
  demo?: boolean;
  tags: string[];
}

const {
  eyebrow,
  title,
  summary,
  date,
  cutoff,
  demo = false,
  tags,
} = Astro.props;
---

<header class="article-header">
  <div class="meta">
    <span>{eyebrow}</span><span aria-hidden="true">◆</span><span
      >ATLAS NEWS</span
    >
    {demo && <strong>Contenido de demostración</strong>}
  </div>
  <h1>{title}</h1>
  <p class="summary">{summary}</p>
  <div class="publication-data">
    <dl>
      <div><dt>Publicado</dt><dd>{date}</dd></div>
      {
        cutoff && (
          <div>
            <>
              <dt>Cierre</dt>
              <dd>{cutoff}</dd>
            </>
          </div>
        )
      }
    </dl>
    <ul class="tags" aria-label="Etiquetas">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</header>

<style>
  .article-header {
    padding: clamp(2.5rem, 6vw, 5rem) 0 2rem;
    border-bottom: 4px double var(--rule);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    color: var(--accent);
    font: 800 0.7rem/1.2 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .meta strong {
    margin-left: auto;
    padding: 0.2rem 0.4rem;
    color: var(--paper);
    background: var(--ink);
  }
  h1 {
    max-width: 76rem;
    margin: 1.25rem 0 1.5rem;
    font-size: clamp(3rem, 8.5vw, 7.5rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .summary {
    max-width: 58rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.18rem, 2.5vw, 1.62rem);
    line-height: 1.4;
  }
  .publication-data {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }
  dl,
  dl div,
  .tags {
    display: flex;
    flex-wrap: wrap;
  }
  dl {
    gap: 0.6rem 2rem;
    margin: 0;
    font: 0.72rem/1.4 var(--sans);
    text-transform: uppercase;
  }
  dl div {
    gap: 0.35rem;
  }
  dt {
    font-weight: 800;
  }
  dd {
    margin: 0;
  }
  .tags {
    justify-content: flex-end;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.22rem 0.45rem;
    border: 1px solid var(--rule);
    font: 0.67rem/1.2 var(--sans);
    text-transform: uppercase;
  }

  @media (max-width: 42rem) {
    .meta strong {
      width: 100%;
      margin-left: 0;
    }
    .publication-data {
      align-items: flex-start;
      flex-direction: column;
    }
    .tags {
      justify-content: flex-start;
    }
  }
</style>
