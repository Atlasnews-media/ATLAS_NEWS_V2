---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  date: string;
  cutoff?: string;
  demo?: boolean;
  tags: string[];
}

const {
  eyebrow,
  title,
  summary,
  date,
  cutoff,
  demo = false,
  tags,
} = Astro.props;

const pageUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(pageUrl);
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${title}\n${pageUrl}`)}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodedUrl}`;
---

<header class="article-header">
  <div class="meta">
    <span>{eyebrow}</span><span aria-hidden="true">◆</span><span
      >ATLAS NEWS</span
    >
    {demo && <strong>Contenido de demostración</strong>}
  </div>
  <h1>{title}</h1>
  <p class="summary">{summary}</p>
  <div class="publication-data">
    <dl>
      <div><dt>Publicado</dt><dd>{date}</dd></div>
      {
        cutoff && (
          <div>
            <>
              <dt>Cierre</dt>
              <dd>{cutoff}</dd>
            </>
          </div>
        )
      }
    </dl>
    <ul class="tags" aria-label="Etiquetas">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  <div class="share-tools" aria-label="Compartir publicación">
    <span class="share-label">Compartir</span>
    <button
      class="share-action share-native"
      type="button"
      data-share-native
      data-share-title={title}
      data-share-summary={summary}
    >
      <svg class="share-icon share-icon-stroke" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <path d="m8.6 10.7 6.8-4.4M8.6 13.3l6.8 4.4"></path>
      </svg>
      Compartir…
    </button>
    <a
      class="share-action"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.371-.272.297-1.04 1.016-1.04 2.479s1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.693.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.028 6.988 2.895a9.825 9.825 0 0 1 2.9 6.988c-.003 5.45-4.437 9.884-9.892 9.884m8.413-18.297A11.815 11.815 0 0 0 12.055 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.689 1.448h.005c6.56 0 11.896-5.335 11.899-11.893a11.82 11.82 0 0 0-3.49-8.413Z"></path>
      </svg>
      WhatsApp
    </a>
    <a
      class="share-action"
      href={facebookHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.024 1.792-4.695 4.533-4.695 1.312 0 2.686.236 2.686.236v2.972h-1.513c-1.49 0-1.956.931-1.956 1.887v2.26h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073Z"></path>
      </svg>
      Facebook
    </a>
    <a
      class="share-action"
      href={linkedinHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9H7.12v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0Z"></path>
      </svg>
      LinkedIn
    </a>
    <a
      class="share-action share-x"
      href={xHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"></path>
      </svg>
      X
    </a>
    <button class="share-action" type="button" data-share-copy>
      <svg class="share-icon share-icon-stroke" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
      Copiar enlace
    </button>
    <span class="share-status" data-share-status aria-live="polite"></span>
  </div>
</header>

<script>
  const nativeButton = document.querySelector("[data-share-native]");

  if (nativeButton instanceof HTMLButtonElement) {
    if (typeof navigator.share === "function") {
      nativeButton.addEventListener("click", async () => {
        try {
          await navigator.share({
            title: nativeButton.dataset.shareTitle,
            text: nativeButton.dataset.shareSummary,
            url: window.location.href,
          });
        } catch {
          // Cancelar el menú de compartir no requiere una acción adicional.
        }
      });
    } else {
      nativeButton.hidden = true;
    }
  }

  const copyButton = document.querySelector("[data-share-copy]");
  const status = document.querySelector("[data-share-status]");

  if (copyButton instanceof HTMLButtonElement) {
    copyButton.addEventListener("click", async () => {
      if (!navigator.clipboard) {
        if (status instanceof HTMLElement) {
          status.textContent = "Copia no disponible";
        }
        return;
      }

      try {
        await navigator.clipboard.writeText(window.location.href);
        if (status instanceof HTMLElement) {
          status.textContent = "Enlace copiado";
          window.setTimeout(() => {
            status.textContent = "";
          }, 2200);
        }
      } catch {
        if (status instanceof HTMLElement) {
          status.textContent = "No se pudo copiar";
        }
      }
    });
  }
</script>

<style>
  .article-header {
    padding: clamp(2.5rem, 6vw, 5rem) 0 2rem;
    border-bottom: 4px double var(--rule);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    color: var(--accent);
    font: 800 0.7rem/1.2 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .meta strong {
    margin-left: auto;
    padding: 0.2rem 0.4rem;
    color: var(--paper);
    background: var(--ink);
  }
  h1 {
    max-width: 76rem;
    margin: 1.25rem 0 1.5rem;
    font-size: clamp(3rem, 8.5vw, 7.5rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .summary {
    max-width: 58rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.18rem, 2.5vw, 1.62rem);
    line-height: 1.4;
  }
  .publication-data {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }
  dl,
  dl div,
  .tags {
    display: flex;
    flex-wrap: wrap;
  }
  dl {
    gap: 0.6rem 2rem;
    margin: 0;
    font: 0.72rem/1.4 var(--sans);
    text-transform: uppercase;
  }
  dl div {
    gap: 0.35rem;
  }
  dt {
    font-weight: 800;
  }
  dd {
    margin: 0;
  }
  .tags {
    justify-content: flex-end;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.22rem 0.45rem;
    border: 1px solid var(--rule);
    font: 0.67rem/1.2 var(--sans);
    text-transform: uppercase;
  }
  .share-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font: 800 0.66rem/1 var(--sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .share-label {
    margin-right: 0.25rem;
    color: var(--ink-soft);
  }
  .share-action {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 2rem;
    padding: 0.45rem 0.58rem;
    border: 1px solid var(--rule);
    border-radius: 0;
    color: var(--ink);
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-decoration: none;
    text-transform: inherit;
    cursor: pointer;
  }
  .share-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    fill: currentColor;
  }
  .share-icon-stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .share-action:hover,
  .share-action:focus-visible {
    color: var(--paper);
    background: var(--ink);
    outline: none;
  }
  .share-native {
    border-color: var(--accent);
    color: var(--accent);
  }
  .share-status {
    min-height: 1em;
    color: var(--accent);
    font-weight: 700;
    text-transform: none;
  }
  .share-status:empty {
    display: none;
  }

  @media (max-width: 42rem) {
    .article-header {
      padding-bottom: 1rem;
    }
    .meta strong {
      width: 100%;
      margin-left: 0;
    }
    .publication-data {
      align-items: flex-start;
      flex-direction: column;
    }
    .tags {
      justify-content: flex-start;
    }
    .share-tools {
      align-items: stretch;
    }
    .share-label {
      width: 100%;
      margin-bottom: 0.15rem;
    }
    .share-action {
      justify-content: center;
      flex: 1 1 auto;
    }
    .share-x {
      min-width: 5rem;
    }
    .share-status {
      width: 100%;
    }
  }
</style>
