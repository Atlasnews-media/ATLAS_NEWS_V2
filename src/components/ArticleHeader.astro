---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  date: string;
  cutoff?: string;
  demo?: boolean;
  tags: string[];
}

const {
  eyebrow,
  title,
  summary,
  date,
  cutoff,
  demo = false,
  tags,
} = Astro.props;

const pageUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(pageUrl);
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${title}\n${pageUrl}`)}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodedUrl}`;
---

<header class="article-header">
  <div class="meta">
    <span>{eyebrow}</span><span aria-hidden="true">◆</span><span
      >ATLAS NEWS</span
    >
    {demo && <strong>Contenido de demostración</strong>}
  </div>
  <h1>{title}</h1>
  <p class="summary">{summary}</p>
  <div class="publication-data">
    <dl>
      <div><dt>Publicado</dt><dd>{date}</dd></div>
      {
        cutoff && (
          <div>
            <>
              <dt>Cierre</dt>
              <dd>{cutoff}</dd>
            </>
          </div>
        )
      }
    </dl>
    <ul class="tags" aria-label="Etiquetas">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  <div class="share-tools" aria-label="Compartir publicación">
    <span class="share-label">Compartir</span>
    <button
      class="share-action share-native"
      type="button"
      data-share-native
      data-share-title={title}
      data-share-summary={summary}
    >
      <img
        class="share-icon"
        src="/share-icons/share.svg"
        alt=""
        width="24"
        height="24"
      />
      Compartir…
    </button>
    <a
      class="share-action"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="share-icon"
        src="/share-icons/whatsapp.svg"
        alt=""
        width="24"
        height="24"
      />
      WhatsApp
    </a>
    <a
      class="share-action"
      href={facebookHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="share-icon"
        src="/share-icons/facebook.svg"
        alt=""
        width="24"
        height="24"
      />
      Facebook
    </a>
    <a
      class="share-action"
      href={linkedinHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="share-icon"
        src="/share-icons/linkedin.svg"
        alt=""
        width="24"
        height="24"
      />
      LinkedIn
    </a>
    <a
      class="share-action share-x"
      href={xHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="share-icon"
        src="/share-icons/x.svg"
        alt=""
        width="24"
        height="24"
      />
      X
    </a>
    <button class="share-action" type="button" data-share-copy>
      <img
        class="share-icon"
        src="/share-icons/link.svg"
        alt=""
        width="24"
        height="24"
      />
      Copiar enlace
    </button>
    <span class="share-status" data-share-status aria-live="polite"></span>
  </div>
</header>

<script>
  const nativeButton = document.querySelector("[data-share-native]");

  if (nativeButton instanceof HTMLButtonElement) {
    if (typeof navigator.share === "function") {
      nativeButton.addEventListener("click", async () => {
        try {
          await navigator.share({
            title: nativeButton.dataset.shareTitle,
            text: nativeButton.dataset.shareSummary,
            url: window.location.href,
          });
        } catch {
          // Cancelar el menú de compartir no requiere una acción adicional.
        }
      });
    } else {
      nativeButton.hidden = true;
    }
  }

  const copyButton = document.querySelector("[data-share-copy]");
  const status = document.querySelector("[data-share-status]");

  if (copyButton instanceof HTMLButtonElement) {
    copyButton.addEventListener("click", async () => {
      if (!navigator.clipboard) {
        if (status instanceof HTMLElement) {
          status.textContent = "Copia no disponible";
        }
        return;
      }

      try {
        await navigator.clipboard.writeText(window.location.href);
        if (status instanceof HTMLElement) {
          status.textContent = "Enlace copiado";
          window.setTimeout(() => {
            status.textContent = "";
          }, 2200);
        }
      } catch {
        if (status instanceof HTMLElement) {
          status.textContent = "No se pudo copiar";
        }
      }
    });
  }
</script>

<style>
  .article-header {
    padding: clamp(2.5rem, 6vw, 5rem) 0 2rem;
    border-bottom: 4px double var(--rule);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    color: var(--accent);
    font: 800 0.7rem/1.2 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .meta strong {
    margin-left: auto;
    padding: 0.2rem 0.4rem;
    color: var(--paper);
    background: var(--ink);
  }
  h1 {
    max-width: 76rem;
    margin: 1.25rem 0 1.5rem;
    font-size: clamp(3rem, 8.5vw, 7.5rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .summary {
    max-width: 58rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.18rem, 2.5vw, 1.62rem);
    line-height: 1.4;
  }
  .publication-data {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }
  dl,
  dl div,
  .tags {
    display: flex;
    flex-wrap: wrap;
  }
  dl {
    gap: 0.6rem 2rem;
    margin: 0;
    font: 0.72rem/1.4 var(--sans);
    text-transform: uppercase;
  }
  dl div {
    gap: 0.35rem;
  }
  dt {
    font-weight: 800;
  }
  dd {
    margin: 0;
  }
  .tags {
    justify-content: flex-end;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.22rem 0.45rem;
    border: 1px solid var(--rule);
    font: 0.67rem/1.2 var(--sans);
    text-transform: uppercase;
  }
  .share-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font: 800 0.66rem/1 var(--sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .share-label {
    margin-right: 0.25rem;
    color: var(--ink-soft);
  }
  .share-action {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 2rem;
    padding: 0.45rem 0.58rem;
    border: 1px solid var(--rule);
    border-radius: 0;
    color: var(--ink);
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-decoration: none;
    text-transform: inherit;
    cursor: pointer;
  }
  .share-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
  }
  .share-action:hover,
  .share-action:focus-visible {
    color: var(--paper);
    background: var(--ink);
    outline: none;
  }
  .share-action:hover .share-icon,
  .share-action:focus-visible .share-icon {
    filter: brightness(0) invert(1);
  }
  .share-native {
    border-color: var(--accent);
    color: var(--accent);
  }
  .share-status {
    min-height: 1em;
    color: var(--accent);
    font-weight: 700;
    text-transform: none;
  }
  .share-status:empty {
    display: none;
  }

  @media (max-width: 42rem) {
    .article-header {
      padding-bottom: 1rem;
    }
    .meta strong {
      width: 100%;
      margin-left: 0;
    }
    .publication-data {
      align-items: flex-start;
      flex-direction: column;
    }
    .tags {
      justify-content: flex-start;
    }
    .share-tools {
      align-items: stretch;
    }
    .share-label {
      width: 100%;
      margin-bottom: 0.15rem;
    }
    .share-action {
      justify-content: center;
      flex: 1 1 auto;
    }
    .share-x {
      min-width: 5rem;
    }
    .share-status {
      width: 100%;
    }
  }
</style>
