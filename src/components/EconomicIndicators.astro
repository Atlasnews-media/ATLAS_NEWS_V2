---
import marketPulse from "../data/market-pulse.json";
import { economicIndicatorsSnapshot } from "../data/economic-indicators";

type Trend = "up" | "down" | "flat";

type MarketAsset = {
  id: string;
  value: number | null;
  unit: string;
  changePercent: number | null;
  trend: Trend;
  effectiveAt: string | null;
  displayEligible?: boolean;
};

type DisplayIndicator = {
  id: string;
  label: string;
  value: number | null;
  unit: string;
  effectiveAt: string | null;
  changePercent: number | null;
  trend: Trend;
  displayEligible?: boolean;
};

const dateFormatter = new Intl.DateTimeFormat("es-CL", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "America/Santiago",
});
const clpFormatter = new Intl.NumberFormat("es-CL", {
  style: "currency",
  currency: "CLP",
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const clpIntegerFormatter = new Intl.NumberFormat("es-CL", {
  style: "currency",
  currency: "CLP",
  maximumFractionDigits: 0,
});
const decimal2Formatter = new Intl.NumberFormat("es-CL", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const variationFormatter = new Intl.NumberFormat("es-CL", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

const snapshot = marketPulse as {
  generatedAt: string | null;
  assets: MarketAsset[];
};

const economicByCode = new Map(
  economicIndicatorsSnapshot.indicators.map((indicator) => [
    indicator.code,
    indicator,
  ]),
);
const marketById = new Map(snapshot.assets.map((asset) => [asset.id, asset]));

function normalizeEconomic(
  code: string,
  label: string,
): DisplayIndicator | null {
  const indicator = economicByCode.get(code);
  if (!indicator) return null;

  return {
    id: code,
    label,
    value: indicator.value,
    unit: indicator.unit,
    effectiveAt: indicator.effectiveDate,
    changePercent: indicator.changePercent ?? null,
    trend: indicator.trend ?? "flat",
  };
}

function normalizeMarket(id: string, label: string): DisplayIndicator {
  const asset = marketById.get(id);
  return {
    id,
    label,
    value: asset?.value ?? null,
    unit: asset?.unit ?? "points",
    effectiveAt: asset?.effectiveAt ?? null,
    changePercent: asset?.changePercent ?? null,
    trend: asset?.trend ?? "flat",
    displayEligible: asset?.displayEligible,
  };
}

const indicators: DisplayIndicator[] = [
  normalizeEconomic("uf", "UF"),
  normalizeEconomic("dolar", "Dólar"),
  normalizeEconomic("euro", "Euro"),
  normalizeEconomic("utm", "UTM"),
  normalizeMarket("brent", "Brent Oil"),
  normalizeEconomic("cobre", "Cobre"),
  normalizeMarket("ipsa", "IPSA"),
  normalizeMarket("sp500", "S&P 500"),
].filter((indicator): indicator is DisplayIndicator => Boolean(indicator));

function formatDate(date: string) {
  const normalized = date.includes("T") ? date : `${date}T12:00:00-04:00`;
  return dateFormatter.format(new Date(normalized));
}

function isDisplayable(indicator: DisplayIndicator) {
  return (
    indicator.displayEligible !== false &&
    typeof indicator.value === "number" &&
    Number.isFinite(indicator.value)
  );
}

function formatValue(indicator: DisplayIndicator) {
  if (!isDisplayable(indicator)) return "—";

  const value = indicator.value as number;
  switch (indicator.unit) {
    case "clp":
      return clpFormatter.format(value);
    case "clp-integer":
      return clpIntegerFormatter.format(value);
    case "percent":
      return `${decimal2Formatter.format(value)}%`;
    case "usd-per-pound":
      return `US$${decimal2Formatter.format(value)}/lb`;
    case "usd-per-barrel":
      return `US$${decimal2Formatter.format(value)}`;
    case "points":
      return decimal2Formatter.format(value);
    default:
      return decimal2Formatter.format(value);
  }
}

function formatTrend(indicator: DisplayIndicator) {
  if (
    !isDisplayable(indicator) ||
    indicator.changePercent === null ||
    !Number.isFinite(indicator.changePercent)
  ) {
    return null;
  }

  const arrow =
    indicator.trend === "up" ? "▲" : indicator.trend === "down" ? "▼" : "→";
  const change = variationFormatter.format(Math.abs(indicator.changePercent));
  return `${arrow} ${change}%`;
}

const marketGeneratedDate = snapshot.generatedAt?.slice(0, 10) ?? null;
const asOf = marketGeneratedDate ?? economicIndicatorsSnapshot.asOf;
const asOfLabel = formatDate(asOf);
const freshnessLabel =
  economicIndicatorsSnapshot.status === "stale"
    ? "Último dato disponible"
    : "Datos al";
---

<section
  class="economic-strip"
  data-status={economicIndicatorsSnapshot.status}
  aria-label="Indicadores económicos de referencia"
>
  <div class="economic-strip__context">
    <strong>Indicadores económicos</strong>
  </div>

  <dl class="economic-strip__grid">
    {
      indicators.map((indicator) => {
        const trend = formatTrend(indicator);
        return (
          <div class="economic-strip__item">
            <dt>{indicator.label}</dt>
            <dd
              title={
                indicator.effectiveAt
                  ? `Dato efectivo al ${formatDate(indicator.effectiveAt)}`
                  : undefined
              }
            >
              <span class="economic-strip__value">
                {formatValue(indicator)}
              </span>
              {trend && (
                <span
                  class="economic-strip__trend"
                  data-trend={indicator.trend}
                >
                  {trend}
                </span>
              )}
            </dd>
          </div>
        );
      })
    }
  </dl>

  <nav class="economic-strip__actions" aria-label="Herramientas de mercado">
    <a class="economic-strip__action" href="/calendario-economico/">
      <span class="economic-strip__action-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="img">
          <path
            d="M6 2v3M18 2v3M3.5 8h17M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
          ></path>
          <path
            d="M7 11h2v2H7zM11 11h2v2h-2zM15 11h2v2h-2zM7 15h2v2H7zM11 15h2v2h-2zM15 15h2v2h-2z"
          ></path>
        </svg>
      </span>
      <span class="economic-strip__action-label">
        IR A CALENDARIO ECONÓMICO
      </span>
      <span class="economic-strip__action-arrow" aria-hidden="true">→</span>
    </a>

    <a class="economic-strip__action" href="/mercados/indices/">
      <span class="economic-strip__action-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="img">
          <path d="M4 20V14h3v6H4Zm5 0V10h3v10H9Zm5 0V6h3v14h-3Zm5 0V3h2v17h-2Z"
          ></path>
          <path d="m3 13 5-4 4 1 6-6M15 4h3v3"></path>
        </svg>
      </span>
      <span class="economic-strip__action-label">IR A ÍNDICES DE MERCADO</span>
      <span class="economic-strip__action-arrow" aria-hidden="true">→</span>
    </a>
  </nav>

  <p class="economic-strip__source">
    Fuentes: {economicIndicatorsSnapshot.sourceName} · Índices de mercado ATLAS ·
    {freshnessLabel}: <time datetime={asOf}>{asOfLabel}</time>
  </p>
</section>

<style>
  .economic-strip {
    padding: 0.55rem 0 0.65rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--sans);
  }

  .economic-strip__context,
  .economic-strip__source {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0;
    font-size: 0.61rem;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .economic-strip__context strong {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .economic-strip__source {
    justify-content: flex-end;
    color: var(--ink-soft);
  }

  .economic-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0.45rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .economic-strip__item {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    min-width: 0;
    padding: 0.48rem 0.65rem;
  }

  .economic-strip__item:nth-child(even) {
    border-left: 1px solid var(--rule);
  }

  .economic-strip__item:nth-child(n + 3) {
    border-top: 1px solid var(--rule);
  }

  .economic-strip__item dt {
    flex: 0 0 auto;
    margin: 0;
    font-size: 0.63rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.065em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .economic-strip__item dd {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.34rem;
    min-width: 0;
    margin: 0 0 0 auto;
    font-family: var(--serif);
    font-size: clamp(0.8rem, 1.35vw, 1rem);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
  }

  .economic-strip__trend {
    font-size: 0.86em;
  }

  .economic-strip__trend[data-trend="up"] {
    color: #17623d;
  }

  .economic-strip__trend[data-trend="down"] {
    color: #9b1f1f;
  }

  .economic-strip__trend[data-trend="flat"] {
    color: var(--ink-soft);
  }

  .economic-strip__actions {
    margin: 0 0 0.28rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .economic-strip__action {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) 2.8rem;
    align-items: center;
    height: 25px;
    min-height: 25px;
    color: var(--ink);
    text-decoration: none;
  }

  .economic-strip__action + .economic-strip__action {
    border-top: 1px solid var(--rule);
  }

  .economic-strip__action-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    font-size: 0.63rem;
  }

  .economic-strip__action-icon svg {
    width: 1.32em;
    height: 1.32em;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.65;
  }

  .economic-strip__action-icon svg path[d^="M4 20"] {
    fill: currentColor;
    stroke: none;
  }

  .economic-strip__action-label {
    padding: 0 0.4rem;
    font-family: var(--sans);
    font-size: 0.63rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }

  .economic-strip__action-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    border-left: 1px solid var(--rule);
    color: var(--accent);
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1;
  }

  .economic-strip__action:hover .economic-strip__action-label,
  .economic-strip__action:focus-visible .economic-strip__action-label {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  :global(.front-page .headline-board > .calendar-entry) {
    display: none !important;
  }

  @media (min-width: 70.01rem) {
    .economic-strip {
      padding-top: 0.48rem;
      padding-bottom: 0.55rem;
    }

    .economic-strip__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 0.34rem;
    }

    .economic-strip__item {
      padding: 0.36rem 0.48rem;
      border-top: 0 !important;
      border-left: 1px solid var(--rule);
    }

    .economic-strip__item:nth-child(4n + 1) {
      border-left: 0;
    }

    .economic-strip__item:nth-child(n + 5) {
      border-top: 1px solid var(--rule) !important;
    }

    .economic-strip__item dt {
      font-size: 0.59rem;
    }

    .economic-strip__item dd {
      gap: 0.24rem;
      font-size: 0.82rem;
    }

    .economic-strip__actions {
      margin-bottom: 0.24rem;
    }

    .economic-strip__action {
      grid-template-columns: 2.25rem minmax(0, 1fr) 2.55rem;
      min-height: 25px;
    }

    .economic-strip__action-icon {
      font-size: 0.59rem;
    }

    .economic-strip__action-label {
      font-size: 0.59rem;
    }

    .economic-strip__action-arrow {
      font-size: 1rem;
    }

    .economic-strip__source {
      font-size: 0.48rem;
    }
  }

  @media (max-width: 36rem) {
    .economic-strip {
      padding-top: 0.45rem;
      padding-bottom: 0.5rem;
    }

    .economic-strip__context {
      display: grid;
    }

    .economic-strip__grid {
      margin-top: 0.35rem;
    }

    .economic-strip__item {
      gap: 0.3rem;
      padding: 0.38rem 0.45rem;
    }

    .economic-strip__item dt {
      font-size: 0.603rem;
      letter-spacing: 0.045em;
    }

    .economic-strip__item dd {
      gap: 0.25rem;
      font-size: 0.72rem;
      line-height: 1;
      letter-spacing: -0.015em;
    }

    .economic-strip__trend {
      font-size: 0.9em;
    }

    .economic-strip__action {
      grid-template-columns: 2.35rem minmax(0, 1fr) 2.45rem;
      min-height: 25px;
    }

    .economic-strip__action-icon {
      font-size: 0.603rem;
    }

    .economic-strip__action-label {
      padding-left: 0.22rem;
      font-size: 0.603rem;
      letter-spacing: 0.045em;
    }

    .economic-strip__action-arrow {
      font-size: 1rem;
    }

    .economic-strip__source {
      display: block;
      font-size: 0.46rem;
      line-height: 1.2;
      letter-spacing: 0.02em;
      text-align: right;
    }
  }
</style>
