---
import IndicatorIcon from "./IndicatorIcon.astro";
import marketPulse from "../data/market-pulse.json";
import { economicIndicatorsSnapshot } from "../data/economic-indicators";

type Trend = "up" | "down" | "flat";

type MarketAsset = {
  id: string;
  value: number | null;
  unit: string;
  changePercent: number | null;
  trend: Trend;
  effectiveAt: string | null;
  displayEligible?: boolean;
};

type DisplayIndicator = {
  id: string;
  label: string;
  value: number | null;
  unit: string;
  effectiveAt: string | null;
  changePercent: number | null;
  trend: Trend;
  displayEligible?: boolean;
};

const dateFormatter = new Intl.DateTimeFormat("es-CL", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "America/Santiago",
});
const clpFormatter = new Intl.NumberFormat("es-CL", {
  style: "currency",
  currency: "CLP",
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const clpIntegerFormatter = new Intl.NumberFormat("es-CL", {
  style: "currency",
  currency: "CLP",
  maximumFractionDigits: 0,
});
const decimal2Formatter = new Intl.NumberFormat("es-CL", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const variationFormatter = new Intl.NumberFormat("es-CL", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

const snapshot = marketPulse as {
  generatedAt: string | null;
  assets: MarketAsset[];
};

const economicByCode = new Map(
  economicIndicatorsSnapshot.indicators.map((indicator) => [
    indicator.code,
    indicator,
  ]),
);
const marketById = new Map(snapshot.assets.map((asset) => [asset.id, asset]));

function normalizeEconomic(
  code: string,
  label: string,
): DisplayIndicator | null {
  const indicator = economicByCode.get(code);
  if (!indicator) return null;

  return {
    id: code,
    label,
    value: indicator.value,
    unit: indicator.unit,
    effectiveAt: indicator.effectiveDate,
    changePercent: indicator.changePercent ?? null,
    trend: indicator.trend ?? "flat",
  };
}

function normalizeMarket(id: string, label: string): DisplayIndicator {
  const asset = marketById.get(id);
  return {
    id,
    label,
    value: asset?.value ?? null,
    unit: asset?.unit ?? "points",
    effectiveAt: asset?.effectiveAt ?? null,
    changePercent: asset?.changePercent ?? null,
    trend: asset?.trend ?? "flat",
    displayEligible: asset?.displayEligible,
  };
}

const indicators: DisplayIndicator[] = [
  normalizeEconomic("uf", "UF"),
  normalizeEconomic("dolar", "Dólar"),
  normalizeEconomic("euro", "Euro"),
  normalizeEconomic("utm", "UTM"),
  normalizeMarket("brent", "Brent Oil"),
  normalizeEconomic("cobre", "Cobre"),
  normalizeMarket("ipsa", "IPSA"),
  normalizeMarket("sp500", "S&P 500"),
].filter((indicator): indicator is DisplayIndicator => Boolean(indicator));

const priorityIndicators = new Set(["dolar", "cobre", "ipsa", "sp500"]);

function formatDate(date: string) {
  const normalized = date.includes("T") ? date : `${date}T12:00:00-04:00`;
  return dateFormatter.format(new Date(normalized));
}

function isDisplayable(indicator: DisplayIndicator) {
  return (
    indicator.displayEligible !== false &&
    typeof indicator.value === "number" &&
    Number.isFinite(indicator.value)
  );
}

function formatValue(indicator: DisplayIndicator) {
  if (!isDisplayable(indicator)) return "—";

  const value = indicator.value as number;
  switch (indicator.unit) {
    case "clp":
      return clpFormatter.format(value);
    case "clp-integer":
      return clpIntegerFormatter.format(value);
    case "percent":
      return `${decimal2Formatter.format(value)}%`;
    case "usd-per-pound":
      return `US$${decimal2Formatter.format(value)}/lb`;
    case "usd-per-barrel":
      return `US$${decimal2Formatter.format(value)}`;
    case "points":
      return decimal2Formatter.format(value);
    default:
      return decimal2Formatter.format(value);
  }
}

function formatTrend(indicator: DisplayIndicator) {
  if (
    !isDisplayable(indicator) ||
    indicator.changePercent === null ||
    !Number.isFinite(indicator.changePercent)
  ) {
    return null;
  }

  const arrow =
    indicator.trend === "up" ? "▲" : indicator.trend === "down" ? "▼" : "→";
  const change = variationFormatter.format(Math.abs(indicator.changePercent));
  return `${arrow} ${change}%`;
}

const marketGeneratedDate = snapshot.generatedAt?.slice(0, 10) ?? null;
const asOf = marketGeneratedDate ?? economicIndicatorsSnapshot.asOf;
const asOfLabel = formatDate(asOf);
const freshnessLabel =
  economicIndicatorsSnapshot.status === "stale"
    ? "Último dato disponible"
    : "Datos al";
---

<section
  class="economic-panel"
  data-status={economicIndicatorsSnapshot.status}
  aria-labelledby="economic-panel-title"
>
  <header class="economic-panel__header">
    <span class="economic-panel__accent" aria-hidden="true"></span>
    <h2 id="economic-panel-title">
      <span>Indicadores</span> económicos
    </h2>
    <span class="economic-panel__rule" aria-hidden="true"></span>
  </header>

  <div class="economic-panel__grid" role="list">
    {
      indicators.map((indicator) => {
        const trend = formatTrend(indicator);
        const isPriority = priorityIndicators.has(indicator.id);

        return (
          <div
            class="economic-panel__item"
            data-priority={isPriority ? "true" : undefined}
            role="listitem"
          >
            <IndicatorIcon id={indicator.id} />

            <div class="economic-panel__metric">
              <span class="economic-panel__label">{indicator.label}</span>
              <span
                class="economic-panel__value"
                title={
                  indicator.effectiveAt
                    ? `Dato efectivo al ${formatDate(indicator.effectiveAt)}`
                    : undefined
                }
              >
                {formatValue(indicator)}
              </span>
            </div>

            {trend ? (
              <span
                class="economic-panel__trend"
                data-trend={indicator.trend}
                aria-label={`Variación ${trend}`}
              >
                {trend}
              </span>
            ) : (
              <span
                class="economic-panel__trend economic-panel__trend--neutral"
                aria-hidden="true"
              >
                —
              </span>
            )}
          </div>
        );
      })
    }
  </div>

  <p class="economic-panel__source">
    Fuentes: {economicIndicatorsSnapshot.sourceName} · Índices de mercado ATLAS ·
    {freshnessLabel}: <time datetime={asOf}>{asOfLabel}</time>
  </p>
</section>

<style>
  .economic-panel {
    margin: 0.55rem 0 0.3rem;
    padding: 0.8rem 0.85rem 0.55rem;
    border: 1px solid rgb(35 35 29 / 13%);
    border-radius: 0.72rem;
    background: rgb(242 239 229 / 38%);
    font-family: var(--sans);
  }

  .economic-panel__header {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    gap: 0.28rem 0.65rem;
    min-width: 0;
    margin-bottom: 0.42rem;
  }

  .economic-panel__accent {
    grid-column: 1;
    grid-row: 1;
    width: clamp(2.8rem, 6vw, 4.4rem);
    height: 0.18rem;
    background: var(--accent);
  }

  .economic-panel__header h2 {
    grid-column: 1;
    grid-row: 2;
    margin: 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(0.78rem, 1.75vw, 1.18rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .economic-panel__header h2 span {
    color: var(--accent);
  }

  .economic-panel__rule {
    grid-column: 2;
    grid-row: 2;
    width: 100%;
    height: 1px;
    background: rgb(35 35 29 / 72%);
  }

  .economic-panel__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid rgb(35 35 29 / 62%);
  }

  .economic-panel__item {
    --indicator-icon-size: 2.21rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.62rem;
    min-width: 0;
    padding: 0.47rem 0.72rem 0.47rem 0.12rem;
    border-top: 1px solid rgb(35 35 29 / 10%);
  }

  .economic-panel__item:nth-child(even) {
    padding-right: 0.15rem;
    padding-left: 0.72rem;
    border-left: 1px solid rgb(35 35 29 / 9%);
  }

  .economic-panel__item:nth-child(-n + 2) {
    border-top: 0;
  }

  .economic-panel__metric {
    display: grid;
    min-width: 0;
    align-content: center;
    gap: 0.02rem;
  }

  .economic-panel__label {
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 0.61rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.11em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .economic-panel__value {
    overflow: hidden;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(0.86rem, 2.12vw, 1.38rem);
    font-variant-numeric: tabular-nums lining-nums;
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-overflow: clip;
    white-space: nowrap;
  }

  .economic-panel__item[data-priority="true"] .economic-panel__value {
    font-size: clamp(0.9rem, 2.2vw, 1.42rem);
  }

  .economic-panel__trend {
    min-width: max-content;
    font-family: var(--serif);
    font-size: clamp(0.76rem, 1.75vw, 1.05rem);
    font-variant-numeric: tabular-nums lining-nums;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .economic-panel__trend[data-trend="up"] {
    color: #17623d;
  }

  .economic-panel__trend[data-trend="down"] {
    color: #9b1f1f;
  }

  .economic-panel__trend[data-trend="flat"] {
    color: var(--ink-soft);
  }

  .economic-panel__trend--neutral {
    color: rgb(75 73 63 / 43%);
    font-size: 1.1rem;
    font-weight: 400;
  }

  .economic-panel__source {
    margin: 0.34rem 0 0;
    color: var(--ink-soft);
    font-size: 0.47rem;
    line-height: 1.25;
    letter-spacing: 0.035em;
    text-align: right;
    text-transform: uppercase;
  }

  :global(.front-page .headline-board > .calendar-entry) {
    display: none !important;
  }

  :global(.front-page.front-page--v2 .headline-tab) {
    font-size: 0.78rem !important;
  }

  :global(.front-page.front-page--v2 > .daily-audio) {
    padding-top: 0.42rem !important;
  }

  @media (min-width: 42.01rem) and (max-width: 70rem) {
    :global(.front-page.front-page--v2 .headline-tab) {
      font-size: 1.15rem !important;
    }
  }

  @media (min-width: 70.01rem) and (max-width: 79.99rem) {
    :global(.front-page.front-page--v2 .headline-tab) {
      font-size: clamp(1.05rem, 1.265vw, 1.15rem) !important;
    }
  }

  @media (min-width: 70.01rem) {
    .economic-panel {
      padding: 0.95rem 1rem 0.6rem;
    }

    .economic-panel__header {
      margin-bottom: 0.5rem;
    }

    .economic-panel__item {
      --indicator-icon-size: 2.38rem;
      padding-top: 0.52rem;
      padding-bottom: 0.52rem;
    }

    .economic-panel__label {
      font-size: 0.64rem;
    }

    .economic-panel__source {
      font-size: 0.5rem;
    }
  }

  @media (max-width: 42rem) {
    .economic-panel {
      margin-top: 0.42rem;
      margin-bottom: 0.18rem;
      padding: 0.6rem 0.55rem 0.45rem;
      border-radius: 0.55rem;
    }

    .economic-panel__header {
      gap: 0.22rem 0.46rem;
      margin-bottom: 0.3rem;
    }

    .economic-panel__accent {
      width: 2.55rem;
      height: 0.15rem;
    }

    .economic-panel__header h2 {
      font-size: clamp(0.58rem, 2.55vw, 0.78rem);
      letter-spacing: -0.01em;
    }

    .economic-panel__item {
      --indicator-icon-size: 1.74rem;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.38rem;
      padding: 0.36rem 0.38rem 0.36rem 0.04rem;
    }

    .economic-panel__item:nth-child(even) {
      padding-right: 0.02rem;
      padding-left: 0.38rem;
    }

    .economic-panel__label {
      font-size: 0.5rem;
      letter-spacing: 0.07em;
    }

    .economic-panel__value {
      font-size: clamp(0.66rem, 3vw, 0.86rem);
      letter-spacing: -0.025em;
    }

    .economic-panel__item[data-priority="true"] .economic-panel__value {
      font-size: clamp(0.67rem, 3.08vw, 0.89rem);
    }

    .economic-panel__trend {
      font-size: clamp(0.58rem, 2.55vw, 0.74rem);
    }

    .economic-panel__trend--neutral {
      font-size: 0.83rem;
    }

    .economic-panel__source {
      margin-top: 0.28rem;
      font-size: 0.4rem;
      line-height: 1.15;
      letter-spacing: 0.015em;
    }

    :global(.front-page.front-page--v2 .headline-tab) {
      font-size: 0.71rem !important;
    }

    :global(.front-page.front-page--v2 > .daily-audio) {
      padding-top: 0.3rem !important;
    }
  }

  @media (max-width: 25rem) {
    .economic-panel__item {
      --indicator-icon-size: 1.53rem;
      gap: 0.25rem;
      padding-right: 0.18rem;
    }

    .economic-panel__item:nth-child(even) {
      padding-left: 0.24rem;
    }

    .economic-panel__label {
      font-size: 0.46rem;
    }

    .economic-panel__value {
      font-size: 0.62rem;
    }

    .economic-panel__item[data-priority="true"] .economic-panel__value {
      font-size: 0.64rem;
    }

    .economic-panel__trend {
      font-size: 0.54rem;
    }
  }
</style>
