---
import {
  economicIndicatorsSnapshot,
  type EconomicIndicator,
} from "../data/economic-indicators";

const dateFormatter = new Intl.DateTimeFormat("es-CL", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "America/Santiago",
});
const clpFormatter = new Intl.NumberFormat("es-CL", {
  style: "currency",
  currency: "CLP",
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const clpIntegerFormatter = new Intl.NumberFormat("es-CL", {
  style: "currency",
  currency: "CLP",
  maximumFractionDigits: 0,
});
const percentFormatter = new Intl.NumberFormat("es-CL", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const decimalFormatter = new Intl.NumberFormat("es-CL", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const variationFormatter = new Intl.NumberFormat("es-CL", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

function formatDate(date: string) {
  return dateFormatter.format(new Date(`${date}T12:00:00-04:00`));
}

function formatTrend(indicator: EconomicIndicator) {
  if (indicator.changePercent === undefined || !indicator.trend) {
    return "";
  }

  const arrow =
    indicator.trend === "up" ? "▲" : indicator.trend === "down" ? "▼" : "→";
  return ` ${arrow} ${variationFormatter.format(Math.abs(indicator.changePercent))}%`;
}

function formatValue(indicator: EconomicIndicator) {
  let value: string;

  switch (indicator.unit) {
    case "clp":
      value = clpFormatter.format(indicator.value);
      break;
    case "clp-integer":
      value = clpIntegerFormatter.format(indicator.value);
      break;
    case "percent":
      value = `${percentFormatter.format(indicator.value)}%`;
      break;
    case "usd-per-pound":
      value = `US$${decimalFormatter.format(indicator.value)}/lb`;
      break;
  }

  return `${value}${formatTrend(indicator)}`;
}

const asOfLabel = formatDate(economicIndicatorsSnapshot.asOf);
const freshnessLabel =
  economicIndicatorsSnapshot.status === "stale"
    ? "Último dato disponible"
    : "Datos al";
---

<section
  class="economic-strip"
  data-status={economicIndicatorsSnapshot.status}
  aria-label="Indicadores económicos de referencia"
>
  <div class="economic-strip__context">
    <strong>Indicadores económicos</strong>
  </div>

  <dl class="economic-strip__grid">
    {
      economicIndicatorsSnapshot.indicators.map((indicator) => (
        <div class="economic-strip__item">
          <dt>{indicator.label}</dt>
          <dd title={`Dato efectivo al ${formatDate(indicator.effectiveDate)}`}>
            {formatValue(indicator)}
          </dd>
        </div>
      ))
    }
  </dl>

  <p class="economic-strip__source">
    Fuente: <a href={economicIndicatorsSnapshot.sourceUrl}>
      {economicIndicatorsSnapshot.sourceName}
    </a>
    <span aria-hidden="true"> · </span>
    {freshnessLabel}: <time datetime={economicIndicatorsSnapshot.asOf}>
      {asOfLabel}
    </time>
  </p>
</section>

<style>
  .economic-strip {
    padding: 0.55rem 0 0.65rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--sans);
  }

  .economic-strip__context,
  .economic-strip__source {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0;
    font-size: 0.61rem;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .economic-strip__context strong {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .economic-strip__source {
    color: var(--ink-soft);
  }

  .economic-strip__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0.45rem 0 0.35rem;
    padding: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .economic-strip__item {
    min-width: 0;
    padding: 0.45rem 0.65rem;
    border-left: 1px solid var(--rule);
  }

  .economic-strip__item:first-child {
    border-left: 0;
  }

  .economic-strip__item dt {
    overflow: hidden;
    margin: 0 0 0.18rem;
    font-size: 0.55rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .economic-strip__item dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(0.8rem, 1.35vw, 1rem);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
  }

  .economic-strip__source {
    justify-content: flex-end;
  }

  .economic-strip__source a {
    text-underline-offset: 0.12em;
  }

  @media (max-width: 64rem) {
    .economic-strip__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .economic-strip__item:nth-child(4) {
      border-left: 0;
    }

    .economic-strip__item:nth-child(n + 4) {
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 36rem) {
    .economic-strip__context {
      display: grid;
    }

    .economic-strip__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .economic-strip__item:nth-child(4) {
      border-left: 1px solid var(--rule);
    }

    .economic-strip__item:nth-child(odd) {
      border-left: 0;
    }

    .economic-strip__item:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }

    .economic-strip__source {
      display: block;
      font-size: 0.5rem;
      line-height: 1.2;
      letter-spacing: 0.03em;
      text-align: right;
    }
  }
</style>
