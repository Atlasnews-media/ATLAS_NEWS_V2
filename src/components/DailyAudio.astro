---
import AtlasAudioPlayer from "./AtlasAudioPlayer.astro";

interface Props {
  expectedDate?: string;
}

const { expectedDate } = Astro.props;
---

<section
  class="daily-audio"
  data-daily-audio
  data-expected-date={expectedDate}
  aria-labelledby="daily-audio-title"
  hidden
>
  <div class="audio-copy">
    <span class="audio-accent" aria-hidden="true"></span>
    <p class="audio-kicker" id="daily-audio-title">
      <span>ATLAS NEWS</span> RADIO
    </p>
    <span class="audio-rule" aria-hidden="true"></span>
  </div>
  <div class="audio-player">
    <AtlasAudioPlayer
      preload="metadata"
      ariaLabel="Resumen diario de ATLAS NEWS"
      engineRole="daily"
      visualVariant="radio"
    />
  </div>
</section>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector("[data-daily-audio]");
    if (!(root instanceof HTMLElement)) return;

    // El resumen diario pertenece exclusivamente a Portada.
    // Al salir de esta vista, el componente se desmonta junto con la página.
    if (window.location.pathname !== "/") {
      root.hidden = true;
      return;
    }

    // Evita repetir player.load() si esta instancia ya resolvió su audio.
    if (root.dataset.audioContentKey) {
      root.hidden = false;
      return;
    }

    const expectedDate = root.dataset.expectedDate;
    if (!expectedDate || !/^\d{4}-\d{2}-\d{2}$/.test(expectedDate)) return;

    const player = root.querySelector("[data-atlas-audio-engine]");
    const source = root.querySelector("[data-atlas-audio-source]");

    if (
      !(player instanceof HTMLAudioElement) ||
      !(source instanceof HTMLSourceElement)
    ) {
      return;
    }

    // I3: adelanta sólo trabajo de red determinista. El MP3 diario conserva
    // el contrato AAAA-MM-DD-resumen-diario.mp3, por lo que metadata del
    // audio + peaks + WaveSurfer pueden comenzar mientras latest.json valida
    // la autoridad. El componente permanece oculto hasta esa validación.
    const speculativePath = `/audio/${expectedDate}-resumen-diario.mp3`;
    const currentSource = source.getAttribute("src") ?? "";
    if (currentSource !== speculativePath) {
      source.src = speculativePath;
      player.load();
    } else if (player.error) {
      player.load();
    }

    fetch(`/audio/latest.json?v=${Date.now()}`, { cache: "no-store" })
      .then((response) => {
        if (!response.ok) throw new Error("audio metadata unavailable");
        return response.json();
      })
      .then((metadata) => {
        if (
          metadata?.status !== "published" ||
          metadata?.date !== expectedDate ||
          !metadata?.path
        ) {
          return;
        }

        const contentKey = `${metadata.date}|${metadata.path}`;
        const resolvedSource = source.getAttribute("src") ?? "";
        if (resolvedSource !== metadata.path) {
          source.src = metadata.path;
          player.load();
        } else if (player.error) {
          player.load();
        }

        root.dataset.audioContentKey = contentKey;
        root.hidden = false;
      })
      .catch(() => {
        if (!root.dataset.audioContentKey) root.hidden = true;
      });
  })();
</script>

<style>
  .daily-audio {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: center;
    padding: 0.68rem 0 0.72rem;
    border-bottom: 4px double var(--rule);
  }

  .daily-audio[hidden] {
    display: none;
  }

  .audio-copy {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    gap: 0.28rem 0.65rem;
    min-width: 0;
    margin-bottom: 0.42rem;
  }

  .audio-accent {
    grid-column: 1;
    grid-row: 1;
    width: clamp(2.8rem, 6vw, 4.4rem);
    height: 0.18rem;
    background: var(--accent);
  }

  .audio-kicker {
    grid-column: 1;
    grid-row: 2;
    margin: 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(0.78rem, 1.75vw, 1.18rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .audio-kicker span {
    color: var(--accent);
  }

  .audio-rule {
    grid-column: 2;
    grid-row: 2;
    width: 100%;
    height: 1px;
    background: rgb(35 35 29 / 72%);
  }

  .audio-player {
    min-width: 0;
    width: 100%;
  }

  @media (min-width: 70.01rem) {
    .daily-audio {
      padding: 0.62rem 0 0.68rem;
    }
  }

  @media (max-width: 42rem) {
    .daily-audio {
      padding: 0.58rem 0 0.62rem;
      border-bottom: 0;
    }

    .audio-copy {
      gap: 0.22rem 0.46rem;
      margin-bottom: 0.3rem;
    }

    .audio-accent {
      width: 2.55rem;
      height: 0.15rem;
    }

    .audio-kicker {
      font-size: clamp(0.58rem, 2.55vw, 0.78rem);
      letter-spacing: -0.01em;
    }
  }
</style>
