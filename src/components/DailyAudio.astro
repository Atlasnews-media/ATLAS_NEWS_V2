---
import AtlasAudioPlayer from "./AtlasAudioPlayer.astro";

interface Props {
  expectedDate?: string;
}

const { expectedDate } = Astro.props;
---

<section
  class="daily-audio"
  data-daily-audio
  data-expected-date={expectedDate}
  aria-labelledby="daily-audio-title"
  hidden
>
  <div class="audio-copy">
    <p class="audio-kicker" id="daily-audio-title">
      Escuchar el resumen del día
    </p>
    <p data-audio-summary>
      Una cápsula con las señales principales de hoy: el titular, Nacional y
      Mercados.
    </p>
  </div>
  <div class="audio-player">
    <AtlasAudioPlayer
      preload="metadata"
      ariaLabel="Resumen diario de ATLAS NEWS"
      engineRole="daily"
    />
  </div>
</section>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector("[data-daily-audio]");
    if (!(root instanceof HTMLElement)) return;

    // El resumen diario pertenece exclusivamente a Portada.
    // Al salir de esta vista, el componente se desmonta junto con la página.
    if (window.location.pathname !== "/") {
      root.hidden = true;
      return;
    }

    // Evita repetir player.load() si esta instancia ya resolvió su audio.
    if (root.dataset.audioContentKey) {
      root.hidden = false;
      return;
    }

    const expectedDate = root.dataset.expectedDate;
    if (!expectedDate) return;

    fetch(`/audio/latest.json?v=${Date.now()}`, { cache: "no-store" })
      .then((response) => {
        if (!response.ok) throw new Error("audio metadata unavailable");
        return response.json();
      })
      .then((metadata) => {
        if (
          metadata?.status !== "published" ||
          metadata?.date !== expectedDate ||
          !metadata?.path
        ) {
          return;
        }

        const player = root.querySelector("[data-atlas-audio-engine]");
        const source = root.querySelector("[data-atlas-audio-source]");

        if (
          !(player instanceof HTMLAudioElement) ||
          !(source instanceof HTMLSourceElement)
        ) {
          return;
        }

        const contentKey = `${metadata.date}|${metadata.path}`;
        const currentSource = source.getAttribute("src") ?? "";
        if (currentSource !== metadata.path) {
          source.src = metadata.path;
          player.load();
        }

        root.dataset.audioContentKey = contentKey;
        root.hidden = false;
      })
      .catch(() => {
        if (!root.dataset.audioContentKey) root.hidden = true;
      });
  })();
</script>

<style>
  .daily-audio {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
    padding: 0.8rem 0 1.5rem;
    border-bottom: 4px double var(--rule);
  }
  .daily-audio[hidden] {
    display: none;
  }
  .audio-kicker {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .audio-copy > p:last-child {
    max-width: 45rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .audio-player {
    min-width: 0;
  }

  @media (min-width: 70.01rem) {
    .daily-audio {
      grid-template-columns: minmax(12rem, 0.42fr) minmax(0, 1.58fr);
      gap: 0.9rem;
      padding: 0.62rem 0 0.68rem;
    }

    .audio-kicker {
      font-size: 0.64rem;
      letter-spacing: 0.12em;
    }

    .audio-copy > p:last-child {
      display: none;
    }
  }

  @media (max-width: 42rem) {
    .daily-audio {
      grid-template-columns: 1fr;
      gap: 0.3rem;
      padding: 0.58rem 0 0.62rem;
      border-bottom: 0;
    }

    .audio-kicker {
      font-size: 0.61rem;
      line-height: 1.35;
      letter-spacing: 0.12em;
    }

    .audio-copy > p:last-child {
      display: none;
    }

    .audio-player {
      width: 100%;
    }
  }
</style>
