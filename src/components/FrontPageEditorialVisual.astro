---
import { getEntry } from "astro:content";

interface Props {
  editionId: string;
}

const { editionId } = Astro.props;
const edition = await getEntry("editions", editionId);
const visual = edition?.data.editorialVisual;
const visualSrc = visual?.src ?? "";
const visualAllowed = (() => {
  if (!visualSrc) return false;
  try {
    const hostname = new URL(visualSrc).hostname;
    return (
      hostname === "upload.wikimedia.org" || hostname === "commons.wikimedia.org"
    );
  } catch {
    return false;
  }
})();
---

{
  visual && visualAllowed && (
    <figure
      class="front-page-editorial-visual"
      data-front-page-editorial-visual
    >
      <img
        src={visualSrc}
        alt={visual.alt ?? ""}
        loading="eager"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror="this.closest('[data-front-page-editorial-visual]')?.remove()"
      />
      <figcaption>
        <span>{`${visual.source} · ${visual.author} · ${visual.license}`}</span>
        <a
          href={visual.sourceUrl ?? ""}
          target="_blank"
          rel="noopener noreferrer"
        >
          Fuente
        </a>
      </figcaption>
    </figure>
  )
}

<style>
  .front-page-editorial-visual {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .front-page-editorial-visual img {
    display: block;
    width: 100%;
    max-height: 18rem;
    object-fit: cover;
    filter: sepia(0.72) contrast(0.92);
  }
  .front-page-editorial-visual figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.45rem;
    margin-top: 0.45rem;
    color: var(--ink-soft);
    font: 600 0.6rem/1.35 var(--sans);
  }
  .front-page-editorial-visual figcaption a {
    color: inherit;
  }

  @media (max-width: 42rem) {
    .front-page-editorial-visual {
      display: none;
    }
  }
</style>
