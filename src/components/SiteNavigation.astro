---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const menuEntries = [
  { href: "/internacional/", label: "Internacional", icon: "globe" },
  { href: "/nacional/", label: "Nacional", icon: "pin" },
  { href: "/mercados/", label: "Mercados", icon: "trend" },
  { href: "/senales/", label: "Señales del día", icon: "signal" },
  { href: "/mediodia/", label: "Mediodía", icon: "sun" },
  { href: "/vespertino/", label: "Vespertino", icon: "sunset" },
  {
    href: "/calendario-economico/",
    label: "Calendario económico",
    icon: "calendar",
  },
  { href: "/mercados/indices/", label: "Índices de mercado", icon: "bars" },
  { href: null, label: "Contingencia", icon: "alert" },
  { href: "/lecturas/", label: "Lecturas", icon: "book" },
] as const;

const linkedHrefs: string[] = [];
for (const { href } of menuEntries) {
  if (href !== null) linkedHrefs.push(href);
}

const activeMenuHref = linkedHrefs
  .sort((a, b) => b.length - a.length)
  .find((href) => currentPath === href || currentPath.startsWith(href));
---

<div
  class="site-navigation"
  role="navigation"
  aria-label="Navegación principal"
  data-site-navigation
>
  <a
    class:list={["site-navigation__home", { "is-active": currentPath === "/" }]}
    href="/"
    aria-current={currentPath === "/" ? "page" : undefined}
  >
    Portada
  </a>
  <div class="site-navigation__edition" aria-label="Edición matutina">
    Edición matutina
  </div>
  <button
    class="site-navigation__toggle"
    type="button"
    aria-label="Abrir menú de secciones"
    aria-expanded="false"
    aria-controls="atlas-section-menu"
    data-section-menu-toggle
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
</div>

<svg class="section-menu__icon-defs" aria-hidden="true">
  <symbol id="atlas-menu-globe" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8"></circle>
    <path
      d="M4.5 12h15M12 4c2.2 2.2 3.2 4.9 3.2 8S14.2 17.8 12 20c-2.2-2.2-3.2-4.9-3.2-8S9.8 6.2 12 4Z"
    ></path>
  </symbol>
  <symbol id="atlas-menu-pin" viewBox="0 0 24 24">
    <path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"></path>
    <circle cx="12" cy="10" r="2"></circle>
  </symbol>
  <symbol id="atlas-menu-trend" viewBox="0 0 24 24">
    <path d="M4 18 9 13l3 3 7-8"></path>
    <path d="M15 8h4v4"></path>
  </symbol>
  <symbol id="atlas-menu-signal" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="2"></circle>
    <path d="M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7"></path>
    <path d="M5.5 5.5a9.2 9.2 0 0 0 0 13M18.5 5.5a9.2 9.2 0 0 1 0 13"></path>
  </symbol>
  <symbol id="atlas-menu-sun" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path
      d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"
    ></path>
  </symbol>
  <symbol id="atlas-menu-sunset" viewBox="0 0 24 24">
    <path d="M4 18h16M6 14a6 6 0 0 1 12 0M12 4v3M5.5 7.5l2 2M18.5 7.5l-2 2"
    ></path>
  </symbol>
  <symbol id="atlas-menu-calendar" viewBox="0 0 24 24">
    <rect x="4" y="5" width="16" height="15" rx="1.5"></rect>
    <path d="M8 3v4M16 3v4M4 9h16M8 13h2M12 13h2M16 13h1M8 17h2M12 17h2"></path>
  </symbol>
  <symbol id="atlas-menu-bars" viewBox="0 0 24 24">
    <path d="M5 20v-6h3v6H5ZM10.5 20V9h3v11h-3ZM16 20V4h3v16h-3Z"></path>
  </symbol>
  <symbol id="atlas-menu-alert" viewBox="0 0 24 24">
    <path d="M12 4 21 20H3L12 4Z"></path>
    <path d="M12 9v5M12 17.2v.1"></path>
  </symbol>
  <symbol id="atlas-menu-book" viewBox="0 0 24 24">
    <path
      d="M4 5.5c3.2-.6 5.7.1 8 2.1v12c-2.3-2-4.8-2.7-8-2.1v-12ZM20 5.5c-3.2-.6-5.7.1-8 2.1v12c2.3-2 4.8-2.7 8-2.1v-12Z"
    ></path>
  </symbol>
</svg>

<div class="section-menu-backdrop" data-section-menu-backdrop hidden></div>
<div
  class="section-menu"
  id="atlas-section-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Secciones de ATLAS NEWS"
  aria-hidden="true"
  data-section-menu
  hidden
>
  <div class="section-menu__panel">
    <div class="section-menu__heading">
      <span>Secciones</span>
      <button
        class="section-menu__close"
        type="button"
        aria-label="Cerrar menú de secciones"
        data-section-menu-close
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <div class="section-menu__links" role="navigation" aria-label="Secciones">
      {
        menuEntries.map(({ href, label, icon }) =>
          href ? (
            <a
              class:list={[
                "section-menu__link",
                { "is-active": activeMenuHref === href },
              ]}
              href={href}
              aria-current={activeMenuHref === href ? "page" : undefined}
              data-section-menu-link
            >
              <span class="section-menu__item-main">
                <svg class="section-menu__icon" aria-hidden="true">
                  <use href={`#atlas-menu-${icon}`} />
                </svg>
                <span>{label}</span>
              </span>
              <span class="section-menu__arrow" aria-hidden="true">
                ›
              </span>
            </a>
          ) : (
            <span
              class="section-menu__link is-unavailable"
              aria-disabled="true"
            >
              <span class="section-menu__item-main">
                <svg class="section-menu__icon" aria-hidden="true">
                  <use href={`#atlas-menu-${icon}`} />
                </svg>
                <span>{label}</span>
              </span>
            </span>
          ),
        )
      }
    </div>
  </div>
</div>

<script>
  type AtlasNavigationWindow = Window & {
    __atlasSectionMenuAbort?: AbortController;
    __atlasSectionMenuSetup?: () => void;
    __atlasSectionMenuPageLoadBound?: boolean;
  };

  const atlasNavigationWindow = window as AtlasNavigationWindow;

  const setupSectionMenu = () => {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-section-menu-toggle]",
    );
    const menu = document.querySelector<HTMLElement>("[data-section-menu]");
    const backdrop = document.querySelector<HTMLElement>(
      "[data-section-menu-backdrop]",
    );
    const closeButton = document.querySelector<HTMLButtonElement>(
      "[data-section-menu-close]",
    );
    const navigation = document.querySelector<HTMLElement>(
      "[data-site-navigation]",
    );

    if (!toggle || !menu || !backdrop || !closeButton || !navigation) return;

    atlasNavigationWindow.__atlasSectionMenuAbort?.abort();
    const controller = new AbortController();
    atlasNavigationWindow.__atlasSectionMenuAbort = controller;
    const { signal } = controller;

    const syncMenuTop = () => {
      const { bottom } = navigation.getBoundingClientRect();
      document.documentElement.style.setProperty(
        "--atlas-section-menu-top",
        `${Math.max(0, bottom)}px`,
      );
    };

    const closeMenu = (restoreFocus = true) => {
      menu.hidden = true;
      backdrop.hidden = true;
      menu.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú de secciones");
      document.body.classList.remove("atlas-section-menu-open");
      if (restoreFocus) toggle.focus();
    };

    const openMenu = () => {
      syncMenuTop();
      menu.hidden = false;
      backdrop.hidden = false;
      menu.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menú de secciones");
      document.body.classList.add("atlas-section-menu-open");
      closeButton.focus();
    };

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    toggle.addEventListener(
      "click",
      () => {
        if (isOpen()) closeMenu();
        else openMenu();
      },
      { signal },
    );
    closeButton.addEventListener("click", () => closeMenu(), { signal });
    backdrop.addEventListener("click", () => closeMenu(), { signal });
    window.addEventListener(
      "resize",
      () => {
        if (isOpen()) syncMenuTop();
      },
      { signal },
    );

    menu
      .querySelectorAll<HTMLAnchorElement>("[data-section-menu-link]")
      .forEach((link) => {
        link.addEventListener("click", () => closeMenu(false), { signal });
      });

    document.addEventListener(
      "keydown",
      (event) => {
        if (!isOpen()) return;

        if (event.key === "Escape") {
          event.preventDefault();
          closeMenu();
          return;
        }

        if (event.key !== "Tab") return;
        const focusable = Array.from(
          menu.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        );
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      },
      { signal },
    );
  };

  atlasNavigationWindow.__atlasSectionMenuSetup = setupSectionMenu;
  setupSectionMenu();

  if (!atlasNavigationWindow.__atlasSectionMenuPageLoadBound) {
    document.addEventListener("astro:page-load", () => {
      atlasNavigationWindow.__atlasSectionMenuSetup?.();
    });
    atlasNavigationWindow.__atlasSectionMenuPageLoadBound = true;
  }
</script>

<style>
  .site-navigation {
    display: flex;
    align-items: stretch;
    min-height: 3.3rem;
    border-top: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-navigation__home,
  .site-navigation__toggle {
    min-height: 3.3rem;
    color: inherit;
    background: transparent;
    transition: background-color 140ms ease;
  }

  .site-navigation__home {
    display: flex;
    flex: 0 0 20%;
    align-items: center;
    justify-content: center;
    min-width: 7.5rem;
    padding: 0.8rem 0.55rem;
    border-right: 1px solid rgba(31, 29, 23, 0.16);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-navigation__edition {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3.3rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.5rem;
    font: 700 clamp(0.92rem, 2.2vw, 1.35rem) / 1 var(--display);
    letter-spacing: -0.025em;
    text-align: center;
    white-space: nowrap;
  }

  .site-navigation__home.is-active,
  .site-navigation__home:hover,
  .site-navigation__toggle:hover {
    background: rgba(31, 29, 23, 0.045);
  }

  .site-navigation__toggle {
    display: grid;
    width: 4rem;
    margin-left: auto;
    padding: 0.85rem 1rem;
    border: 0;
    border-left: 1px solid rgba(31, 29, 23, 0.16);
    place-content: center;
    gap: 0.32rem;
    cursor: pointer;
  }

  .site-navigation__toggle span {
    display: block;
    width: 1.6rem;
    height: 2px;
    background: currentColor;
  }

  .section-menu__icon-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .section-menu-backdrop,
  .section-menu {
    position: fixed;
    top: var(--atlas-section-menu-top, 0px);
    right: 0;
    bottom: 0;
    left: 0;
  }

  .section-menu-backdrop {
    z-index: 1098;
    background: rgba(31, 29, 23, 0.2);
  }

  .section-menu {
    z-index: 1099;
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: none;
  }

  .section-menu__panel {
    width: min(88rem, calc(100% - 2rem));
    max-height: min(
      70dvh,
      calc(100dvh - var(--atlas-section-menu-top, 0px) - 4rem)
    );
    margin: 0 auto;
    overflow-y: auto;
    border-right: 1px solid rgba(31, 29, 23, 0.14);
    border-bottom: 1px solid var(--rule);
    border-left: 1px solid rgba(31, 29, 23, 0.14);
    background: #f2efe5;
    box-shadow: 0 1rem 2rem rgba(31, 29, 23, 0.14);
    pointer-events: auto;
  }

  .section-menu__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.7rem;
    padding: 0.38rem 0.82rem 0.38rem 1rem;
    border-bottom: 1px solid rgba(31, 29, 23, 0.2);
    font: 800 0.6rem/1 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-menu__close {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .section-menu__close span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.35rem;
    height: 2px;
    background: currentColor;
    transform-origin: center;
  }

  .section-menu__close span:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .section-menu__close span:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .section-menu__links {
    display: grid;
  }

  .section-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    padding: 0.55rem 1rem;
    border-bottom: 1px solid rgba(31, 29, 23, 0.14);
    color: inherit;
    font: 700 clamp(0.94rem, 2.1vw, 1.42rem) / 1.08 var(--serif);
    text-decoration: none;
  }

  .section-menu__link:last-child {
    border-bottom: 0;
  }

  .section-menu__item-main {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.72rem;
  }

  .section-menu__icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: 0 0 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.55;
  }

  .section-menu__link:not(.is-unavailable) .section-menu__icon {
    color: var(--accent);
  }

  a.section-menu__link:hover,
  a.section-menu__link.is-active {
    background: rgba(31, 29, 23, 0.045);
  }

  .section-menu__arrow {
    flex: 0 0 auto;
    margin-left: 1rem;
    font: 400 1.35rem/1 var(--serif);
  }

  .section-menu__link.is-unavailable {
    color: rgba(31, 29, 23, 0.48);
  }

  :global(body.atlas-section-menu-open) {
    overflow: hidden;
  }

  :global(body.atlas-section-menu-open .site-header) {
    z-index: 1100;
  }

  @media (max-width: 42rem) {
    .site-navigation,
    .site-navigation__home,
    .site-navigation__edition,
    .site-navigation__toggle {
      min-height: 2.42rem;
    }

    .site-navigation {
      font-size: 0.68rem;
    }

    .site-navigation__home {
      flex: 0 0 5rem;
      min-width: 5rem;
      padding: 0.55rem 0.4rem;
    }

    .site-navigation__edition {
      padding: 0.5rem 0.35rem;
      font-size: 0.8rem;
    }

    .site-navigation__toggle {
      flex: 0 0 5rem;
      width: 5rem;
      padding: 0.65rem 0.85rem;
      gap: 0.216rem;
    }

    .site-navigation__toggle span {
      width: 1.0125rem;
      height: 1.35px;
    }

    .section-menu__panel {
      width: min(100% - 1.25rem, 88rem);
      max-height: min(
        68dvh,
        calc(100dvh - var(--atlas-section-menu-top, 0px) - 4rem)
      );
    }

    .section-menu__heading {
      min-height: 2.45rem;
      padding: 0.3rem 0.72rem 0.3rem 0.85rem;
    }

    .section-menu__close {
      width: 2rem;
      height: 2rem;
    }

    .section-menu__link {
      min-height: 2.8rem;
      padding: 0.48rem 0.85rem;
      font-size: clamp(0.74rem, 3.72vw, 0.96rem);
    }

    .section-menu__item-main {
      gap: 0.62rem;
    }

    .section-menu__icon {
      width: 1.05rem;
      height: 1.05rem;
      flex-basis: 1.05rem;
    }

    .section-menu__arrow {
      font-size: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-navigation__home,
    .site-navigation__toggle {
      transition: none;
    }
  }
</style>
