---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const menuEntries = [
  { href: "/internacional/", label: "Internacional" },
  { href: "/nacional/", label: "Nacional" },
  { href: "/mercados/", label: "Mercados" },
  { href: "/senales/", label: "Señales del día" },
  { href: null, label: "Medio día" },
  { href: null, label: "Tarde" },
  { href: "/calendario-economico/", label: "Calendario económico" },
  { href: "/mercados/indices/", label: "Índices de mercado" },
  { href: null, label: "Contingencia" },
  { href: "/lecturas/", label: "Lecturas" },
] as const;

const activeMenuHref = menuEntries
  .map(({ href }) => href)
  .filter((href): href is string => href !== null)
  .sort((a, b) => b.length - a.length)
  .find(
    (href) =>
      currentPath === href ||
      (href !== "/" && currentPath.startsWith(href)),
  );
---

<div
  class="site-navigation"
  role="navigation"
  aria-label="Navegación principal"
  data-site-navigation
>
  <a
    class:list={[
      "site-navigation__home",
      { "is-active": currentPath === "/" },
    ]}
    href="/"
    aria-current={currentPath === "/" ? "page" : undefined}
  >
    Portada
  </a>
  <button
    class="site-navigation__toggle"
    type="button"
    aria-label="Abrir menú de secciones"
    aria-expanded="false"
    aria-controls="atlas-section-menu"
    data-section-menu-toggle
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
</div>

<div class="section-menu-backdrop" data-section-menu-backdrop hidden></div>
<div
  class="section-menu"
  id="atlas-section-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Secciones de ATLAS NEWS"
  aria-hidden="true"
  data-section-menu
  hidden
>
  <div class="section-menu__panel">
    <div class="section-menu__heading">
      <span>Secciones</span>
      <button
        class="section-menu__close"
        type="button"
        aria-label="Cerrar menú de secciones"
        data-section-menu-close
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <div class="section-menu__links" role="navigation" aria-label="Secciones">
      {
        menuEntries.map(({ href, label }) =>
          href ? (
            <a
              class:list={[
                "section-menu__link",
                { "is-active": activeMenuHref === href },
              ]}
              href={href}
              aria-current={activeMenuHref === href ? "page" : undefined}
              data-section-menu-link
            >
              <span>{label}</span>
              <span class="section-menu__arrow" aria-hidden="true">›</span>
            </a>
          ) : (
            <span
              class="section-menu__link is-unavailable"
              aria-disabled="true"
            >
              <span>{label}</span>
            </span>
          ),
        )
      }
    </div>
  </div>
</div>

<script>
  type AtlasNavigationWindow = Window & {
    __atlasSectionMenuAbort?: AbortController;
    __atlasSectionMenuSetup?: () => void;
    __atlasSectionMenuPageLoadBound?: boolean;
  };

  const atlasNavigationWindow = window as AtlasNavigationWindow;

  const setupSectionMenu = () => {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-section-menu-toggle]",
    );
    const menu = document.querySelector<HTMLElement>("[data-section-menu]");
    const backdrop = document.querySelector<HTMLElement>(
      "[data-section-menu-backdrop]",
    );
    const closeButton = document.querySelector<HTMLButtonElement>(
      "[data-section-menu-close]",
    );
    const navigation = document.querySelector<HTMLElement>(
      "[data-site-navigation]",
    );

    if (!toggle || !menu || !backdrop || !closeButton || !navigation) return;

    atlasNavigationWindow.__atlasSectionMenuAbort?.abort();
    const controller = new AbortController();
    atlasNavigationWindow.__atlasSectionMenuAbort = controller;
    const { signal } = controller;

    const syncMenuTop = () => {
      const { bottom } = navigation.getBoundingClientRect();
      document.documentElement.style.setProperty(
        "--atlas-section-menu-top",
        `${Math.max(0, bottom)}px`,
      );
    };

    const closeMenu = (restoreFocus = true) => {
      menu.hidden = true;
      backdrop.hidden = true;
      menu.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú de secciones");
      document.body.classList.remove("atlas-section-menu-open");
      if (restoreFocus) toggle.focus();
    };

    const openMenu = () => {
      syncMenuTop();
      menu.hidden = false;
      backdrop.hidden = false;
      menu.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menú de secciones");
      document.body.classList.add("atlas-section-menu-open");
      closeButton.focus();
    };

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    toggle.addEventListener(
      "click",
      () => {
        if (isOpen()) closeMenu();
        else openMenu();
      },
      { signal },
    );
    closeButton.addEventListener("click", () => closeMenu(), { signal });
    backdrop.addEventListener("click", () => closeMenu(), { signal });
    window.addEventListener(
      "resize",
      () => {
        if (isOpen()) syncMenuTop();
      },
      { signal },
    );

    menu
      .querySelectorAll<HTMLAnchorElement>("[data-section-menu-link]")
      .forEach((link) => {
        link.addEventListener("click", () => closeMenu(false), { signal });
      });

    document.addEventListener(
      "keydown",
      (event) => {
        if (!isOpen()) return;

        if (event.key === "Escape") {
          event.preventDefault();
          closeMenu();
          return;
        }

        if (event.key !== "Tab") return;
        const focusable = Array.from(
          menu.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        );
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      },
      { signal },
    );
  };

  atlasNavigationWindow.__atlasSectionMenuSetup = setupSectionMenu;
  setupSectionMenu();

  if (!atlasNavigationWindow.__atlasSectionMenuPageLoadBound) {
    document.addEventListener("astro:page-load", () => {
      atlasNavigationWindow.__atlasSectionMenuSetup?.();
    });
    atlasNavigationWindow.__atlasSectionMenuPageLoadBound = true;
  }
</script>

<style>
  .site-navigation {
    display: flex;
    align-items: stretch;
    min-height: 3.3rem;
    border-top: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-navigation__home,
  .site-navigation__toggle {
    min-height: 3.3rem;
    color: inherit;
    background: transparent;
    transition: background-color 140ms ease;
  }

  .site-navigation__home {
    display: flex;
    flex: 0 0 20%;
    align-items: center;
    justify-content: center;
    min-width: 7.5rem;
    padding: 0.8rem 0.55rem;
    border-right: 1px solid rgba(31, 29, 23, 0.16);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-navigation__home.is-active,
  .site-navigation__home:hover,
  .site-navigation__toggle:hover {
    background: rgba(31, 29, 23, 0.045);
  }

  .site-navigation__toggle {
    display: grid;
    width: 4rem;
    margin-left: auto;
    padding: 0.85rem 1rem;
    border: 0;
    border-left: 1px solid rgba(31, 29, 23, 0.16);
    place-content: center;
    gap: 0.32rem;
    cursor: pointer;
  }

  .site-navigation__toggle span {
    display: block;
    width: 1.6rem;
    height: 2px;
    background: currentColor;
  }

  .section-menu-backdrop,
  .section-menu {
    position: fixed;
    top: var(--atlas-section-menu-top, 0px);
    right: 0;
    bottom: 0;
    left: 0;
  }

  .section-menu-backdrop {
    z-index: 1098;
    background: rgba(31, 29, 23, 0.38);
    backdrop-filter: blur(1.5px);
  }

  .section-menu {
    z-index: 1099;
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: none;
  }

  .section-menu__panel {
    width: min(88rem, calc(100% - 2rem));
    max-height: calc(100dvh - var(--atlas-section-menu-top, 0px));
    margin: 0 auto;
    overflow-y: auto;
    border-right: 1px solid rgba(31, 29, 23, 0.14);
    border-bottom: 1px solid var(--rule);
    border-left: 1px solid rgba(31, 29, 23, 0.14);
    background: #f2efe5;
    box-shadow: 0 1.2rem 2.5rem rgba(31, 29, 23, 0.16);
    pointer-events: auto;
  }

  .section-menu__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.2rem;
    padding: 0.55rem 1rem 0.55rem 1.25rem;
    border-bottom: 1px solid rgba(31, 29, 23, 0.2);
    font: 800 0.66rem/1 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-menu__close {
    position: relative;
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .section-menu__close span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.55rem;
    height: 2px;
    background: currentColor;
    transform-origin: center;
  }

  .section-menu__close span:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .section-menu__close span:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .section-menu__links {
    display: grid;
  }

  .section-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    padding: 0.82rem 1.25rem;
    border-bottom: 1px solid rgba(31, 29, 23, 0.16);
    color: inherit;
    font: 700 clamp(1.22rem, 2.8vw, 1.9rem) / 1.1 var(--serif);
    text-decoration: none;
  }

  .section-menu__link:last-child {
    border-bottom: 0;
  }

  a.section-menu__link:hover,
  a.section-menu__link.is-active {
    background: rgba(31, 29, 23, 0.045);
  }

  .section-menu__arrow {
    flex: 0 0 auto;
    margin-left: 1rem;
    font: 400 1.8rem/1 var(--serif);
  }

  .section-menu__link.is-unavailable {
    color: rgba(31, 29, 23, 0.48);
  }

  :global(body.atlas-section-menu-open) {
    overflow: hidden;
  }

  :global(body.atlas-section-menu-open .site-header) {
    z-index: 1100;
  }

  @media (max-width: 42rem) {
    .site-navigation,
    .site-navigation__home,
    .site-navigation__toggle {
      min-height: 2.85rem;
    }

    .site-navigation {
      font-size: 0.68rem;
    }

    .site-navigation__home {
      flex-basis: 28%;
      min-width: 6.6rem;
      padding: 0.55rem 0.4rem;
    }

    .site-navigation__toggle {
      width: 3.6rem;
      padding: 0.65rem 0.85rem;
    }

    .site-navigation__toggle span {
      width: 1.5rem;
    }

    .section-menu__panel {
      width: min(100% - 1.25rem, 88rem);
    }

    .section-menu__heading {
      min-height: 2.9rem;
      padding-left: 0.95rem;
    }

    .section-menu__link {
      min-height: 3.75rem;
      padding: 0.72rem 0.95rem;
      font-size: clamp(1.18rem, 6.2vw, 1.6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-navigation__home,
    .site-navigation__toggle {
      transition: none;
    }
  }
</style>
