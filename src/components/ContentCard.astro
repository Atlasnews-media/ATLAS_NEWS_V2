---
interface EditorialVisual {
  src: string;
  alt: string;
  source: string;
  sourceUrl: string;
  author: string;
  license: string;
}

interface Props {
  href: string;
  eyebrow: string;
  title: string;
  summary: string;
  date: string;
  demo?: boolean;
  compact?: boolean;
  visual?: EditorialVisual;
  visualAlways?: boolean;
}

const {
  href,
  eyebrow,
  title,
  summary,
  date,
  demo = false,
  compact = false,
  visual,
  visualAlways = false,
} = Astro.props;

const visualAllowed = (() => {
  if (!visual) return false;
  if (visual.src.startsWith("/images/editorial/")) return true;
  try {
    const hostname = new URL(visual.src).hostname;
    return ["upload.wikimedia.org", "commons.wikimedia.org"].includes(hostname);
  } catch {
    return false;
  }
})();
---

<article
  class:list={[
    "card",
    {
      compact,
      "has-visual": visualAllowed,
      "visual-always": visualAllowed && visualAlways,
    },
  ]}
>
  <div class="card-copy">
    <div class="meta">
      <span>{eyebrow}</span>
      {demo && <span class="demo">Demostración</span>}
    </div>
    <h2><a href={href}>{title}</a></h2>
    <p>{summary}</p>
    <div class="card-footer">
      <time>{date}</time>
      <a class="read" href={href} aria-label={`Leer ${title}`}
        >Continuar leyendo <span aria-hidden="true">→</span></a
      >
    </div>
  </div>

  {
    visualAllowed && visual && (
      <figure class="card-visual" aria-hidden="true">
        <img
          src={visual.src}
          alt=""
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
        <figcaption>
          {visual.source} · {visual.author}
        </figcaption>
      </figure>
    )
  }
</article>

<style>
  .card {
    position: relative;
    padding: 1.25rem 0 1.5rem;
    border-top: 2px solid var(--rule);
    overflow: hidden;
    isolation: isolate;
  }
  .card-copy {
    position: relative;
    z-index: 2;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--accent);
    font: 800 0.67rem/1.2 var(--sans);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .demo {
    padding: 0.14rem 0.35rem;
    color: var(--paper);
    background: var(--ink);
  }
  h2 {
    max-width: 42rem;
    margin: 0.65rem 0;
    font-size: clamp(1.7rem, 3.7vw, 2.8rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }
  a {
    color: inherit;
    text-decoration-thickness: 0.055em;
    text-underline-offset: 0.12em;
  }
  h2 a {
    text-decoration: none;
  }
  h2 a:hover {
    text-decoration: underline;
  }
  p {
    max-width: 46rem;
    margin: 0.7rem 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.48;
  }
  .card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 1.15rem;
    margin-top: 0.95rem;
  }
  time {
    font: 0.72rem/1.2 var(--sans);
    text-transform: uppercase;
  }
  .read {
    display: inline-block;
    color: var(--accent);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .card-visual {
    position: absolute;
    z-index: 1;
    top: 0.8rem;
    right: -0.4rem;
    bottom: 0.8rem;
    display: none;
    width: 36%;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }
  .card-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.68;
    filter: saturate(0.7) sepia(0.1) contrast(0.92) brightness(1.06);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.34) 24%,
      #000 60%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.34) 24%,
      #000 60%
    );
  }
  figcaption {
    position: absolute;
    right: 0.38rem;
    bottom: 0.2rem;
    max-width: 82%;
    color: var(--ink-soft);
    font: 600 0.44rem/1.1 var(--sans);
    text-align: right;
    opacity: 0.68;
  }
  .visual-always .card-visual {
    display: block;
  }
  .visual-always.has-visual .card-copy {
    width: 72%;
  }
  .visual-always.has-visual h2,
  .visual-always.has-visual p {
    max-width: none;
  }
  .compact h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
  }
  .compact p {
    font-size: 0.94rem;
  }

  @media (max-width: 42rem) {
    .card {
      min-height: 12rem;
      padding: 0.95rem 0 1rem;
    }
    .card.has-visual .card-copy,
    .card.visual-always.has-visual .card-copy {
      width: 86%;
    }
    .card.has-visual h2,
    .card.has-visual p {
      max-width: none;
    }
    h2 {
      margin: 0.48rem 0 0.52rem;
      font-size: clamp(1.58rem, 7vw, 2.12rem);
      line-height: 0.97;
    }
    p {
      margin: 0.52rem 0;
      font-size: 0.96rem;
      line-height: 1.42;
    }
    .card-footer {
      gap: 0.45rem 1.25rem;
      margin-top: 0.9rem;
    }
    .read {
      margin-left: 0;
    }
    .card-visual,
    .visual-always .card-visual {
      top: 0.7rem;
      bottom: 0.7rem;
      display: block;
      width: 42%;
    }
    .card-visual img {
      opacity: 0.72;
    }
    figcaption {
      font-size: 0.4rem;
    }
  }
</style>
