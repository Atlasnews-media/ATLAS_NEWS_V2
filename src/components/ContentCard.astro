---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  summary: string;
  date: string;
  demo?: boolean;
  compact?: boolean;
}

const {
  href,
  eyebrow,
  title,
  summary,
  date,
  demo = false,
  compact = false,
} = Astro.props;
---

<article class:list={["card", { compact }]}>
  <div class="meta">
    <span>{eyebrow}</span>
    {demo && <span class="demo">Demostración</span>}
  </div>
  <h2><a href={href}>{title}</a></h2>
  <p>{summary}</p>
  <time>{date}</time>
  <a class="read" href={href} aria-label={`Leer ${title}`}
    >Continuar leyendo <span aria-hidden="true">→</span></a
  >
</article>

<style>
  .card {
    position: relative;
    padding: 1.25rem 0 1.5rem;
    border-top: 2px solid var(--rule);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--accent);
    font: 800 0.67rem/1.2 var(--sans);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .demo {
    padding: 0.14rem 0.35rem;
    color: var(--paper);
    background: var(--ink);
  }
  h2 {
    max-width: 42rem;
    margin: 0.65rem 0;
    font-size: clamp(1.7rem, 3.7vw, 2.8rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }
  a {
    color: inherit;
    text-decoration-thickness: 0.055em;
    text-underline-offset: 0.12em;
  }
  h2 a {
    text-decoration: none;
  }
  h2 a:hover {
    text-decoration: underline;
  }
  p {
    max-width: 46rem;
    margin: 0.7rem 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.48;
  }
  time {
    font: 0.72rem/1.2 var(--sans);
    text-transform: uppercase;
  }
  .read {
    display: inline-block;
    margin-top: 1rem;
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .compact h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
  }
  .compact p {
    font-size: 0.94rem;
  }
</style>
