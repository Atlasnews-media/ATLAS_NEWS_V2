---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "ATLAS NEWS — Inteligencia financiera con criterio editorial.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: Georgia, "Times New Roman", serif;
    background: #efeee8;
    color: #171713;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }
</style>
