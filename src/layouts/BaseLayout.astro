---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "ATLAS NEWS — Inteligencia financiera con criterio editorial.",
} = Astro.props;

const currentDate = new Intl.DateTimeFormat("es-CL", {
  dateStyle: "full",
  timeZone: "America/Santiago",
}).format(new Date());
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f2efe5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="edition-bar">
        <span>Vol. I · N° 001</span>
        <time>{currentDate}</time>
        <span>Santiago de Chile</span>
      </div>
      <a class="brand" href="/" aria-label="ATLAS NEWS, portada">ATLAS NEWS</a>
      <p class="motto">
        Inteligencia financiera · contexto · criterio editorial
      </p>
      <nav aria-label="Navegación principal">
        <a href="/">Portada</a>
        <a href="/ediciones/">Ediciones</a>
        <a href="/lecturas/">Lecturas</a>
        <a href="/archivo/">Archivo</a>
      </nav>
    </header>
    <div id="contenido"><slot /></div>
    <footer class="site-footer">
      <a class="footer-brand" href="/">ATLAS NEWS</a>
      <p>
        Información y análisis editorial. No constituye una recomendación de
        inversión.
      </p>
      <p>Publicado desde Santiago de Chile · Archivo trazable y versionado</p>
    </footer>
  </body>
</html>

<style is:global>
  .site-header,
  .site-footer {
    position: relative;
    z-index: 1;
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .site-header {
    padding-top: 1rem;
  }
  .brand {
    display: block;
    margin: 0.55rem 0 0;
    color: inherit;
    font: 700 clamp(3.8rem, 11vw, 9.5rem)/0.82 var(--display);
    letter-spacing: -0.04em;
    text-align: center;
    text-decoration: none;
  }
  .edition-bar,
  .site-header nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .edition-bar {
    padding: 0.5rem 0;
    border-top: 3px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .motto {
    margin: 0.75rem 0 0.65rem;
    font: 700 clamp(0.7rem, 1.5vw, 0.9rem)/1.2 var(--sans);
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
  }
  .site-header nav {
    justify-content: center;
    padding: 0.7rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
  }
  .site-header nav a {
    color: inherit;
    text-decoration: none;
  }
  .site-header nav a + a::before {
    margin-right: 1.25rem;
    content: "◆";
    font-size: 0.42rem;
    vertical-align: middle;
  }
  .site-footer {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 1rem;
    margin-top: 5rem;
    padding: 1.5rem 0 3rem;
    border-top: 4px double var(--rule);
    font: 0.72rem/1.5 var(--sans);
    text-transform: uppercase;
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer p:last-child {
    text-align: right;
  }
  .footer-brand {
    font: 700 1.15rem/1 var(--serif);
    text-decoration: none;
  }

  @media (max-width: 36rem) {
    .site-header,
    .site-footer {
      width: min(100% - 1.25rem, 88rem);
    }
    .edition-bar span:last-child {
      display: none;
    }
    .brand {
      font-size: clamp(3.4rem, 19vw, 5rem);
    }
    .site-header nav {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.25rem;
      font-size: 0.58rem;
      text-align: center;
    }
    .site-header nav a {
      min-width: 0;
    }
    .site-header nav a + a::before {
      margin-right: 0.35rem;
      font-size: 0.3rem;
    }
    .site-footer {
      grid-template-columns: 1fr;
    }
    .site-footer p:last-child {
      text-align: left;
    }
  }
</style>
