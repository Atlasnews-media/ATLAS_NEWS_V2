---
import "../styles/global.css";
import {
  dailyIssueNumber,
  formatIssueNumber,
  getPublishedDailies,
  getPublishedEditions,
} from "../lib/content";

declare const process: {
  env: Record<string, string | undefined>;
};

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "ATLAS NEWS — Inteligencia financiera, contexto y criterio editorial.",
} = Astro.props;

const editions = await getPublishedEditions();
const currentDaily = getPublishedDailies(editions)[0];
const currentIssueNumber = currentDaily
  ? dailyIssueNumber(currentDaily, editions)
  : undefined;
const headerDateCandidate = currentDaily?.data.publishedAt ?? new Date();
const headerDate = Number.isFinite(headerDateCandidate.valueOf())
  ? headerDateCandidate
  : new Date();
const currentDate = new Intl.DateTimeFormat("es-CL", {
  dateStyle: "full",
  timeZone: "America/Santiago",
}).format(headerDate);
const issueLabel = currentIssueNumber
  ? `Vol. I · ${formatIssueNumber(currentIssueNumber)}`
  : "Vol. I · Edición en preparación";
const sourceCommit = (
  process.env.ATLAS_SOURCE_SHA ??
  process.env.GITHUB_SHA ??
  "local"
).slice(0, 7);

const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const socialImageUrl = new URL("/brand/atlas-icon.png", siteOrigin).href;
const isArticle = /^\/(ediciones|nacional|mercados|lecturas)\/[^/]+\/?$/.test(
  Astro.url.pathname,
);
const socialType = isArticle ? "article" : "website";

const primaryEntry = { href: "/", label: "Portada" };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f2efe5" />
    <meta name="atlas-source-commit" content={sourceCommit} />
    <meta property="og:site_name" content="ATLAS NEWS" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:type" content={socialType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1172" />
    <meta property="og:image:height" content="1172" />
    <meta property="og:image:alt" content="ATLAS NEWS" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/brand/favicon-16x16.png"
    />
    <link rel="apple-touch-icon" href="/brand/atlas-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="edition-bar">
        <span>{issueLabel}</span>
        <time>{currentDate}</time>
        <span>Santiago de Chile</span>
      </div>
      <div class="brand-lockup">
        <img
          class="brand-mark"
          src="/brand/atlas-icon.png"
          alt=""
          width="1172"
          height="1172"
        />
        <a class="brand" href="/" aria-label="ATLAS NEWS, portada">ATLAS NEWS</a
        >
      </div>
      <nav aria-label="Navegación principal">
        <a href={primaryEntry.href}>{primaryEntry.label}</a>
        <a href="/nacional/">Nacional</a>
        <a href="/mercados/">Mercados</a>
        <a href="/lecturas/">Lecturas</a>
        <a href="/archivo/">Archivo</a>
      </nav>
    </header>
    <div id="contenido"><slot /></div>
    <footer class="site-footer">
      <div class="footer-meta">
        <a class="footer-brand" href="/">ATLAS NEWS</a>
        <p>
          Información y análisis editorial. No constituye una recomendación de
          inversión.
        </p>
        <p>
          <a href="/estado/">Estado de publicación</a><br />Santiago de Chile ·
          código {sourceCommit}
        </p>
      </div>

      <div class="footer-hub" aria-label="ATLAS Learning Hub">
        <img
          class="footer-hub-mark"
          src="/brand/atlas-icon.png"
          alt=""
          width="1172"
          height="1172"
        />
        <div class="footer-hub-copy">
          <a
            class="footer-hub-title"
            href="https://atlas-learning-hub-web.vercel.app"
            target="_blank"
            rel="noreferrer"
          >
            ATLAS Learning Hub
          </a>
          <p>
            ATLAS NEWS es parte de ATLAS Learning Hub, ecosistema público de
            conocimiento y productos digitales de ATLAS Group Hub. Reúne ATLAS
            News, ATLAS Games, ATLAS Learning y ATLAS Tools bajo una
            arquitectura común orientada a convertir conocimiento, tecnología y
            experimentación en contenidos, experiencias y herramientas de valor
            práctico.
          </p>
          <a
            class="footer-hub-link"
            href="https://atlas-learning-hub-web.vercel.app"
            target="_blank"
            rel="noreferrer"
          >
            Conoce el ecosistema →
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .site-header,
  .site-footer {
    position: relative;
    z-index: 1;
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .site-header {
    padding-top: 1rem;
  }
  .brand-lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.65rem, 1.5vw, 1.25rem);
    margin: 0.45rem 0 0.8rem;
  }
  .brand-mark {
    display: block;
    flex: 0 0 auto;
    width: clamp(2.8rem, 4.5vw, 4.75rem);
    height: auto;
  }
  .brand {
    display: block;
    min-width: 0;
    color: inherit;
    font: 700 clamp(3.8rem, 11vw, 9.5rem)/0.82 var(--display);
    letter-spacing: -0.04em;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }
  .edition-bar,
  .site-header nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .edition-bar {
    padding: 0.5rem 0;
    border-top: 3px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .site-header nav {
    justify-content: center;
    padding: 0.7rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
  }
  .site-header nav a {
    color: inherit;
    text-decoration: none;
  }
  .site-header nav a + a::before {
    margin-right: 1.25rem;
    content: "◆";
    font-size: 0.42rem;
    vertical-align: middle;
  }
  .site-footer {
    margin-top: 5rem;
    padding: 1.5rem 0 3rem;
    border-top: 4px double var(--rule);
    font: 0.72rem/1.5 var(--sans);
    text-transform: uppercase;
  }
  .footer-meta {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 1rem;
  }
  .site-footer p {
    margin: 0;
  }
  .footer-meta > p:last-child {
    text-align: right;
  }
  .footer-meta > p:last-child a {
    font-weight: 800;
    text-underline-offset: 0.15em;
  }
  .footer-brand {
    font: 700 1.15rem/1 var(--serif);
    text-decoration: none;
  }
  .footer-hub {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    text-transform: none;
  }
  .footer-hub-mark {
    display: block;
    width: clamp(2.5rem, 4vw, 4rem);
    height: auto;
  }
  .footer-hub-copy {
    max-width: 56rem;
  }
  .footer-hub-title {
    display: inline-block;
    color: inherit;
    font: 700 1.15rem/1.15 var(--serif);
    text-decoration: none;
  }
  .footer-hub-copy p {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font: 0.82rem/1.55 var(--serif);
  }
  .footer-hub-link {
    display: inline-block;
    margin-top: 0.65rem;
    color: inherit;
    font: 800 0.7rem/1.2 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 36rem) {
    .site-header,
    .site-footer {
      width: min(100% - 1.25rem, 88rem);
    }
    .edition-bar span:last-child {
      display: none;
    }
    .brand-lockup {
      gap: clamp(0.4rem, 2vw, 0.65rem);
      margin-top: 0.35rem;
      width: 100%;
    }
    .brand-mark {
      width: clamp(3.25rem, 13.5vw, 3.45rem);
    }
    .brand {
      flex: 0 1 auto;
      max-width: 100%;
      font-size: clamp(2.25rem, 12vw, 4.15rem);
    }
    .site-header nav {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.2rem;
      font-size: 0.52rem;
      text-align: center;
    }
    .site-header nav a {
      min-width: 0;
    }
    .site-header nav a + a::before {
      margin-right: 0.25rem;
      font-size: 0.26rem;
    }
    .footer-meta {
      grid-template-columns: 1fr;
    }
    .footer-meta > p:last-child {
      text-align: left;
    }
    .footer-hub {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.75rem;
    }
    .footer-hub-mark {
      width: 2.5rem;
    }
  }
</style>
