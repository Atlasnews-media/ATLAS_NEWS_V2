---
import ArticleHeader from "../../../../components/ArticleHeader.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  resolveFrontPageVisual,
  type EditorialVisual,
  type FrontPageSection,
} from "../../../../lib/front-page-visuals";

type SignalSection = "internacional" | "nacional" | "mercados";

interface CanonicalSignal {
  slot: string;
  headline: string;
  deck: string;
  development: string;
  anchor: string;
  sources: Array<{
    name: string;
    url: string;
  }>;
}

interface SignalsArtifact {
  status: "READY";
  date: string;
  contract: "atlas-senales-del-dia-v1";
  senalesDelDia: Record<SignalSection, CanonicalSignal[]>;
}

interface Props {
  date: string;
  section: SignalSection;
  signal: CanonicalSignal;
  visual: EditorialVisual;
}

const SIGNAL_SECTIONS: SignalSection[] = [
  "internacional",
  "nacional",
  "mercados",
];

const sectionConfig: Record<
  SignalSection,
  {
    label: string;
    href: string;
    visualSection: FrontPageSection;
  }
> = {
  internacional: {
    label: "Internacional",
    href: "/internacional/",
    visualSection: "international",
  },
  nacional: {
    label: "Nacional",
    href: "/nacional/",
    visualSection: "national",
  },
  mercados: {
    label: "Mercados",
    href: "/mercados/",
    visualSection: "markets",
  },
};

const signalFiles = import.meta.glob(
  "../../../../../data/senales-del-dia/*.json",
  {
    eager: true,
    query: "?raw",
    import: "default",
  },
) as Record<string, string>;

function parseSignalsArtifact(raw: string | undefined): unknown {
  if (!raw) return undefined;

  try {
    return JSON.parse(raw);
  } catch {
    return undefined;
  }
}

function isCanonicalSignal(value: unknown): value is CanonicalSignal {
  if (!value || typeof value !== "object") return false;

  const signal = value as CanonicalSignal;

  return (
    typeof signal.slot === "string" &&
    typeof signal.headline === "string" &&
    signal.headline.trim().length > 0 &&
    signal.headline.length <= 72 &&
    typeof signal.deck === "string" &&
    signal.deck.trim().length > 0 &&
    signal.deck.length <= 180 &&
    typeof signal.development === "string" &&
    signal.development.trim().length > 0 &&
    typeof signal.anchor === "string" &&
    signal.anchor.trim().length > 0 &&
    Array.isArray(signal.sources)
  );
}

function isReadySignalsArtifact(value: unknown): value is SignalsArtifact {
  if (!value || typeof value !== "object") return false;

  const artifact = value as SignalsArtifact;
  const internacional = artifact.senalesDelDia?.internacional;
  const nacional = artifact.senalesDelDia?.nacional;
  const mercados = artifact.senalesDelDia?.mercados;

  if (
    artifact.status !== "READY" ||
    artifact.contract !== "atlas-senales-del-dia-v1" ||
    typeof artifact.date !== "string" ||
    !Array.isArray(internacional) ||
    !Array.isArray(nacional) ||
    !Array.isArray(mercados) ||
    internacional.length !== 2 ||
    nacional.length !== 2 ||
    mercados.length !== 2
  ) {
    return false;
  }

  return [...internacional, ...nacional, ...mercados].every(isCanonicalSignal);
}

function resolveSignalVisuals(artifact: SignalsArtifact) {
  const usedSources = new Set<string>();
  const visuals = new Map<string, EditorialVisual>();

  for (const section of SIGNAL_SECTIONS) {
    const config = sectionConfig[section];

    for (const signal of artifact.senalesDelDia[section]) {
      const visual = resolveFrontPageVisual({
        section: config.visualSection,
        id: `${artifact.date}:${signal.slot}:${signal.anchor}`,
        title: `${signal.headline} ${signal.deck}`,
        slot: signal.slot,
        usedSources,
      });

      usedSources.add(visual.src);
      visuals.set(`${section}:${signal.anchor}`, visual);
    }
  }

  return visuals;
}

export function getStaticPaths() {
  const paths = [];

  for (const raw of Object.values(signalFiles)) {
    const parsed = parseSignalsArtifact(raw);
    if (!isReadySignalsArtifact(parsed)) continue;

    const visuals = resolveSignalVisuals(parsed);

    for (const section of SIGNAL_SECTIONS) {
      for (const signal of parsed.senalesDelDia[section]) {
        const visual = visuals.get(`${section}:${signal.anchor}`);
        if (!visual) continue;

        paths.push({
          params: {
            date: parsed.date,
            section,
            anchor: signal.anchor,
          },
          props: {
            date: parsed.date,
            section,
            signal,
            visual,
          },
        });
      }
    }
  }

  return paths;
}

const { date, section, signal, visual } = Astro.props;
const currentSection = sectionConfig[section];
const canonicalPath = `/senales/${date}/${section}/${signal.anchor}/`;
---

<BaseLayout
  title={`${signal.headline} — ATLAS NEWS`}
  description={signal.deck}
>
  <main class="signal-page">
    <nav
      class="signal-page__nav"
      aria-label={`Navegación desde ${signal.headline}`}
    >
      <a class="signal-page__back" href="/#senales-del-dia">
        ← Volver a Señales del Día
      </a>
      <a class="signal-page__secondary" href="/">Ir a Portada</a>
      <a class="signal-page__secondary" href={currentSection.href}>
        Ir a {currentSection.label}
      </a>
    </nav>

    <ArticleHeader
      eyebrow={`Señales del día · ${currentSection.label}`}
      title={signal.headline}
      summary={signal.deck}
      date={date}
      tags={[section, signal.slot]}
      visual={visual}
    />

    <article class="signal-page__body">{signal.development}</article>

    {
      signal.sources.length > 0 && (
        <section
          class="signal-page__sources"
          aria-labelledby="signal-sources-title"
        >
          <h2 id="signal-sources-title">Fuentes</h2>
          <ul>
            {signal.sources.map((source) => (
              <li>
                <a href={source.url}>{source.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .signal-page {
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .signal-page__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(52rem, 100%);
    margin: 2.5rem auto;
    border: 1px solid var(--rule);
    border-top: 4px double var(--rule);
    border-bottom: 4px double var(--rule);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .signal-page__nav a {
    display: flex;
    align-items: center;
    min-height: 2.8rem;
    padding: 0.68rem 0.85rem;
    color: var(--ink);
    text-decoration: none;
  }
  .signal-page__back {
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--rule);
    color: var(--accent) !important;
  }
  .signal-page__back::after {
    margin-left: auto;
    color: var(--accent);
    content: "◆";
    font-size: 0.62rem;
  }
  .signal-page__secondary + .signal-page__secondary {
    border-left: 1px solid var(--rule);
  }
  .signal-page__nav a:hover,
  .signal-page__nav a:focus-visible {
    color: var(--paper) !important;
    background: var(--ink);
    outline: none;
  }
  .signal-page__back:hover::after,
  .signal-page__back:focus-visible::after {
    color: var(--paper);
  }
  .signal-page__body,
  .signal-page__sources {
    max-width: 52rem;
    margin-right: auto;
    margin-left: auto;
  }
  .signal-page__body {
    margin-top: 2rem;
    color: var(--ink);
    font-size: 1.08rem;
    line-height: 1.68;
    white-space: pre-line;
  }
  .signal-page__sources {
    margin-top: 1.5rem;
    margin-bottom: 4rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font: 0.78rem/1.45 var(--sans);
  }
  .signal-page__sources h2 {
    margin: 0;
    font: 800 0.78rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .signal-page__sources ul {
    margin: 0.45rem 0 0;
    padding-left: 1.15rem;
  }
  .signal-page__sources li {
    margin: 0.3rem 0;
  }
  @media (max-width: 42rem) {
    .signal-page {
      width: min(100% - 1.25rem, 88rem);
    }
    .signal-page__nav {
      margin: 1.6rem auto 2rem;
    }
    .signal-page__body {
      font-size: 1.03rem;
      line-height: 1.62;
    }
  }
</style>
