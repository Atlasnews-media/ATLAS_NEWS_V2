---
import "../../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#f2efe5" />
    <title>ATLAS NEWS LAB</title>
  </head>
  <body>
    <main class="lab-shell">
      <p class="lab-kicker">ATLAS NEWS · LAB</p>
      <h1>Zona experimental</h1>
      <p class="lab-copy">
        Espacio de prueba para cambios editoriales, visuales, sonoros y
        funcionales antes de incorporarlos a ATLAS NEWS.
      </p>
      <div class="lab-rule" aria-hidden="true"></div>
      <p class="lab-status">Sin experimentos activos.</p>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #f2efe5;
    color: #151515;
  }

  .lab-shell {
    width: min(52rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(4rem, 12vw, 8rem) 0;
  }

  .lab-kicker,
  .lab-status {
    margin: 0;
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.75rem 0 1rem;
    font: 700 clamp(3rem, 10vw, 7rem)/0.9 var(--display);
    letter-spacing: -0.04em;
  }

  .lab-copy {
    max-width: 42rem;
    margin: 0;
    font: 1.15rem/1.65 var(--serif);
  }

  .lab-rule {
    margin: 2.5rem 0 1.25rem;
    border-top: 4px double currentColor;
  }
</style>
