---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadChileCalendar } from "../../lib/chile-calendar";

const chileCalendar = await loadChileCalendar();
const nationalEvents = chileCalendar.events;

const todayParts = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Santiago",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).formatToParts(new Date());
const todayMap = Object.fromEntries(todayParts.map((part) => [part.type, part.value]));
const chileTodayKey = `${todayMap.year}-${todayMap.month}-${todayMap.day}`;
const shortMonths = [
  "ENE",
  "FEB",
  "MAR",
  "ABR",
  "MAY",
  "JUN",
  "JUL",
  "AGO",
  "SEP",
  "OCT",
  "NOV",
  "DIC",
];

function nationalWhen(event: (typeof nationalEvents)[number]) {
  if (event.date === chileTodayKey && event.time) return event.time;
  const [, month, day] = event.date.split("-").map(Number);
  return `${String(day).padStart(2, "0")} ${shortMonths[month - 1]}`;
}
---

<BaseLayout
  title="ATLAS NEWS — Calendario económico LAB"
  description="LAB aislado de ATLAS NEWS para probar un calendario económico diario alimentado desde fuentes automáticas y oficiales."
>
  <main class="calendar-lab page-shell">
    <div class="lab-bar">
      <p>LAB · CALENDARIO ECONÓMICO</p>
      <a href="/">Volver a portada</a>
    </div>

    <header class="calendar-heading">
      <p class="page-kicker">Agenda económica automática</p>
      <h1>Calendario del día</h1>
      <p id="calendar-date" class="calendar-date">Cargando fecha…</p>
      <p class="calendar-intro">
        Cinco hitos por bloque cuando existen datos suficientes. Internacional y
        Mercados consultan un calendario público; Nacional se construye desde INE y
        Banco Central de Chile.
      </p>
    </header>

    <div id="api-status" class="api-status" role="status" aria-live="polite">
      Consultando agenda internacional…
    </div>

    <section class="calendar-section" aria-labelledby="international-title">
      <div class="section-heading">
        <h2 id="international-title">Internacional</h2>
        <span>Hoy</span>
      </div>
      <div id="international-list" class="event-list" aria-busy="true"></div>
    </section>

    <section class="calendar-section" aria-labelledby="national-title">
      <div class="section-heading">
        <h2 id="national-title">Nacional</h2>
        <span id="national-range">
          {chileCalendar.todayCount > 0 && !chileCalendar.usesFuture
            ? "Hoy"
            : "Hoy + próximos"}
        </span>
      </div>
      <div id="national-list" class="event-list" aria-busy="false">
        {
          nationalEvents.length > 0 ? (
            nationalEvents.map((event) => (
              <article class="event-row">
                <time datetime={event.date}>{nationalWhen(event)}</time>
                <div class="event-copy">
                  <h3>{event.name}</h3>
                  <p>
                    <a href={event.sourceUrl} target="_blank" rel="noreferrer">
                      {event.sourceName}
                    </a>
                  </p>
                </div>
              </article>
            ))
          ) : (
            <div class="event-empty">
              <strong>—</strong>
              <p>No fue posible recuperar la agenda oficial de Chile en este build.</p>
            </div>
          )
        }
      </div>
    </section>

    <section class="calendar-section" aria-labelledby="markets-title">
      <div class="section-heading">
        <h2 id="markets-title">Mercados</h2>
        <span>Agenda relevante</span>
      </div>
      <div id="markets-list" class="event-list" aria-busy="true"></div>
    </section>

    <footer class="calendar-source">
      <p>
        Fuentes del LAB: <a
          href="https://biquote.io/docs/"
          target="_blank"
          rel="noreferrer">BiQuote</a
        > · <a
          href="https://www.ine.gob.cl/inicio/agendaestadistica"
          target="_blank"
          rel="noreferrer">INE</a
        > · <a
          href="https://www.bcentral.cl/es/calendario-estadistico"
          target="_blank"
          rel="noreferrer">Banco Central de Chile</a
        >.
      </p>
      <p id="updated-at">Última consulta: —</p>
    </footer>
  </main>

  <script>
    const API = "https://biquote.io/api/calendar";
    const TIME_ZONE = "America/Santiago";
    const MAX_ITEMS = 5;
    const MAJOR_COUNTRIES = [
      "US",
      "EU",
      "GB",
      "JP",
      "CN",
      "DE",
      "FR",
      "CA",
      "AU",
      "BR",
      "MX",
      "KR",
      "CH",
    ];

    const countryLabels = {
      US: "EE.UU.",
      EU: "Eurozona",
      GB: "Reino Unido",
      JP: "Japón",
      CN: "China",
      DE: "Alemania",
      FR: "Francia",
      CA: "Canadá",
      AU: "Australia",
      BR: "Brasil",
      MX: "México",
      KR: "Corea del Sur",
      CH: "Suiza",
    };

    const marketSectors = new Set([
      "rates",
      "bonds",
      "energy",
      "money",
      "centralbank",
      "central-bank",
      "commodities",
      "housing",
    ]);

    const $ = (selector) => document.querySelector(selector);

    function localDateKey(date) {
      const parts = new Intl.DateTimeFormat("en-CA", {
        timeZone: TIME_ZONE,
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).formatToParts(date);
      const map = Object.fromEntries(parts.map((part) => [part.type, part.value]));
      return `${map.year}-${map.month}-${map.day}`;
    }

    function addDays(date, days) {
      const copy = new Date(date);
      copy.setUTCDate(copy.getUTCDate() + days);
      return copy;
    }

    function apiDate(date) {
      return date.toISOString();
    }

    function localTime(value, timeMode = "exact") {
      if (timeMode !== "exact") return "—";
      return new Intl.DateTimeFormat("es-CL", {
        timeZone: TIME_ZONE,
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).format(new Date(value));
    }

    function longToday(date) {
      return new Intl.DateTimeFormat("es-CL", {
        timeZone: TIME_ZONE,
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
      }).format(date);
    }

    function score(event) {
      const impact =
        { high: 30, medium: 20, med: 20, low: 10 }[
          String(event.importance || "").toLowerCase()
        ] || 0;
      const exact = event.timeMode === "exact" ? 2 : 0;
      const major = MAJOR_COUNTRIES.includes(event.countryCode) ? 3 : 0;
      return impact + exact + major;
    }

    function choose(events, limit = MAX_ITEMS) {
      return [...events]
        .sort(
          (a, b) =>
            score(b) - score(a) || new Date(a.time) - new Date(b.time),
        )
        .slice(0, limit)
        .sort((a, b) => new Date(a.time) - new Date(b.time));
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function sourceLabel(event) {
      const country =
        countryLabels[event.countryCode] || event.countryCode || "—";
      return event.sourceUrl
        ? `<a href="${escapeHtml(event.sourceUrl)}" target="_blank" rel="noreferrer">${escapeHtml(country)}</a>`
        : escapeHtml(country);
    }

    function eventRow(event) {
      const when = localTime(event.time, event.timeMode);
      return `
        <article class="event-row">
          <time datetime="${escapeHtml(event.time)}">${escapeHtml(when)}</time>
          <div class="event-copy">
            <h3>${escapeHtml(event.name)}</h3>
            <p>${sourceLabel(event)}</p>
          </div>
        </article>`;
    }

    function emptyRow(message) {
      return `
        <div class="event-empty">
          <strong>—</strong>
          <p>${escapeHtml(message)}</p>
        </div>`;
    }

    function render(target, events, options = {}) {
      target.innerHTML = events.length
        ? events.map((event) => eventRow(event)).join("")
        : emptyRow(
            options.empty ||
              "Sin eventos disponibles en la fuente para este bloque.",
          );
      target.setAttribute("aria-busy", "false");
    }

    async function fetchCalendar(params) {
      const url = new URL(API);
      Object.entries(params).forEach(([key, value]) => {
        if (value !== undefined && value !== null && value !== "") {
          url.searchParams.set(key, String(value));
        }
      });
      const response = await fetch(url, {
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error(`API ${response.status}`);
      const data = await response.json();
      if (!Array.isArray(data)) throw new Error("Respuesta API inesperada");
      return data;
    }

    async function loadCalendar() {
      const now = new Date();
      const todayKey = localDateKey(now);
      $("#calendar-date").textContent = longToday(now);

      const from = addDays(now, -1);
      const tomorrow = addDays(now, 2);

      try {
        const [internationalRaw, marketRaw] = await Promise.all([
          fetchCalendar({
            from: apiDate(from),
            to: apiDate(tomorrow),
            countries: MAJOR_COUNTRIES.join(","),
            importance: "medium",
            limit: 500,
          }),
          fetchCalendar({
            from: apiDate(from),
            to: apiDate(tomorrow),
            countries: "US,EU,GB,JP,CN,CA,AU",
            importance: "high",
            limit: 300,
          }),
        ]);

        const internationalToday = internationalRaw.filter(
          (event) => localDateKey(new Date(event.time)) === todayKey,
        );
        const international = choose(internationalToday);

        const internationalIds = new Set(
          international.map((event) => event.id),
        );
        const marketCandidatesToday = marketRaw.filter((event) => {
          const isToday = localDateKey(new Date(event.time)) === todayKey;
          const sector = String(event.sector || "").toLowerCase();
          const marketSpecific =
            event.type === "event" ||
            event.type === "holiday" ||
            marketSectors.has(sector);
          return isToday && !internationalIds.has(event.id) && marketSpecific;
        });

        let markets = choose(marketCandidatesToday);
        if (markets.length < MAX_ITEMS) {
          const used = new Set([
            ...internationalIds,
            ...markets.map((event) => event.id),
          ]);
          const fallback = marketRaw.filter(
            (event) =>
              localDateKey(new Date(event.time)) === todayKey &&
              !used.has(event.id),
          );
          markets = [
            ...markets,
            ...choose(fallback, MAX_ITEMS - markets.length),
          ].slice(0, MAX_ITEMS);
        }

        render($("#international-list"), international, {
          empty:
            "Sin publicaciones internacionales relevantes recuperadas para hoy.",
        });
        render($("#markets-list"), markets, {
          empty: "Sin hitos de mercado recuperados para hoy.",
        });

        $("#api-status").innerHTML =
          '<span class="status-dot" aria-hidden="true"></span> Internacional en vivo · Chile desde fuentes oficiales';
        $("#updated-at").textContent = `Última consulta: ${new Intl.DateTimeFormat(
          "es-CL",
          {
            timeZone: TIME_ZONE,
            dateStyle: "medium",
            timeStyle: "short",
          },
        ).format(new Date())}`;
      } catch (error) {
        console.error(error);
        const message = "No fue posible consultar la API en este momento.";
        render($("#international-list"), [], { empty: message });
        render($("#markets-list"), [], { empty: message });
        $("#api-status").textContent =
          "Fuente internacional temporalmente no disponible · Chile conserva sus fuentes oficiales";
      }
    }

    loadCalendar();
  </script>
</BaseLayout>

<style>
  .calendar-lab {
    padding-top: 1rem;
  }

  .lab-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lab-bar p {
    margin: 0;
  }

  .lab-bar a {
    text-underline-offset: 0.18em;
  }

  .calendar-heading {
    padding: clamp(2rem, 4vw, 3.75rem) 0 2rem;
    border-bottom: 3px double var(--rule);
  }

  .calendar-heading h1 {
    margin: 0.35rem 0 0;
    font-size: clamp(3.2rem, 9vw, 8rem);
    line-height: 0.87;
    letter-spacing: -0.06em;
  }

  .calendar-date {
    margin: 1rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    text-transform: capitalize;
  }

  .calendar-intro {
    max-width: 50rem;
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .api-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.65rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    font: 700 0.68rem/1.2 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .calendar-section {
    margin-top: 2rem;
    border-bottom: 3px double var(--rule);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--rule);
  }

  .section-heading h2 {
    margin: 0;
    color: var(--accent);
    font: 800 clamp(1.15rem, 2.8vw, 1.55rem)/1 var(--sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .section-heading span {
    color: var(--ink-soft);
    font: 700 0.65rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-list {
    min-height: 5rem;
  }

  .event-row {
    display: grid;
    grid-template-columns: minmax(5.5rem, 0.7fr) minmax(0, 5fr);
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(35 35 29 / 55%);
  }

  .event-row:last-child {
    border-bottom: 0;
  }

  .event-row > time {
    font: 700 clamp(1.15rem, 2.5vw, 1.55rem)/1 var(--serif);
    font-variant-numeric: tabular-nums;
  }

  .event-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(7rem, 0.35fr);
    gap: 1rem;
    align-items: baseline;
  }

  .event-copy h3 {
    margin: 0;
    font: 700 clamp(1.05rem, 2.3vw, 1.45rem)/1.12 var(--serif);
  }

  .event-copy p {
    margin: 0;
    color: var(--ink-soft);
    font: 0.8rem/1.25 var(--serif);
  }

  .event-copy a {
    text-underline-offset: 0.16em;
  }

  .event-empty {
    display: grid;
    grid-template-columns: minmax(5.5rem, 0.7fr) minmax(0, 5fr);
    gap: 1rem;
    align-items: center;
    min-height: 5rem;
    padding: 1rem 0;
  }

  .event-empty strong {
    font-size: 1.4rem;
  }

  .event-empty p {
    margin: 0;
    color: var(--ink-soft);
    font-style: italic;
  }

  .calendar-source {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1rem;
    color: var(--ink-soft);
    font: 0.65rem/1.4 var(--sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .calendar-source p {
    margin: 0;
  }

  @media (max-width: 42rem) {
    .calendar-lab {
      padding-top: 0.7rem;
    }

    .calendar-heading {
      padding-top: 1.6rem;
    }

    .calendar-heading h1 {
      font-size: clamp(3rem, 15vw, 5rem);
    }

    .calendar-intro {
      font-size: 0.88rem;
    }

    .section-heading {
      align-items: baseline;
    }

    .event-row,
    .event-empty {
      grid-template-columns: 4.6rem minmax(0, 1fr);
      gap: 0.65rem;
      padding: 0.75rem 0;
    }

    .event-row > time {
      font-size: 1rem;
    }

    .event-copy {
      display: block;
    }

    .event-copy h3 {
      font-size: 1.08rem;
      line-height: 1.08;
    }

    .event-copy p {
      margin-top: 0.25rem;
      font-size: 0.72rem;
    }

    .calendar-source {
      display: block;
    }

    .calendar-source p + p {
      margin-top: 0.5rem;
    }
  }
</style>
