---
import ContentCard from "../../components/ContentCard.astro";
import DailyAudio from "../../components/DailyAudio.astro";
import EconomicIndicators from "../../components/EconomicIndicators.astro";
import EditorialDoubleRule from "../../components/EditorialDoubleRule.astro";
import FrontPageHeadline from "../../components/FrontPageHeadline.astro";
import MarketPulse from "../../components/MarketPulse.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  dailyIssueNumber,
  formatEditorialDate,
  formatIssueNumber,
  getLatestDaily,
  getLatestMarkets,
  getLatestNational,
  getPublishedEditions,
  getPublishedReadings,
} from "../../lib/content";

const [latestDaily, editions, latestNational, latestMarkets, readings] =
  await Promise.all([
    getLatestDaily(),
    getPublishedEditions(),
    getLatestNational(),
    getLatestMarkets(),
    getPublishedReadings(),
  ]);
const currentIssueNumber = latestDaily
  ? dailyIssueNumber(latestDaily, editions)
  : undefined;
const latestReading = readings[0];
const latestWeekly = editions.find(({ data }) => data.type === "weekly");
const hasAnalysisContent = Boolean(latestNational || latestMarkets);

const dailyVisual = {
  src: "https://commons.wikimedia.org/wiki/Special:FilePath/Eccles_Building_%2826088200676%29.jpg?width=1280",
  alt: "Entrada principal del edificio Marriner S. Eccles de la Reserva Federal en Washington, D.C.",
  source: "Wikimedia Commons / Federal Reserve",
  sourceUrl:
    "https://commons.wikimedia.org/wiki/File:Eccles_Building_(26088200676).jpg",
  author: "Federalreserve",
  license: "Dominio público",
};

const nationalVisual = {
  src: "https://commons.wikimedia.org/wiki/Special:FilePath/CL-san-antonio-hafen.jpg?width=1280",
  alt: "Vista del puerto de San Antonio en Chile, con infraestructura portuaria y movimiento de carga.",
  source: "Wikimedia Commons",
  sourceUrl: "https://commons.wikimedia.org/wiki/File:CL-san-antonio-hafen.jpg",
  author: "Balou46",
  license: "CC BY-SA 4.0",
};

const marketsVisual = {
  src: "https://commons.wikimedia.org/wiki/Special:FilePath/No_Known_Restrictions_Trading_Floor%2C_New_York_Stock_Exchange_%28Highsmith_LOC%29_%286718386525%29.jpg?width=1280",
  alt: "Piso de operaciones de la Bolsa de Nueva York fotografiado por Carol M. Highsmith.",
  source: "Library of Congress / Wikimedia Commons",
  sourceUrl:
    "https://commons.wikimedia.org/wiki/File:No_Known_Restrictions_Trading_Floor,_New_York_Stock_Exchange_(Highsmith_LOC)_(6718386525).jpg",
  author: "Carol M. Highsmith",
  license: "Dominio público",
};
---

<BaseLayout
  title="ATLAS NEWS LAB — Portada móvil V2"
  description="Preview de laboratorio del rediseño visual de la portada móvil de ATLAS NEWS."
>
  <main class="front-page">
    <div class="issue-line">
      <p>Portada</p>
      <p>
        {
          currentIssueNumber
            ? formatIssueNumber(currentIssueNumber)
            : "En preparación"
        }
      </p>
      <p>Edición matutina</p>
    </div>

    <EconomicIndicators />
    <DailyAudio expectedDate={latestDaily?.id.slice(0, 10)} />

    {
      latestDaily ? (
        <>
          <EditorialDoubleRule />
          <section class="lead-grid" aria-labelledby="titulares">
            <article class="lead-story headline-board">
              <h1 id="titulares" class="headline-board-title">
                Titulares
              </h1>

              <div class="headline-list">
                <FrontPageHeadline
                  label="Internacional"
                  title={latestDaily.data.title}
                  href={`/ediciones/${latestDaily.id}/`}
                  cta="Ir a Internacional"
                  visual={dailyVisual}
                  eager
                />

                {latestNational && (
                  <FrontPageHeadline
                    label="Nacional"
                    title={latestNational.data.title}
                    href={`/nacional/${latestNational.id}/`}
                    cta="Ir a Nacional"
                    visual={nationalVisual}
                  />
                )}

                {latestMarkets && (
                  <FrontPageHeadline
                    label="Mercados"
                    title={latestMarkets.data.title}
                    href={`/mercados/${latestMarkets.id}/`}
                    cta="Ir a Mercados"
                    visual={marketsVisual}
                  />
                )}
              </div>

              <div
                class="calendar-entry"
                aria-label="Ir a calendario económico de hoy, próximamente"
              >
                <span
                  class="calendar-link"
                  role="link"
                  aria-disabled="true"
                  tabindex="-1"
                >
                  Ir a calendario económico de hoy
                  <span aria-hidden="true">→</span>
                </span>
              </div>
            </article>

            <EditorialDoubleRule />

            <aside class="edition-rail" aria-label="Claves de la edición">
              <p class="rail-title">En una mirada</p>
              <ol>
                {latestDaily.data.highlights?.map((highlight) => (
                  <li>
                    <strong>{highlight.label}</strong>
                    <span>{highlight.text}</span>
                  </li>
                ))}
              </ol>
            </aside>
          </section>
        </>
      ) : (
        <section class="empty">
          <h1>La próxima edición está en preparación</h1>
        </section>
      )
    }

    {
      hasAnalysisContent && (
        <section class="news-grid" aria-labelledby="analisis">
          <div class="section-rule">
            <h2 id="analisis">Análisis</h2>
          </div>
          <div class="columns">
            {latestNational && (
              <ContentCard
                href={`/nacional/${latestNational.id}/`}
                eyebrow="Nacional · Profundidad"
                title={latestNational.data.title}
                summary={latestNational.data.summary}
                date={formatEditorialDate(latestNational.data.publishedAt)}
                demo={latestNational.data.demo}
                compact
              />
            )}
            {latestMarkets && (
              <ContentCard
                href={`/mercados/${latestMarkets.id}/`}
                eyebrow="Mercados · Profundidad"
                title={latestMarkets.data.title}
                summary={latestMarkets.data.summary}
                date={formatEditorialDate(latestMarkets.data.publishedAt)}
                demo={latestMarkets.data.demo}
                compact
              />
            )}
          </div>
        </section>
      )
    }

    <section class="closing-grid" aria-label="Seguimiento editorial">
      <article>
        {
          latestWeekly ? (
            <>
              <p class="kicker">Panorama semanal</p>
              <h2>
                <a href={`/ediciones/${latestWeekly.id}/`}>
                  {latestWeekly.data.title}
                </a>
              </h2>
              <p class="closing-summary">{latestWeekly.data.summary}</p>
              <a class="closing-link" href={`/ediciones/${latestWeekly.id}/`}>
                Abrir panorama <span aria-hidden="true">→</span>
              </a>
            </>
          ) : (
            <>
              <p class="kicker">Panorama semanal</p>
              <h2>Próxima edición semanal en preparación</h2>
            </>
          )
        }
      </article>
      <article>
        {
          latestDaily?.data.marketSummary ? (
            <MarketPulse
              asOf={latestDaily.data.marketSummary.asOf}
              items={latestDaily.data.marketSummary.items}
            />
          ) : (
            <>
              <p class="kicker">Qué observar</p>
              <h2>Las señales que pueden cambiar la lectura</h2>
              <p class="closing-summary">
                Cada edición separa los hechos, las implicancias y las
                condiciones que podrían invalidar la interpretación inicial.
              </p>
            </>
          )
        }
      </article>
      <article>
        {
          latestReading ? (
            <>
              <p class="kicker">Última contingencia</p>
              <h2>
                <a href={`/lecturas/${latestReading.id}/`}>
                  {latestReading.data.title}
                </a>
              </h2>
              <p class="closing-summary">{latestReading.data.summary}</p>
              <a class="closing-link" href={`/lecturas/${latestReading.id}/`}>
                Abrir contingencia <span aria-hidden="true">→</span>
              </a>
            </>
          ) : (
            <>
              <p class="kicker">Contingencia</p>
              <h2>Próxima contingencia en preparación</h2>
            </>
          )
        }
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .front-page {
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .issue-line {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .issue-line p {
    margin: 0;
  }
  .issue-line p:last-child {
    text-align: right;
  }
  .lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.7fr) minmax(15rem, 1fr);
    gap: 0;
    border-bottom: 5px double var(--rule);
  }
  .lead-story {
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem) 3rem 0;
    border-right: 1px solid var(--rule);
  }
  .kicker,
  .rail-title,
  .headline-board-title {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .headline-list {
    margin-top: 0.8rem;
  }
  .calendar-entry {
    margin-top: 0.2rem;
    padding: 1rem 0 0.2rem;
    border-top: 4px double var(--rule);
  }
  .calendar-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .edition-rail {
    padding: clamp(2rem, 5vw, 4.5rem) 0 3rem clamp(1.25rem, 3vw, 2.25rem);
  }
  .edition-rail ol {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: point;
  }
  .edition-rail li {
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    padding: 1.1rem 0;
    border-top: 1px solid var(--rule);
    counter-increment: point;
  }
  .edition-rail li::before {
    content: "0" counter(point);
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
  }
  .edition-rail strong,
  .edition-rail span {
    grid-column: 2;
  }
  .edition-rail strong {
    margin-bottom: 0.3rem;
    font: 800 0.8rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .edition-rail span {
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .news-grid {
    padding-top: 2.5rem;
  }
  .section-rule {
    padding: 0.65rem 0;
    border-top: 4px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .section-rule h2 {
    margin: 0;
    font: 800 1.2rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
  .columns :global(.card) {
    padding-right: 1.5rem;
  }
  .columns :global(.card + .card) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }
  .closing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3rem;
    border-top: 5px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .closing-grid article {
    padding: 1.5rem;
  }
  .closing-grid article:first-child {
    padding-left: 0;
  }
  .closing-grid article + article {
    border-left: 1px solid var(--rule);
  }
  .closing-grid h2 {
    margin: 0.6rem 0;
    font-size: 1.55rem;
    line-height: 1;
  }
  .closing-grid h2 a {
    text-decoration: none;
  }
  .closing-grid h2 a:hover {
    color: var(--accent);
  }
  .closing-summary {
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .closing-link {
    display: inline-block;
    margin-top: 0.8rem;
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.site-header nav) {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    justify-content: stretch;
    padding: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
  }
  :global(.site-header nav a) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 3.3rem;
    padding: 0.8rem 0.55rem;
    border-left: 1px solid rgba(31, 29, 23, 0.16);
    text-align: center;
    white-space: nowrap;
    transition: background-color 140ms ease;
  }
  :global(.site-header nav a:first-child) {
    border-left: 0;
    background: rgba(31, 29, 23, 0.045);
  }
  :global(.site-header nav a + a::before) {
    content: none;
  }
  :global(.site-header nav a:hover) {
    background: rgba(31, 29, 23, 0.035);
  }

  @media (min-width: 42.01rem) and (max-width: 58rem) {
    .lead-grid {
      grid-template-columns: 1fr;
    }
    .lead-story {
      padding-right: 0;
      border-right: 0;
    }
    .edition-rail {
      padding-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 42rem) {
    .front-page {
      width: min(100% - 1.25rem, 88rem);
    }
    .issue-line {
      display: none;
    }
    :global(.site-header nav) {
      height: auto;
      min-height: 0;
      align-items: stretch;
      gap: 0;
      font-size: 0.49rem;
      line-height: 1;
    }
    :global(.site-header nav a) {
      box-sizing: border-box;
      height: auto;
      min-height: 1.9rem;
      padding: 0.32rem 0.05rem;
      align-self: stretch;
    }
    :global(.editorial-double-rule) + .lead-grid {
      margin-top: 16px;
    }
    .lead-grid {
      grid-template-columns: 1fr;
    }
    .lead-grid > :global(.editorial-double-rule) {
      grid-column: 1 / -1;
    }
    .lead-story {
      padding-top: 0;
      padding-right: 0;
      border-right: 0;
    }
    .headline-board-title {
      margin-top: 0;
      margin-bottom: 0;
    }
    .headline-list {
      margin-top: 0.75rem;
    }
    .calendar-entry {
      margin-top: 0;
      padding: 1.1rem 0 0.45rem;
    }
    .calendar-link {
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
      font-size: clamp(0.95rem, 3.9vw, 1.08rem);
      line-height: 1.15;
      letter-spacing: 0.06em;
    }
    .edition-rail {
      padding-left: 0;
      border-top: 0;
    }
    .columns,
    .closing-grid {
      grid-template-columns: 1fr;
    }
    .columns :global(.card),
    .columns :global(.card + .card),
    .closing-grid article,
    .closing-grid article:first-child {
      padding-right: 0;
      padding-left: 0;
      border-left: 0;
    }
    .closing-grid article + article {
      border-top: 1px solid var(--rule);
    }
  }
</style>
