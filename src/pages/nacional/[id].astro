---
import { render } from "astro:content";
import ArticleHeader from "../../components/ArticleHeader.astro";
import ResponsiveEditorialImage from "../../components/ResponsiveEditorialImage.astro";
import SignalShareTools from "../../components/SignalShareTools.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatEditorialDateTime,
  getPublishedNational,
  type Briefing,
} from "../../lib/content";
import { resolveFrontPageVisual } from "../../lib/front-page-visuals";

interface CanonicalSignal {
  slot: string;
  headline: string;
  deck: string;
  development: string;
  anchor: string;
  sources: Array<{
    name: string;
    url: string;
  }>;
}

interface SignalsArtifact {
  status: "READY";
  date: string;
  contract: "atlas-senales-del-dia-v1";
  senalesDelDia: {
    internacional: CanonicalSignal[];
    nacional: CanonicalSignal[];
    mercados: CanonicalSignal[];
  };
}

export async function getStaticPaths() {
  const briefings = await getPublishedNational();
  return briefings.map((briefing) => ({
    params: { id: briefing.id },
    props: { briefing },
  }));
}

interface Props {
  briefing: Briefing;
}

const { briefing } = Astro.props;
const { Content } = await render(briefing);
const visual = resolveFrontPageVisual({
  section: "national",
  id: briefing.id,
  title: briefing.data.title,
  tags: briefing.data.tags,
  editorialVisual: briefing.data.editorialVisual,
});
const signalFiles = import.meta.glob("../../../data/senales-del-dia/*.json", {
  eager: true,
  query: "?raw",
  import: "default",
}) as Record<string, string>;

const expectedSignalsDate = briefing.id.slice(0, 10);

function parseSignalsArtifact(raw: string | undefined): unknown {
  if (!raw) return undefined;
  try {
    return JSON.parse(raw);
  } catch {
    return undefined;
  }
}

function isCanonicalSignal(value: unknown): value is CanonicalSignal {
  if (!value || typeof value !== "object") return false;

  const signal = value as CanonicalSignal;

  return (
    typeof signal.slot === "string" &&
    typeof signal.headline === "string" &&
    signal.headline.trim().length > 0 &&
    signal.headline.length <= 72 &&
    typeof signal.deck === "string" &&
    signal.deck.trim().length > 0 &&
    signal.deck.length <= 180 &&
    typeof signal.development === "string" &&
    signal.development.trim().length > 0 &&
    typeof signal.anchor === "string" &&
    signal.anchor.trim().length > 0 &&
    Array.isArray(signal.sources)
  );
}

function isReadySignalsArtifact(
  value: unknown,
  date: string,
): value is SignalsArtifact {
  if (!value || typeof value !== "object") return false;

  const artifact = value as SignalsArtifact;
  const internacional = artifact.senalesDelDia?.internacional;
  const nacional = artifact.senalesDelDia?.nacional;
  const mercados = artifact.senalesDelDia?.mercados;

  if (
    artifact.status !== "READY" ||
    artifact.contract !== "atlas-senales-del-dia-v1" ||
    artifact.date !== date ||
    !Array.isArray(internacional) ||
    !Array.isArray(nacional) ||
    !Array.isArray(mercados) ||
    internacional.length !== 2 ||
    nacional.length !== 2 ||
    mercados.length !== 2
  ) {
    return false;
  }

  return [...internacional, ...nacional, ...mercados].every(isCanonicalSignal);
}

const signalEntry = Object.entries(signalFiles).find(([path]) =>
  path.endsWith(`/${expectedSignalsDate}.json`),
);
const signalArtifact = parseSignalsArtifact(signalEntry?.[1]);
const readySignals = isReadySignalsArtifact(signalArtifact, expectedSignalsDate)
  ? signalArtifact
  : undefined;
const nationalSignals = readySignals?.senalesDelDia.nacional ?? [];
const signalUsedSources = new Set<string>();

for (const signal of readySignals?.senalesDelDia.internacional ?? []) {
  const reservedVisual = resolveFrontPageVisual({
    section: "international",
    id: `${expectedSignalsDate}:${signal.slot}:${signal.anchor}`,
    title: `${signal.headline} ${signal.deck}`,
    slot: signal.slot,
    usedSources: signalUsedSources,
  });
  signalUsedSources.add(reservedVisual.src);
}

const nationalSignalItems = nationalSignals.map((signal) => {
  const signalVisual = resolveFrontPageVisual({
    section: "national",
    id: `${expectedSignalsDate}:${signal.slot}:${signal.anchor}`,
    title: `${signal.headline} ${signal.deck}`,
    slot: signal.slot,
    usedSources: signalUsedSources,
  });
  signalUsedSources.add(signalVisual.src);
  return { signal, visual: signalVisual };
});
---

<BaseLayout
  title={`${briefing.data.title} — Nacional — ATLAS NEWS`}
  description={briefing.data.summary}
>
  <main class="article-page">
    <ArticleHeader
      eyebrow="Nacional"
      title={briefing.data.title}
      summary={briefing.data.summary}
      date={formatEditorialDateTime(briefing.data.publishedAt)}
      cutoff={formatEditorialDateTime(briefing.data.cutoffAt)}
      demo={briefing.data.demo}
      tags={briefing.data.tags}
      visual={visual}
    />

    <article class="prose"><Content /></article>

    {
      nationalSignalItems.length === 2 && (
        <section class="signal-developments" aria-labelledby="senales-nacional">
          <header class="signal-developments__header">
            <p>Señales del día</p>
            <h2 id="senales-nacional">Nacional</h2>
          </header>

          <div class="signal-developments__list">
            {nationalSignalItems.map((item) => (
              <article
                class="signal-development"
                id={item.signal.anchor}
                aria-labelledby={`${item.signal.anchor}-title`}
              >
                <div class="signal-development__hero">
                  <figure class="signal-development__visual">
                    <ResponsiveEditorialImage
                      src={item.visual.src}
                      alt={item.visual.alt}
                      sizes="(max-width: 42rem) 38vw, 18rem"
                      loading="lazy"
                      variant="article"
                    />
                    <figcaption>
                      {item.visual.source} · {item.visual.author} ·{" "}
                      {item.visual.license}
                    </figcaption>
                  </figure>

                  <div class="signal-development__hero-copy">
                    <p class="signal-development__context">
                      Señales del día · Nacional
                    </p>
                    <h3 id={`${item.signal.anchor}-title`}>
                      {item.signal.headline}
                    </h3>
                  </div>
                </div>

                <nav
                  class="signal-development__nav"
                  aria-label={`Navegación desde ${item.signal.headline}`}
                >
                  <a class="signal-development__back" href="/#senales-del-dia">
                    ← Volver a Señales del Día
                  </a>
                  <a class="signal-development__secondary" href="/">
                    Portada
                  </a>
                  <a class="signal-development__secondary" href="/nacional/">
                    Nacional
                  </a>
                </nav>

                <SignalShareTools
                  title={item.signal.headline}
                  summary={item.signal.deck}
                  anchor={item.signal.anchor}
                  variant="full"
                />

                <div class="signal-development__body">
                  {item.signal.development}
                </div>

                {item.signal.sources.length > 0 && (
                  <div
                    class="signal-development__sources"
                    aria-label={`Fuentes de ${item.signal.headline}`}
                  >
                    <strong>Fuentes</strong>
                    <ul>
                      {item.signal.sources.map((source) => (
                        <li>
                          <a href={source.url}>{source.name}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="sources" aria-labelledby="fuentes-documentadas">
      <h2 id="fuentes-documentadas">Fuentes documentadas</h2>
      <ul>
        {
          briefing.data.sources.map((source) => (
            <li>
              <a href={source.url}>{source.name}</a>
              {source.publishedAt && (
                <span>{formatEditorialDateTime(source.publishedAt)}</span>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <p class="return-link"><a href="/nacional/">← Volver a Nacional</a></p>
  </main>
</BaseLayout>

<style>
  .article-page {
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .prose {
    max-width: 52rem;
    margin: 2.5rem auto 3.5rem;
    font-size: 1.1rem;
    line-height: 1.72;
  }
  .prose :global(p:first-of-type:first-letter) {
    float: left;
    margin: 0.08em 0.08em 0 0;
    color: var(--accent);
    font-size: 4.6rem;
    font-weight: 700;
    line-height: 0.72;
  }
  .prose :global(h2) {
    margin: 3rem 0 1rem;
    padding-top: 0.65rem;
    border-top: 4px double var(--rule);
    font: 800 clamp(1.55rem, 4vw, 2.45rem)/1 var(--sans);
    letter-spacing: -0.02em;
  }
  .prose :global(h3) {
    margin-top: 2.3rem;
    font-size: 1.45rem;
    line-height: 1.1;
  }
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-top: 2px solid var(--rule);
    border-bottom: 2px solid var(--rule);
    font: 700 1.25rem/1.45 var(--serif);
  }
  .prose :global(li) {
    margin: 0.5rem 0;
  }
  .prose :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font: 0.82rem/1.35 var(--sans);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.6rem;
    border-top: 1px solid var(--rule);
    text-align: left;
  }
  .signal-developments {
    max-width: 52rem;
    margin: 3.75rem auto 4rem;
    padding-top: 1.5rem;
    border-top: 4px double var(--rule);
  }
  .signal-developments__header {
    margin-bottom: 1.4rem;
  }
  .signal-developments__header p {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .signal-developments__header h2 {
    margin: 0;
    font: 700 clamp(1.8rem, 4vw, 2.8rem) / 1 var(--serif);
    letter-spacing: -0.03em;
  }
  .signal-development {
    scroll-margin-top: 5rem;
    padding: 1.65rem 0;
    border-top: 1px solid var(--rule);
  }
  .signal-development:first-child {
    border-top: 0;
  }
  .signal-development:target {
    border-top: 4px double var(--rule);
  }
  .signal-development__hero {
    position: relative;
    margin: 0 0 1rem;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--rule);
  }
  .signal-development__hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: 78%;
    padding: clamp(1.25rem, 4vw, 2.2rem) 0 1.35rem;
  }
  .signal-development__context {
    margin: 0 0 0.7rem;
    color: var(--accent);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .signal-development h3 {
    margin: 0;
    font: 700 clamp(2rem, 5.2vw, 3.6rem) / 0.95 var(--serif);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .signal-development__visual {
    position: absolute;
    z-index: 0;
    top: 0;
    right: -0.5rem;
    bottom: 0;
    width: min(34%, 24rem);
    margin: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }
  .signal-development__visual :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.42;
    filter: saturate(0.65) sepia(0.12) contrast(0.9) brightness(1.08);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.22) 22%,
      rgba(0, 0, 0, 0.72) 58%,
      #000 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.22) 22%,
      rgba(0, 0, 0, 0.72) 58%,
      #000 100%
    );
  }
  .signal-development__visual figcaption {
    position: absolute;
    right: 0.25rem;
    bottom: 0.2rem;
    max-width: 82%;
    color: var(--ink-soft);
    font: 600 0.42rem/1.15 var(--sans);
    text-align: right;
    opacity: 0.7;
  }
  .signal-development__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 36rem);
    margin: 0 0 1.1rem;
    border-right: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
    border-left: 1px solid var(--rule);
    border-top: 4px double var(--rule);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .signal-development__nav a {
    display: flex;
    align-items: center;
    min-height: 2.55rem;
    padding: 0.62rem 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .signal-development__nav .signal-development__back {
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--rule);
    color: var(--accent);
  }
  .signal-development__nav .signal-development__back::after {
    margin-left: auto;
    color: var(--accent);
    content: "◆";
    font-size: 0.62rem;
  }
  .signal-development__nav
    .signal-development__secondary
    + .signal-development__secondary {
    border-left: 1px solid var(--rule);
  }
  .signal-development__nav a:hover,
  .signal-development__nav a:focus-visible {
    color: var(--paper);
    background: var(--ink);
    outline: none;
  }
  .signal-development__nav .signal-development__back:hover::after,
  .signal-development__nav .signal-development__back:focus-visible::after {
    color: var(--paper);
  }
  .signal-development__body {
    color: var(--ink);
    font-size: 1.08rem;
    line-height: 1.68;
    white-space: pre-line;
  }
  .signal-development__sources {
    margin-top: 1.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--rule);
    font: 0.78rem/1.45 var(--sans);
  }
  .signal-development__sources > strong {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .signal-development__sources ul {
    margin: 0.45rem 0 0;
    padding-left: 1.15rem;
  }
  .signal-development__sources li {
    margin: 0.3rem 0;
  }
  .sources,
  .return-link {
    max-width: 52rem;
    margin: 4rem auto;
  }
  .sources {
    padding-top: 1.5rem;
    border-top: 4px double var(--rule);
  }
  .sources h2 {
    font: 800 1.1rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sources li {
    margin: 0.7rem 0;
  }
  .sources span {
    display: block;
    margin-top: 0.15rem;
    color: var(--ink-soft);
    font: 0.72rem/1.4 var(--sans);
  }
  .return-link {
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font: 800 0.8rem/1.4 var(--sans);
    text-transform: uppercase;
  }
  @media (max-width: 42rem) {
    .article-page {
      width: min(100% - 1.25rem, 88rem);
    }
    .prose {
      margin-top: 1.55rem;
      font-size: 1.03rem;
    }
    .signal-developments {
      margin-top: 2.6rem;
    }
    .signal-development {
      scroll-margin-top: 3.5rem;
      padding: 1.35rem 0;
    }
    .signal-development__hero {
      margin-bottom: 0.85rem;
    }
    .signal-development__hero-copy {
      max-width: 86%;
      padding: 1rem 0 1.1rem;
    }
    .signal-development h3 {
      font-size: clamp(2rem, 8.4vw, 2.7rem);
      line-height: 0.96;
    }
    .signal-development__visual {
      right: -0.55rem;
      width: 38%;
    }
    .signal-development__visual :global(img) {
      opacity: 0.36;
    }
    .signal-development__visual figcaption {
      right: 0.2rem;
      bottom: 0.15rem;
      max-width: 74%;
      font-size: 0.36rem;
    }
    .signal-development__nav {
      width: 100%;
    }
    .signal-development__body {
      font-size: 1.03rem;
      line-height: 1.62;
    }
  }
</style>
