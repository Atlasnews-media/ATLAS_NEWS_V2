---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Vespertino — ATLAS NEWS"
  description="Edición vespertina de ATLAS NEWS: cierre y actualización de Internacional, Nacional y Mercados al final de la jornada."
>
  <main class="page-shell section-page">
    <p class="page-kicker">Cierre de la jornada</p>
    <h1 class="page-title">Vespertino</h1>
    <p class="page-intro">
      La edición vespertina reúne las principales novedades de Internacional,
      Nacional y Mercados acumuladas durante la segunda mitad de la jornada.
    </p>

    <p class="empty-state">Aún no hay una edición vespertina publicada.</p>
  </main>
</BaseLayout>

<style>
  .empty-state {
    margin-top: 2rem;
    padding: 2rem 0;
    border-top: 5px double var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    font: 0.95rem/1.5 var(--sans);
  }

  @media (max-width: 42rem) {
    .page-intro {
      display: none;
    }
  }
</style>
