---
import ContentCard from "../../components/ContentCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  editionTypeLabel,
  formatEditorialDate,
  getPublishedEditions,
} from "../../lib/content";

const editions = await getPublishedEditions();
---

<BaseLayout
  title="Ediciones — ATLAS NEWS"
  description="Briefings diarios y panoramas semanales de ATLAS NEWS."
>
  <main>
    <p class="eyebrow">Publicaciones</p>
    <h1>Ediciones</h1>
    <p class="intro">
      Briefings diarios y panoramas semanales, ordenados desde el cierre más
      reciente.
    </p>
    <div>
      {
        editions.map((edition) => (
          <ContentCard
            href={`/ediciones/${edition.id}/`}
            eyebrow={editionTypeLabel(edition.data.type)}
            title={edition.data.title}
            summary={edition.data.summary}
            date={formatEditorialDate(edition.data.publishedAt)}
            demo={edition.data.demo}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  main {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0;
  }
  .eyebrow {
    font:
      700 0.75rem/1.2 system-ui,
      sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0.75rem 0;
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.9;
  }
  .intro {
    max-width: 44rem;
    margin-bottom: 3rem;
    font-size: 1.25rem;
    line-height: 1.5;
  }
</style>
