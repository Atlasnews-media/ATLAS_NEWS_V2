---
import ContentCard from "../components/ContentCard.astro";
import DailyAudio from "../components/DailyAudio.astro";
import EconomicIndicators from "../components/EconomicIndicators.astro";
import EditorialDoubleRule from "../components/EditorialDoubleRule.astro";
import FrontPageHeadline from "../components/FrontPageHeadline.astro";
import MarketPulse from "../components/MarketPulse.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  dailyIssueNumber,
  formatEditorialDate,
  formatIssueNumber,
  getLatestDaily,
  getLatestMarkets,
  getLatestNational,
  getPublishedEditions,
  getPublishedReadings,
} from "../lib/content";
import { resolveFrontPageVisual } from "../lib/front-page-visuals";

const [latestDaily, editions, latestNational, latestMarkets, readings] =
  await Promise.all([
    getLatestDaily(),
    getPublishedEditions(),
    getLatestNational(),
    getLatestMarkets(),
    getPublishedReadings(),
  ]);
const currentIssueNumber = latestDaily
  ? dailyIssueNumber(latestDaily, editions)
  : undefined;
const latestReading = readings[0];
const latestWeekly = editions.find(({ data }) => data.type === "weekly");
const hasAnalysisContent = Boolean(latestNational || latestMarkets);

const dailyVisual = latestDaily
  ? resolveFrontPageVisual({
      section: "international",
      id: latestDaily.id,
      title: latestDaily.data.title,
      tags: latestDaily.data.tags,
      editorialVisual: latestDaily.data.editorialVisual,
    })
  : undefined;

const nationalVisual = latestNational
  ? resolveFrontPageVisual({
      section: "national",
      id: latestNational.id,
      title: latestNational.data.title,
      tags: latestNational.data.tags,
      editorialVisual: latestNational.data.editorialVisual,
    })
  : undefined;

const marketsVisual = latestMarkets
  ? resolveFrontPageVisual({
      section: "markets",
      id: latestMarkets.id,
      title: latestMarkets.data.title,
      tags: latestMarkets.data.tags,
      editorialVisual: latestMarkets.data.editorialVisual,
    })
  : undefined;
---

<BaseLayout
  title="ATLAS NEWS — Portada"
  description="ATLAS NEWS — Inteligencia financiera, contexto y criterio editorial. Portada general con titulares de Internacional, Nacional y Mercados."
>
  <main class="front-page front-page--v2">
    <div class="issue-line">
      <p>Portada</p>
      <p>
        {
          currentIssueNumber
            ? formatIssueNumber(currentIssueNumber)
            : "En preparación"
        }
      </p>
      <p>Edición matutina</p>
    </div>

    <EconomicIndicators />
    <DailyAudio expectedDate={latestDaily?.id.slice(0, 10)} />

    {
      latestDaily ? (
        <>
          <EditorialDoubleRule />
          <section class="lead-grid" aria-labelledby="titulares">
            <article class="lead-story headline-board">
              <h1 id="titulares" class="headline-board-title">
                Titulares
              </h1>

              <div class="headline-list">
                <FrontPageHeadline
                  label="Internacional"
                  title={latestDaily.data.title}
                  href={`/ediciones/${latestDaily.id}/`}
                  cta="Ir a Internacional"
                  visual={dailyVisual}
                  eager
                />

                {latestNational && (
                  <FrontPageHeadline
                    label="Nacional"
                    title={latestNational.data.title}
                    href={`/nacional/${latestNational.id}/`}
                    cta="Ir a Nacional"
                    visual={nationalVisual}
                  />
                )}

                {latestMarkets && (
                  <FrontPageHeadline
                    label="Mercados"
                    title={latestMarkets.data.title}
                    href={`/mercados/${latestMarkets.id}/`}
                    cta="Ir a Mercados"
                    visual={marketsVisual}
                  />
                )}
              </div>

              <div class="calendar-entry">
                <a
                  class="calendar-link"
                  href="/calendario-economico/"
                  aria-label="Ir a calendario económico de hoy"
                >
                  Ir a calendario económico de hoy
                  <span aria-hidden="true">→</span>
                </a>
              </div>

              <div class="calendar-entry">
                <a
                  class="calendar-link"
                  href="/mercados/indices/"
                  aria-label="Ir a índices de mercado"
                >
                  Ir a índices de mercado
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>

            <EditorialDoubleRule />

            <aside class="edition-rail" aria-label="Claves de la edición">
              <p class="rail-title">En una mirada</p>
              <ol>
                {latestDaily.data.highlights?.map((highlight) => (
                  <li>
                    <strong>{highlight.label}</strong>
                    <span>{highlight.text}</span>
                  </li>
                ))}
              </ol>
            </aside>
          </section>
        </>
      ) : (
        <section class="empty">
          <h1>La próxima edición está en preparación</h1>
        </section>
      )
    }

    {
      hasAnalysisContent && (
        <section class="news-grid" aria-labelledby="analisis">
          <div class="section-rule">
            <h2 id="analisis">Análisis</h2>
          </div>
          <div class="columns">
            {latestNational && (
              <ContentCard
                href={`/nacional/${latestNational.id}/`}
                eyebrow="Nacional · Profundidad"
                title={latestNational.data.title}
                summary={latestNational.data.summary}
                date={formatEditorialDate(latestNational.data.publishedAt)}
                demo={latestNational.data.demo}
                visual={nationalVisual}
                compact
              />
            )}
            {latestMarkets && (
              <ContentCard
                href={`/mercados/${latestMarkets.id}/`}
                eyebrow="Mercados · Profundidad"
                title={latestMarkets.data.title}
                summary={latestMarkets.data.summary}
                date={formatEditorialDate(latestMarkets.data.publishedAt)}
                demo={latestMarkets.data.demo}
                visual={marketsVisual}
                compact
              />
            )}
          </div>
        </section>
      )
    }

    <section class="closing-grid" aria-label="Seguimiento editorial">
      <article>
        {
          latestWeekly ? (
            <>
              <p class="kicker">Panorama semanal</p>
              <h2>
                <a href={`/ediciones/${latestWeekly.id}/`}>
                  {latestWeekly.data.title}
                </a>
              </h2>
              <p class="closing-summary">{latestWeekly.data.summary}</p>
              <a class="closing-link" href={`/ediciones/${latestWeekly.id}/`}>
                Abrir panorama <span aria-hidden="true">→</span>
              </a>
            </>
          ) : (
            <>
              <p class="kicker">Panorama semanal</p>
              <h2>Próxima edición semanal en preparación</h2>
            </>
          )
        }
      </article>
      <article>
        {
          latestDaily?.data.marketSummary ? (
            <MarketPulse
              asOf={latestDaily.data.marketSummary.asOf}
              items={latestDaily.data.marketSummary.items}
            />
          ) : (
            <>
              <p class="kicker">Qué observar</p>
              <h2>Las señales que pueden cambiar la lectura</h2>
              <p class="closing-summary">
                Cada edición separa los hechos, las implicancias y las
                condiciones que podrían invalidar la interpretación inicial.
              </p>
            </>
          )
        }
      </article>
      <article>
        {
          latestReading ? (
            <>
              <p class="kicker">Última contingencia</p>
              <h2>
                <a href={`/lecturas/${latestReading.id}/`}>
                  {latestReading.data.title}
                </a>
              </h2>
              <p class="closing-summary">{latestReading.data.summary}</p>
              <a class="closing-link" href={`/lecturas/${latestReading.id}/`}>
                Abrir contingencia <span aria-hidden="true">→</span>
              </a>
            </>
          ) : (
            <>
              <p class="kicker">Contingencia</p>
              <h2>Próxima contingencia en preparación</h2>
            </>
          )
        }
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .front-page {
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .issue-line {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .issue-line p {
    margin: 0;
  }
  .issue-line p:last-child {
    text-align: right;
  }
  .lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    border-bottom: 5px double var(--rule);
  }
  .lead-story {
    padding: clamp(2rem, 5vw, 4.5rem) 0 3rem;
    border-right: 0;
  }
  .kicker,
  .headline-board-title {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .headline-list {
    margin-top: 0.8rem;
  }
  .calendar-entry {
    margin-top: 0.2rem;
    padding: 1rem 0 0.2rem;
    border-top: 4px double var(--rule);
  }
  .calendar-entry + .calendar-entry {
    border-top: 1px solid var(--rule);
  }
  .calendar-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .edition-rail {
    padding: clamp(1.9rem, 3.8vw, 3.2rem) 0 clamp(2.1rem, 4vw, 3.6rem);
    border-top: 4px double var(--rule);
  }
  .rail-title {
    margin: 0;
    padding: 0 0 clamp(1rem, 1.9vw, 1.45rem);
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    font: 700 clamp(2.2rem, 4.4vw, 4.25rem) / 0.95 var(--serif);
    letter-spacing: -0.04em;
    text-transform: none;
  }
  .edition-rail ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: point;
  }
  .edition-rail li {
    display: grid;
    grid-template-columns: clamp(3rem, 5vw, 4.5rem) minmax(0, 1fr);
    padding: clamp(1rem, 1.7vw, 1.35rem) 0;
    border-top: 1px solid var(--rule);
    counter-increment: point;
  }
  .edition-rail li:first-child {
    border-top: 0;
  }
  .edition-rail li::before {
    content: "0" counter(point);
    color: var(--accent);
    font: 700 clamp(0.9rem, 1.35vw, 1.1rem) / 1.2 var(--serif);
  }
  .edition-rail strong,
  .edition-rail span {
    grid-column: 2;
  }
  .edition-rail strong {
    margin-bottom: 0.35rem;
    font: 700 clamp(1rem, 1.5vw, 1.2rem) / 1.14 var(--serif);
    letter-spacing: -0.01em;
    text-transform: none;
  }
  .edition-rail span {
    color: var(--ink-soft);
    font: 400 clamp(1.08rem, 1.9vw, 1.45rem) / 1.28 var(--serif);
  }
  .news-grid {
    padding-top: 2.5rem;
  }
  .section-rule {
    padding: 0.65rem 0;
    border-top: 4px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .section-rule h2 {
    margin: 0;
    font: 800 1.2rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
  .columns :global(.card) {
    padding-right: 1.5rem;
  }
  .columns :global(.card + .card) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }
  .closing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3rem;
    border-top: 5px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .closing-grid article {
    padding: 1.5rem;
  }
  .closing-grid article:first-child {
    padding-left: 0;
  }
  .closing-grid article + article {
    border-left: 1px solid var(--rule);
  }
  .closing-grid h2 {
    margin: 0.6rem 0;
    font-size: 1.55rem;
    line-height: 1;
  }
  .closing-grid h2 a {
    text-decoration: none;
  }
  .closing-grid h2 a:hover {
    color: var(--accent);
  }
  .closing-summary {
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .closing-link {
    display: inline-block;
    margin-top: 0.8rem;
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.site-header nav) {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    justify-content: stretch;
    padding: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
  }
  :global(.site-header nav a) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 3.3rem;
    padding: 0.8rem 0.55rem;
    border-left: 1px solid rgba(31, 29, 23, 0.16);
    text-align: center;
    white-space: nowrap;
    transition: background-color 140ms ease;
  }
  :global(.site-header nav a:first-child) {
    border-left: 0;
    background: rgba(31, 29, 23, 0.045);
  }
  :global(.site-header nav a + a::before) {
    content: none;
  }
  :global(.site-header nav a:hover) {
    background: rgba(31, 29, 23, 0.035);
  }

  @media (min-width: 42.01rem) and (max-width: 58rem) {
    .lead-story {
      padding-right: 0;
      border-right: 0;
    }
    .edition-rail {
      padding-left: 0;
    }
  }
  @media (max-width: 42rem) {
    .front-page {
      width: min(100% - 1.25rem, 88rem);
    }
    .issue-line {
      display: none;
    }
    :global(.site-header nav) {
      height: auto;
      min-height: 0;
      align-items: stretch;
      gap: 0;
      font-size: 0.46rem;
      line-height: 1;
    }
    :global(.site-header nav a) {
      box-sizing: border-box;
      height: auto;
      min-height: 1.62rem;
      padding: 0.18rem 0.04rem;
      align-self: stretch;
    }
    :global(.editorial-double-rule) + .lead-grid {
      margin-top: 16px;
    }
    .lead-grid {
      grid-template-columns: 1fr;
    }
    .lead-grid > :global(.editorial-double-rule) {
      grid-column: 1 / -1;
    }
    .lead-story {
      padding-top: 0;
      padding-right: 0;
      padding-bottom: 0.95rem;
      border-right: 0;
    }
    .headline-board-title {
      margin-top: 0;
      margin-bottom: 0;
    }
    .headline-list {
      margin-top: 0.75rem;
    }
    .calendar-entry {
      margin-top: 0;
      padding: 0.9rem 0 0.4rem;
    }
    .calendar-link {
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
      font-size: 0.72rem;
      line-height: 1.1;
      letter-spacing: 0.055em;
    }
    .edition-rail {
      padding-top: 1.05rem;
      padding-bottom: 1.65rem;
      padding-left: 0;
      border-top: 0;
    }
    .rail-title {
      padding-bottom: 0.85rem;
      font: 700 clamp(1.75rem, 7vw, 2.25rem) / 0.98 var(--serif);
      letter-spacing: -0.03em;
    }
    .edition-rail li {
      grid-template-columns: 2.65rem minmax(0, 1fr);
      padding: 0.82rem 0 0.9rem;
    }
    .edition-rail li::before {
      font-size: 0.82rem;
    }
    .edition-rail strong {
      margin-bottom: 0.28rem;
      font-size: 0.86rem;
      line-height: 1.12;
    }
    .edition-rail span {
      font-size: 1.04rem;
      line-height: 1.3;
    }
    .columns,
    .closing-grid {
      grid-template-columns: 1fr;
    }
    .columns :global(.card),
    .columns :global(.card + .card),
    .closing-grid article,
    .closing-grid article:first-child {
      padding-right: 0;
      padding-left: 0;
      border-left: 0;
    }
    .closing-grid article + article {
      border-top: 1px solid var(--rule);
    }
  }
</style>
