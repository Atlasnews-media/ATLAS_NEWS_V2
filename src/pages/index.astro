---
import ContentCard from "../components/ContentCard.astro";
import EconomicIndicators from "../components/EconomicIndicators.astro";
import MarketPulse from "../components/MarketPulse.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  dailyIssueNumber,
  editionDisplayLabel,
  formatEditorialDate,
  formatIssueNumber,
  getLatestDaily,
  getLatestMarkets,
  getLatestNational,
  getPublishedEditions,
  getPublishedReadings,
} from "../lib/content";

const [latestDaily, editions, latestNational, latestMarkets, readings] =
  await Promise.all([
    getLatestDaily(),
    getPublishedEditions(),
    getLatestNational(),
    getLatestMarkets(),
    getPublishedReadings(),
  ]);
const currentIssueNumber = latestDaily
  ? dailyIssueNumber(latestDaily, editions)
  : undefined;
const latestReading = readings[0];
const hasDepthContent = Boolean(
  latestNational || latestMarkets || latestReading,
);
---

<BaseLayout
  title="ATLAS NEWS — Portada"
  description="ATLAS NEWS — Inteligencia financiera, contexto y criterio editorial. Portada general con profundidad en Chile, mercados y lecturas seleccionadas."
>
  <main class="front-page">
    <div class="issue-line">
      <p>Portada</p>
      <p>
        {
          currentIssueNumber
            ? formatIssueNumber(currentIssueNumber)
            : "En preparación"
        }
      </p>
      <p>Edición matutina</p>
    </div>

    <EconomicIndicators />

    {
      latestDaily ? (
        <section class="lead-grid" aria-labelledby="edicion-principal">
          <article class="lead-story">
            <p class="kicker">Hecho central</p>
            <h1 id="edicion-principal">
              <a href={`/ediciones/${latestDaily.id}/`}>
                {latestDaily.data.title}
              </a>
            </h1>
            <p class="standfirst">{latestDaily.data.summary}</p>
            <div class="lead-meta">
              <span>
                {editionDisplayLabel(latestDaily, currentIssueNumber)}
              </span>
              {latestDaily.data.demo && <strong>Edición demostrativa</strong>}
            </div>
            <a class="lead-link" href={`/ediciones/${latestDaily.id}/`}>
              Abrir la edición completa <span aria-hidden="true">→</span>
            </a>
          </article>

          <aside class="edition-rail" aria-label="Claves de la edición">
            <p class="rail-title">En una mirada</p>
            <ol>
              {latestDaily.data.highlights?.map((highlight) => (
                <li>
                  <strong>{highlight.label}</strong>
                  <span>{highlight.text}</span>
                </li>
              ))}
            </ol>
          </aside>
        </section>
      ) : (
        <section class="empty">
          <h1>La próxima edición está en preparación</h1>
        </section>
      )
    }

    {
      hasDepthContent && (
        <section class="news-grid" aria-labelledby="profundidad">
          <div class="section-rule">
            <h2 id="profundidad">Profundidad y comprensión</h2>
            <span>Portada orienta · verticales profundizan</span>
          </div>
          <div class="columns">
            {latestNational && (
              <ContentCard
                href={`/nacional/${latestNational.id}/`}
                eyebrow="Nacional · Profundidad"
                title={latestNational.data.title}
                summary={latestNational.data.summary}
                date={formatEditorialDate(latestNational.data.publishedAt)}
                demo={latestNational.data.demo}
                compact
              />
            )}
            {latestMarkets && (
              <ContentCard
                href={`/mercados/${latestMarkets.id}/`}
                eyebrow="Mercados · Profundidad"
                title={latestMarkets.data.title}
                summary={latestMarkets.data.summary}
                date={formatEditorialDate(latestMarkets.data.publishedAt)}
                demo={latestMarkets.data.demo}
                compact
              />
            )}
            {latestReading && (
              <ContentCard
                href={`/lecturas/${latestReading.id}/`}
                eyebrow="Lecturas · Comprensión"
                title={latestReading.data.title}
                summary={latestReading.data.summary}
                date={formatEditorialDate(latestReading.data.publishedAt)}
                demo={latestReading.data.demo}
                compact
              />
            )}
          </div>
        </section>
      )
    }

    <section class="closing-grid">
      <article>
        <p class="kicker">Por qué importa</p><h2>
          Portada para orientarse, verticales para profundizar
        </h2><p>
          La edición general concentra las señales decisivas. Nacional y Mercados
          desarrollan los temas que necesitan contexto, mecanismos, consecuencias
          y seguimiento propio.
        </p>
      </article>
      <article>
        {
          latestDaily?.data.marketSummary ? (
            <MarketPulse
              asOf={latestDaily.data.marketSummary.asOf}
              items={latestDaily.data.marketSummary.items}
            />
          ) : (
            <>
              <p class="kicker">Qué observar</p>
              <h2>Las señales que pueden cambiar la lectura</h2>
              <p>
                Cada edición separa el hecho central, las implicancias y las
                condiciones que podrían invalidar la interpretación inicial.
              </p>
            </>
          )
        }
      </article>
      <article>
        <p class="kicker">Lecturas</p><h2>
          Comprender el mecanismo detrás de la noticia
        </h2><p>
          Las lecturas seleccionadas explican ideas, marcos y mecanismos que
          siguen siendo útiles más allá del ciclo noticioso inmediato.
        </p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .front-page {
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .issue-line {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .issue-line p {
    margin: 0;
  }
  .issue-line p:last-child {
    text-align: right;
  }
  .lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.7fr) minmax(15rem, 1fr);
    gap: 0;
    border-bottom: 5px double var(--rule);
  }
  .lead-story {
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem) 3rem 0;
    border-right: 1px solid var(--rule);
  }
  .kicker,
  .rail-title {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .lead-story h1 {
    max-width: 70rem;
    margin: 0.65rem 0 1.5rem;
    font-size: clamp(3.5rem, 8.8vw, 8.4rem);
    line-height: 0.82;
    letter-spacing: -0.07em;
    text-wrap: balance;
  }
  .lead-story h1 a {
    text-decoration: none;
  }
  .lead-story h1 a:hover {
    color: var(--accent);
  }
  .standfirst {
    max-width: 55rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.2rem, 2vw, 1.58rem);
    line-height: 1.42;
  }
  .lead-meta {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lead-meta strong {
    color: var(--accent);
  }
  .lead-link {
    display: inline-block;
    margin-top: 2rem;
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .edition-rail {
    padding: clamp(2rem, 5vw, 4.5rem) 0 3rem clamp(1.25rem, 3vw, 2.25rem);
  }
  .edition-rail ol {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: point;
  }
  .edition-rail li {
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    padding: 1.1rem 0;
    border-top: 1px solid var(--rule);
    counter-increment: point;
  }
  .edition-rail li::before {
    content: "0" counter(point);
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
  }
  .edition-rail strong,
  .edition-rail span {
    grid-column: 2;
  }
  .edition-rail strong {
    margin-bottom: 0.3rem;
    font: 800 0.8rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .edition-rail span {
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .news-grid {
    padding-top: 2.5rem;
  }
  .section-rule {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border-top: 4px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .section-rule h2 {
    margin: 0;
    font: 800 1.2rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .section-rule span {
    font: 800 0.68rem/1.2 var(--sans);
    text-transform: uppercase;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .columns :global(.card) {
    padding-right: 1.5rem;
  }
  .columns :global(.card + .card) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }
  .closing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3rem;
    border-top: 5px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .closing-grid article {
    padding: 1.5rem;
  }
  .closing-grid article:first-child {
    padding-left: 0;
  }
  .closing-grid article + article {
    border-left: 1px solid var(--rule);
  }
  .closing-grid h2 {
    margin: 0.6rem 0;
    font-size: 1.55rem;
    line-height: 1;
  }
  .closing-grid p:last-child {
    color: var(--ink-soft);
    line-height: 1.45;
  }

  @media (max-width: 58rem) {
    .lead-grid {
      grid-template-columns: minmax(0, 2fr) minmax(13rem, 1fr);
    }
    .columns {
      grid-template-columns: repeat(2, 1fr);
    }
    .columns :global(.card:nth-child(3)) {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 42rem) {
    .front-page {
      width: min(100% - 1.25rem, 88rem);
    }
    .issue-line {
      grid-template-columns: 1fr auto;
    }
    .issue-line p:last-child {
      display: none;
    }
    .lead-grid {
      grid-template-columns: 1fr;
    }
    .lead-story {
      padding-right: 0;
      border-right: 0;
    }
    .edition-rail {
      padding-left: 0;
      border-top: 1px solid var(--rule);
    }
    .section-rule {
      align-items: flex-start;
      flex-direction: column;
    }
    .columns,
    .closing-grid {
      grid-template-columns: 1fr;
    }
    .columns :global(.card),
    .columns :global(.card + .card),
    .closing-grid article,
    .closing-grid article:first-child {
      padding-right: 0;
      padding-left: 0;
      border-left: 0;
    }
    .closing-grid article + article {
      border-top: 1px solid var(--rule);
    }
  }
</style>
