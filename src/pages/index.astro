---
import ContentCard from "../components/ContentCard.astro";
import DailyAudio from "../components/DailyAudio.astro";
import EconomicIndicators from "../components/EconomicIndicators.astro";
import EditorialDoubleRule from "../components/EditorialDoubleRule.astro";
import MarketPulse from "../components/MarketPulse.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  dailyIssueNumber,
  formatEditorialDate,
  formatIssueNumber,
  getLatestDaily,
  getLatestMarkets,
  getLatestNational,
  getPublishedEditions,
  getPublishedReadings,
} from "../lib/content";

const [latestDaily, editions, latestNational, latestMarkets, readings] =
  await Promise.all([
    getLatestDaily(),
    getPublishedEditions(),
    getLatestNational(),
    getLatestMarkets(),
    getPublishedReadings(),
  ]);
const currentIssueNumber = latestDaily
  ? dailyIssueNumber(latestDaily, editions)
  : undefined;
const latestReading = readings[0];
const latestWeekly = editions.find(({ data }) => data.type === "weekly");
const hasAnalysisContent = Boolean(latestNational || latestMarkets);

const isAllowedEditorialVisual = (src?: string) => {
  if (!src) return false;

  try {
    const hostname = new URL(src).hostname;
    return ["upload.wikimedia.org", "commons.wikimedia.org"].includes(hostname);
  } catch {
    return false;
  }
};

const dailyVisual = latestDaily?.data.editorialVisual;
const nationalVisual = latestNational?.data.editorialVisual;
const marketsVisual = latestMarkets?.data.editorialVisual;
---

<BaseLayout
  title="ATLAS NEWS — Portada"
  description="ATLAS NEWS — Inteligencia financiera, contexto y criterio editorial. Portada general con titulares de Internacional, Nacional y Mercados."
>
  <main class="front-page">
    <div class="issue-line">
      <p>Portada</p>
      <p>
        {
          currentIssueNumber
            ? formatIssueNumber(currentIssueNumber)
            : "En preparación"
        }
      </p>
      <p>Edición matutina</p>
    </div>

    <EconomicIndicators />
    <DailyAudio expectedDate={latestDaily?.id.slice(0, 10)} />

    {
      latestDaily ? (
        <>
          <EditorialDoubleRule />
          <section class="lead-grid" aria-labelledby="titulares">
            <article class="lead-story headline-board">
              <h1 id="titulares" class="headline-board-title">
                Titulares
              </h1>

              <div class="headline-list">
                <section
                  class:list={[
                    "headline-item",
                    !(dailyVisual && isAllowedEditorialVisual(dailyVisual.src)) &&
                      "headline-item--no-visual",
                  ]}
                >
                  <div class="headline-copy">
                    <p class="headline-label">Internacional</p>
                    <h2>
                      <a href={`/ediciones/${latestDaily.id}/`}>
                        {latestDaily.data.title}
                      </a>
                    </h2>
                    <a
                      class="headline-cta"
                      href={`/ediciones/${latestDaily.id}/`}
                    >
                      Ir a Internacional <span aria-hidden="true">→</span>
                    </a>
                  </div>

                  {dailyVisual && isAllowedEditorialVisual(dailyVisual.src) && (
                    <figure class="headline-visual" aria-hidden="true">
                      <img
                        src={dailyVisual.src}
                        alt=""
                        loading="eager"
                        decoding="async"
                        referrerpolicy="no-referrer"
                      />
                      <figcaption>
                        <a
                          href={dailyVisual.sourceUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {`${dailyVisual.source} · ${dailyVisual.author} · ${dailyVisual.license}`}
                        </a>
                      </figcaption>
                    </figure>
                  )}
                </section>

                {latestNational && (
                  <section
                    class:list={[
                      "headline-item",
                      !(
                        nationalVisual &&
                        isAllowedEditorialVisual(nationalVisual.src)
                      ) && "headline-item--no-visual",
                    ]}
                  >
                    <div class="headline-copy">
                      <p class="headline-label">Nacional</p>
                      <h2>
                        <a href={`/nacional/${latestNational.id}/`}>
                          {latestNational.data.title}
                        </a>
                      </h2>
                      <a
                        class="headline-cta"
                        href={`/nacional/${latestNational.id}/`}
                      >
                        Ir a Nacional <span aria-hidden="true">→</span>
                      </a>
                    </div>

                    {nationalVisual &&
                      isAllowedEditorialVisual(nationalVisual.src) && (
                        <figure class="headline-visual" aria-hidden="true">
                          <img
                            src={nationalVisual.src}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            referrerpolicy="no-referrer"
                          />
                          <figcaption>
                            <a
                              href={nationalVisual.sourceUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {`${nationalVisual.source} · ${nationalVisual.author} · ${nationalVisual.license}`}
                            </a>
                          </figcaption>
                        </figure>
                      )}
                  </section>
                )}

                {latestMarkets && (
                  <section
                    class:list={[
                      "headline-item",
                      !(
                        marketsVisual &&
                        isAllowedEditorialVisual(marketsVisual.src)
                      ) && "headline-item--no-visual",
                    ]}
                  >
                    <div class="headline-copy">
                      <p class="headline-label">Mercados</p>
                      <h2>
                        <a href={`/mercados/${latestMarkets.id}/`}>
                          {latestMarkets.data.title}
                        </a>
                      </h2>
                      <a
                        class="headline-cta"
                        href={`/mercados/${latestMarkets.id}/`}
                      >
                        Ir a Mercados <span aria-hidden="true">→</span>
                      </a>
                    </div>

                    {marketsVisual &&
                      isAllowedEditorialVisual(marketsVisual.src) && (
                        <figure class="headline-visual" aria-hidden="true">
                          <img
                            src={marketsVisual.src}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            referrerpolicy="no-referrer"
                          />
                          <figcaption>
                            <a
                              href={marketsVisual.sourceUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {`${marketsVisual.source} · ${marketsVisual.author} · ${marketsVisual.license}`}
                            </a>
                          </figcaption>
                        </figure>
                      )}
                  </section>
                )}
              </div>
            </article>

            <EditorialDoubleRule />

            <aside class="edition-rail" aria-label="Claves de la edición">
              <p class="rail-title">En una mirada</p>
              <ol>
                {latestDaily.data.highlights?.map((highlight) => (
                  <li>
                    <strong>{highlight.label}</strong>
                    <span>{highlight.text}</span>
                  </li>
                ))}
              </ol>
            </aside>
          </section>
        </>
      ) : (
        <section class="empty">
          <h1>La próxima edición está en preparación</h1>
        </section>
      )
    }

    {
      hasAnalysisContent && (
        <section class="news-grid" aria-labelledby="analisis">
          <div class="section-rule">
            <h2 id="analisis">Análisis</h2>
          </div>
          <div class="columns">
            {latestNational && (
              <ContentCard
                href={`/nacional/${latestNational.id}/`}
                eyebrow="Nacional · Profundidad"
                title={latestNational.data.title}
                summary={latestNational.data.summary}
                date={formatEditorialDate(latestNational.data.publishedAt)}
                demo={latestNational.data.demo}
                compact
              />
            )}
            {latestMarkets && (
              <ContentCard
                href={`/mercados/${latestMarkets.id}/`}
                eyebrow="Mercados · Profundidad"
                title={latestMarkets.data.title}
                summary={latestMarkets.data.summary}
                date={formatEditorialDate(latestMarkets.data.publishedAt)}
                demo={latestMarkets.data.demo}
                compact
              />
            )}
          </div>
        </section>
      )
    }

    <section class="closing-grid" aria-label="Seguimiento editorial">
      <article>
        {
          latestWeekly ? (
            <>
              <p class="kicker">Panorama semanal</p>
              <h2>
                <a href={`/ediciones/${latestWeekly.id}/`}>
                  {latestWeekly.data.title}
                </a>
              </h2>
              <p class="closing-summary">{latestWeekly.data.summary}</p>
              <a class="closing-link" href={`/ediciones/${latestWeekly.id}/`}>
                Abrir panorama <span aria-hidden="true">→</span>
              </a>
            </>
          ) : (
            <>
              <p class="kicker">Panorama semanal</p>
              <h2>Próxima edición semanal en preparación</h2>
            </>
          )
        }
      </article>
      <article>
        {
          latestDaily?.data.marketSummary ? (
            <MarketPulse
              asOf={latestDaily.data.marketSummary.asOf}
              items={latestDaily.data.marketSummary.items}
            />
          ) : (
            <>
              <p class="kicker">Qué observar</p>
              <h2>Las señales que pueden cambiar la lectura</h2>
              <p class="closing-summary">
                Cada edición separa los hechos, las implicancias y las
                condiciones que podrían invalidar la interpretación inicial.
              </p>
            </>
          )
        }
      </article>
      <article>
        {
          latestReading ? (
            <>
              <p class="kicker">Última contingencia</p>
              <h2>
                <a href={`/lecturas/${latestReading.id}/`}>
                  {latestReading.data.title}
                </a>
              </h2>
              <p class="closing-summary">{latestReading.data.summary}</p>
              <a class="closing-link" href={`/lecturas/${latestReading.id}/`}>
                Abrir contingencia <span aria-hidden="true">→</span>
              </a>
            </>
          ) : (
            <>
              <p class="kicker">Contingencia</p>
              <h2>Próxima contingencia en preparación</h2>
            </>
          )
        }
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .front-page {
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .issue-line {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .issue-line p {
    margin: 0;
  }
  .issue-line p:last-child {
    text-align: right;
  }
  .lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.7fr) minmax(15rem, 1fr);
    gap: 0;
    border-bottom: 5px double var(--rule);
  }
  .lead-story {
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem) 3rem 0;
    border-right: 1px solid var(--rule);
  }
  .kicker,
  .rail-title,
  .headline-board-title,
  .headline-label {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .headline-board-title {
    color: var(--accent);
  }
  .headline-list {
    margin-top: 0.8rem;
  }
  .headline-item {
    position: relative;
    padding: 1.05rem 0 1.2rem;
    border-top: 1px solid var(--rule);
  }
  .headline-item:first-child {
    border-top: 0;
  }
  .headline-copy {
    position: relative;
    z-index: 2;
  }
  .headline-label {
    margin-bottom: 0.35rem;
    color: var(--ink-soft);
    letter-spacing: 0.11em;
  }
  .headline-item h2 {
    max-width: 64rem;
    margin: 0;
    font-size: clamp(1.7rem, 2.25vw, 2.45rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .headline-item h2 a {
    text-decoration: none;
  }
  .headline-item h2 a:hover {
    color: var(--accent);
  }
  .headline-cta {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--accent);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .headline-cta:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .headline-visual {
    display: none;
  }
  .edition-rail {
    padding: clamp(2rem, 5vw, 4.5rem) 0 3rem clamp(1.25rem, 3vw, 2.25rem);
  }
  .edition-rail ol {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: point;
  }
  .edition-rail li {
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    padding: 1.1rem 0;
    border-top: 1px solid var(--rule);
    counter-increment: point;
  }
  .edition-rail li::before {
    content: "0" counter(point);
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
  }
  .edition-rail strong,
  .edition-rail span {
    grid-column: 2;
  }
  .edition-rail strong {
    margin-bottom: 0.3rem;
    font: 800 0.8rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .edition-rail span {
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .news-grid {
    padding-top: 2.5rem;
  }
  .section-rule {
    padding: 0.65rem 0;
    border-top: 4px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .section-rule h2 {
    margin: 0;
    font: 800 1.2rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
  .columns :global(.card) {
    padding-right: 1.5rem;
  }
  .columns :global(.card + .card) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }
  .closing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3rem;
    border-top: 5px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .closing-grid article {
    padding: 1.5rem;
  }
  .closing-grid article:first-child {
    padding-left: 0;
  }
  .closing-grid article + article {
    border-left: 1px solid var(--rule);
  }
  .closing-grid h2 {
    margin: 0.6rem 0;
    font-size: 1.55rem;
    line-height: 1;
  }
  .closing-grid h2 a {
    text-decoration: none;
  }
  .closing-grid h2 a:hover {
    color: var(--accent);
  }
  .closing-summary {
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .closing-link {
    display: inline-block;
    margin-top: 0.8rem;
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 42.01rem) and (max-width: 58rem) {
    .lead-grid {
      grid-template-columns: 1fr;
    }
    .lead-story {
      padding-right: 0;
      border-right: 0;
    }
    .headline-item h2 {
      font-size: clamp(1.75rem, 4.2vw, 2.25rem);
    }
    .edition-rail {
      padding-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 42rem) {
    .front-page {
      width: min(100% - 1.25rem, 88rem);
    }
    .issue-line {
      grid-template-columns: 1fr auto;
    }
    .issue-line p:last-child {
      display: none;
    }
    :global(.editorial-double-rule) + .lead-grid {
      margin-top: 16px;
    }
    .lead-grid {
      grid-template-columns: 1fr;
    }
    .lead-grid > :global(.editorial-double-rule) {
      grid-column: 1 / -1;
    }
    .lead-story {
      padding-top: 0;
      padding-right: 0;
      border-right: 0;
    }
    .headline-board-title {
      margin-top: 0;
      margin-bottom: 0;
    }
    .headline-list {
      margin-top: 0.75rem;
    }
    .headline-item {
      min-height: 10.75rem;
      padding: 1rem 0 1.05rem;
      overflow: hidden;
      isolation: isolate;
    }
    .headline-copy {
      width: 73%;
    }
    .headline-item--no-visual .headline-copy {
      width: 100%;
    }
    .headline-label {
      margin-bottom: 0.55rem;
      color: var(--accent);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
    }
    .headline-item h2 {
      font-size: clamp(1.62rem, 6.9vw, 2.05rem);
      line-height: 0.96;
      letter-spacing: -0.035em;
      text-wrap: pretty;
    }
    .headline-cta {
      margin-top: 0.65rem;
      font-size: 0.64rem;
      letter-spacing: 0.07em;
    }
    .headline-visual {
      position: absolute;
      z-index: 0;
      top: 0;
      right: -0.65rem;
      bottom: 0;
      display: block;
      width: 49%;
      margin: 0;
      overflow: hidden;
      pointer-events: none;
    }
    .headline-visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      opacity: 0.76;
      filter: saturate(0.72) sepia(0.12) contrast(0.92) brightness(1.06);
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 0.38) 28%,
        #000 63%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 0.38) 28%,
        #000 63%
      );
    }
    .headline-visual figcaption {
      position: absolute;
      right: 0.4rem;
      bottom: 0.25rem;
      max-width: 78%;
      color: var(--ink-soft);
      font: 600 0.42rem/1.15 var(--sans);
      text-align: right;
      opacity: 0.72;
    }
    .headline-visual figcaption a {
      color: inherit;
      text-decoration: none;
    }
    .edition-rail {
      padding-left: 0;
      border-top: 0;
    }
    .columns,
    .closing-grid {
      grid-template-columns: 1fr;
    }
    .columns :global(.card),
    .columns :global(.card + .card),
    .closing-grid article,
    .closing-grid article:first-child {
      padding-right: 0;
      padding-left: 0;
      border-left: 0;
    }
    .closing-grid article + article {
      border-top: 1px solid var(--rule);
    }
  }
</style>
