---
import ContentCard from "../components/ContentCard.astro";
import DailyAudio from "../components/DailyAudio.astro";
import DailySignals from "../components/DailySignals.astro";
import EconomicIndicators from "../components/EconomicIndicators.astro";
import EditorialDoubleRule from "../components/EditorialDoubleRule.astro";
import FrontPageHeadline from "../components/FrontPageHeadline.astro";
import MarketPulse from "../components/MarketPulse.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  dailyIssueNumber,
  formatEditorialDate,
  formatIssueNumber,
  getLatestDaily,
  getLatestMarkets,
  getLatestNational,
  getPublishedEditions,
  getPublishedReadings,
} from "../lib/content";
import { resolveFrontPageVisual } from "../lib/front-page-visuals";

const [latestDaily, editions, latestNational, latestMarkets, readings] =
  await Promise.all([
    getLatestDaily(),
    getPublishedEditions(),
    getLatestNational(),
    getLatestMarkets(),
    getPublishedReadings(),
  ]);
const currentIssueNumber = latestDaily
  ? dailyIssueNumber(latestDaily, editions)
  : undefined;
const latestReading = readings[0];
const penultimateReading = readings[1];
const hasAnalysisContent = Boolean(latestNational || latestMarkets);

const dailyVisual = latestDaily
  ? resolveFrontPageVisual({
      section: "international",
      id: latestDaily.id,
      title: latestDaily.data.title,
      tags: latestDaily.data.tags,
      editorialVisual: latestDaily.data.editorialVisual,
    })
  : undefined;

const nationalVisual = latestNational
  ? resolveFrontPageVisual({
      section: "national",
      id: latestNational.id,
      title: latestNational.data.title,
      tags: latestNational.data.tags,
      editorialVisual: latestNational.data.editorialVisual,
    })
  : undefined;

const marketsVisual = latestMarkets
  ? resolveFrontPageVisual({
      section: "markets",
      id: latestMarkets.id,
      title: latestMarkets.data.title,
      tags: latestMarkets.data.tags,
      editorialVisual: latestMarkets.data.editorialVisual,
    })
  : undefined;
---

<BaseLayout
  title="ATLAS NEWS — Portada"
  description="ATLAS NEWS — Inteligencia financiera, contexto y criterio editorial. Portada general con titulares de Internacional, Nacional y Mercados."
>
  <main class="front-page front-page--v2">
    <div class="issue-line">
      <p>Portada</p>
      <p>
        {
          currentIssueNumber
            ? formatIssueNumber(currentIssueNumber)
            : "En preparación"
        }
      </p>
      <p>Edición matutina</p>
    </div>

    <EconomicIndicators />
    <DailyAudio expectedDate={latestDaily?.id.slice(0, 10)} />

    {
      latestDaily ? (
        <>
          <EditorialDoubleRule />
          <section class="lead-grid" aria-label="Titulares y Señales del Día">
            <article class="lead-story headline-board" data-front-page-switcher>
              <div
                class="headline-tabs"
                role="tablist"
                aria-label="Contenido principal de Portada"
              >
                <button
                  id="portada-tab-titulares"
                  class="headline-tab is-active"
                  type="button"
                  role="tab"
                  aria-selected="true"
                  aria-controls="portada-panel-titulares"
                  data-front-page-tab="titulares"
                >
                  Titulares
                </button>
                <button
                  id="portada-tab-senales"
                  class="headline-tab"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  aria-controls="portada-panel-senales"
                  data-front-page-tab="senales"
                >
                  Señales del día
                </button>
              </div>

              <div
                id="portada-panel-titulares"
                class="headline-tab-panel"
                role="tabpanel"
                aria-labelledby="portada-tab-titulares"
                data-front-page-panel="titulares"
              >
                <div class="headline-list">
                  <FrontPageHeadline
                    label="Internacional"
                    title={latestDaily.data.title}
                    href={`/ediciones/${latestDaily.id}/`}
                    cta="Ir a Internacional"
                    visual={dailyVisual}
                    eager
                  />

                  {latestNational && (
                    <FrontPageHeadline
                      label="Nacional"
                      title={latestNational.data.title}
                      href={`/nacional/${latestNational.id}/`}
                      cta="Ir a Nacional"
                      visual={nationalVisual}
                    />
                  )}

                  {latestMarkets && (
                    <FrontPageHeadline
                      label="Mercados"
                      title={latestMarkets.data.title}
                      href={`/mercados/${latestMarkets.id}/`}
                      cta="Ir a Mercados"
                      visual={marketsVisual}
                    />
                  )}
                </div>
              </div>

              <div
                id="portada-panel-senales"
                class="headline-tab-panel headline-tab-panel--signals"
                role="tabpanel"
                aria-labelledby="portada-tab-senales"
                data-front-page-panel="senales"
                hidden
              >
                <DailySignals />
              </div>
            </article>

            <EditorialDoubleRule />

            <aside class="edition-rail" aria-label="Claves de la edición">
              <p class="rail-title">En una mirada</p>
              <ol>
                {latestDaily.data.highlights?.map((highlight) => (
                  <li>
                    <strong>{highlight.label}</strong>
                    <span>{highlight.text}</span>
                  </li>
                ))}
              </ol>
            </aside>
          </section>
        </>
      ) : (
        <section class="empty">
          <h1>La próxima edición está en preparación</h1>
        </section>
      )
    }

    {
      hasAnalysisContent && (
        <section class="news-grid" aria-labelledby="analisis">
          <div class="section-rule">
            <h2 id="analisis">Análisis</h2>
          </div>
          <div class="columns">
            {latestNational && (
              <ContentCard
                href={`/nacional/${latestNational.id}/`}
                eyebrow="Nacional · Profundidad"
                title={latestNational.data.title}
                summary={latestNational.data.summary}
                date={formatEditorialDate(latestNational.data.publishedAt)}
                demo={latestNational.data.demo}
                visual={nationalVisual}
                visualAlways
                compact
              />
            )}
            {latestMarkets && (
              <ContentCard
                href={`/mercados/${latestMarkets.id}/`}
                eyebrow="Mercados · Profundidad"
                title={latestMarkets.data.title}
                summary={latestMarkets.data.summary}
                date={formatEditorialDate(latestMarkets.data.publishedAt)}
                demo={latestMarkets.data.demo}
                visual={marketsVisual}
                visualAlways
                compact
              />
            )}
          </div>
        </section>
      )
    }

    <section class="closing-grid" aria-label="Seguimiento editorial">
      <article>
        {
          latestReading ? (
            <>
              <p class="kicker">Última contingencia</p>
              <h2>
                <a href={`/lecturas/${latestReading.id}/`}>
                  {latestReading.data.title}
                </a>
              </h2>
              <p class="closing-summary">{latestReading.data.summary}</p>
              <a class="closing-link" href={`/lecturas/${latestReading.id}/`}>
                Abrir contingencia <span aria-hidden="true">→</span>
              </a>
            </>
          ) : (
            <>
              <p class="kicker">Contingencia</p>
              <h2>Próxima contingencia en preparación</h2>
            </>
          )
        }
      </article>
      <article>
        {
          latestDaily?.data.marketSummary ? (
            <MarketPulse
              asOf={latestDaily.data.marketSummary.asOf}
              items={latestDaily.data.marketSummary.items}
            />
          ) : (
            <>
              <p class="kicker">Qué observar</p>
              <h2>Las señales que pueden cambiar la lectura</h2>
              <p class="closing-summary">
                Cada edición separa los hechos, las implicancias y las
                condiciones que podrían invalidar la interpretación inicial.
              </p>
            </>
          )
        }
      </article>
      <article>
        {
          penultimateReading ? (
            <>
              <p class="kicker">Panorama semanal</p>
              <h2>
                <a href={`/lecturas/${penultimateReading.id}/`}>
                  {penultimateReading.data.title}
                </a>
              </h2>
              <p class="closing-summary">{penultimateReading.data.summary}</p>
              <a
                class="closing-link"
                href={`/lecturas/${penultimateReading.id}/`}
              >
                Abrir panorama <span aria-hidden="true">→</span>
              </a>
            </>
          ) : (
            <>
              <p class="kicker">Panorama semanal</p>
              <h2>Próximo panorama en preparación</h2>
            </>
          )
        }
      </article>
    </section>
  </main>

  <aside
    class="desktop-workspace-panel"
    data-atlas-workspace-panel
    aria-label="Panel contextual de ATLAS NEWS"
    aria-live="polite"
    aria-busy="true"
  >
    <div class="desktop-workspace-panel__status" data-atlas-workspace-status>
      Cargando índices de mercado…
    </div>
    <div class="desktop-workspace-panel__content" data-atlas-workspace-content>
    </div>
    <noscript>
      <p class="desktop-workspace-panel__noscript">
        <a href="/mercados/indices/">Abrir índices de mercado</a>
      </p>
    </noscript>
  </aside>

  <script>
    const setupFrontPageSwitcher = () => {
      const switcher = document.querySelector<HTMLElement>(
        "[data-front-page-switcher]",
      );
      if (!switcher) return;

      const tabs = Array.from(
        switcher.querySelectorAll<HTMLButtonElement>("[data-front-page-tab]"),
      );
      const panels = Array.from(
        switcher.querySelectorAll<HTMLElement>("[data-front-page-panel]"),
      );

      const activate = (name: string) => {
        tabs.forEach((tab) => {
          const active = tab.dataset.frontPageTab === name;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", String(active));
        });

        panels.forEach((panel) => {
          panel.hidden = panel.dataset.frontPagePanel !== name;
        });
      };

      tabs.forEach((tab) => {
        if (tab.dataset.frontPageTabReady === "true") return;
        tab.dataset.frontPageTabReady = "true";
        tab.addEventListener("click", () => {
          const name = tab.dataset.frontPageTab;
          if (name) activate(name);
        });
      });

      activate("titulares");
    };

    setupFrontPageSwitcher();
    document.addEventListener("astro:page-load", setupFrontPageSwitcher);
  </script>

  <script>
    const DESKTOP_WORKSPACE_QUERY = "(min-width: 80rem)";
    const DEFAULT_PANEL_PATH = "/mercados/indices/";
    const PANEL_PREFIXES = [
      "/internacional/",
      "/nacional/",
      "/mercados/",
      "/lecturas/",
      "/calendario-economico/",
      "/ediciones/",
    ];

    const desktopWorkspace = window.matchMedia(DESKTOP_WORKSPACE_QUERY);
    const panel = document.querySelector<HTMLElement>(
      "[data-atlas-workspace-panel]",
    );
    const panelContent = panel?.querySelector<HTMLElement>(
      "[data-atlas-workspace-content]",
    );
    const panelStatus = panel?.querySelector<HTMLElement>(
      "[data-atlas-workspace-status]",
    );
    let activeRequest: AbortController | null = null;

    const loadedStyles = new Set(
      Array.from(
        document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]'),
      ).map((link) => link.href),
    );

    const supportsPanelPath = (pathname: string) =>
      pathname === "/" ||
      PANEL_PREFIXES.some((prefix) => pathname.startsWith(prefix));

    const navPathFor = (pathname: string) => {
      if (pathname.startsWith("/nacional/")) return "/nacional/";
      if (
        pathname.startsWith("/mercados/") &&
        pathname !== DEFAULT_PANEL_PATH
      ) {
        return "/mercados/";
      }
      if (pathname.startsWith("/lecturas/")) return "/lecturas/";
      if (
        pathname.startsWith("/internacional/") ||
        pathname.startsWith("/ediciones/")
      ) {
        return "/internacional/";
      }
      return "/";
    };

    const syncPrimaryNavigation = (pathname: string) => {
      const activeHref = navPathFor(pathname);
      document
        .querySelectorAll<HTMLAnchorElement>(".site-header nav a")
        .forEach((link) => {
          const active = link.getAttribute("href") === activeHref;
          link.classList.toggle("is-active", active);
          if (active) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });
    };

    const panelPathFromLocation = () => {
      const requested = new URL(window.location.href).searchParams.get("panel");
      if (!requested) return "/";

      try {
        const url = new URL(requested, window.location.origin);
        if (
          url.origin === window.location.origin &&
          supportsPanelPath(url.pathname)
        ) {
          return url.pathname;
        }
      } catch {
        return "/";
      }

      return "/";
    };

    const ensurePanelStyles = async (documentFragment: Document) => {
      const pending = Array.from(
        documentFragment.querySelectorAll<HTMLLinkElement>(
          'link[rel="stylesheet"][href]',
        ),
      )
        .map((source) => {
          const href = new URL(
            source.getAttribute("href") ?? "",
            window.location.origin,
          ).href;
          if (!href || loadedStyles.has(href)) return null;

          loadedStyles.add(href);
          return new Promise<void>((resolve) => {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = href;
            link.dataset.atlasWorkspaceStyle = "true";
            link.addEventListener("load", () => resolve(), { once: true });
            link.addEventListener("error", () => resolve(), { once: true });
            document.head.append(link);
          });
        })
        .filter((promise): promise is Promise<void> => Boolean(promise));

      await Promise.all(pending);
    };

    const activatePanelScripts = (root: HTMLElement) => {
      root
        .querySelectorAll<HTMLScriptElement>("script")
        .forEach((oldScript) => {
          const script = document.createElement("script");
          Array.from(oldScript.attributes).forEach(({ name, value }) => {
            script.setAttribute(name, value);
          });
          script.textContent = oldScript.textContent;
          oldScript.replaceWith(script);
        });
    };

    const updateHistory = (requestedPath: string) => {
      const next = new URL(window.location.href);
      if (requestedPath === "/") next.searchParams.delete("panel");
      else next.searchParams.set("panel", requestedPath);

      window.history.pushState(
        { atlasPanel: requestedPath },
        "",
        `${next.pathname}${next.search}${next.hash}`,
      );
    };

    const showPanelError = (targetPath: string) => {
      if (!panelContent || !panelStatus || !panel) return;

      panelStatus.hidden = true;
      panel.removeAttribute("aria-busy");
      panelContent.replaceChildren();

      const message = document.createElement("section");
      message.className = "desktop-workspace-panel__error";
      const title = document.createElement("h2");
      title.textContent = "No fue posible cargar esta vista";
      const link = document.createElement("a");
      link.href = targetPath;
      link.textContent = "Abrir como página completa →";
      message.append(title, link);
      panelContent.append(message);
    };

    const loadPanel = async (
      requestedPath: string,
      options: { pushHistory?: boolean } = {},
    ) => {
      if (
        !panel ||
        !panelContent ||
        !panelStatus ||
        !desktopWorkspace.matches
      ) {
        return;
      }

      const targetPath =
        requestedPath === "/" ? DEFAULT_PANEL_PATH : requestedPath;
      if (!supportsPanelPath(targetPath)) return;

      activeRequest?.abort();
      activeRequest = new AbortController();
      const { signal } = activeRequest;

      panel.setAttribute("aria-busy", "true");
      panelStatus.hidden = false;
      panelStatus.textContent = "Cargando vista…";

      try {
        const response = await fetch(targetPath, {
          signal,
          credentials: "same-origin",
          headers: { "X-Atlas-Workspace": "desktop" },
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const sourceHtml = await response.text();
        const sourceDocument = new DOMParser().parseFromString(
          sourceHtml,
          "text/html",
        );
        const sourceContent =
          sourceDocument.querySelector<HTMLElement>("#contenido");
        if (!sourceContent)
          throw new Error("Contenido de destino no disponible");

        await ensurePanelStyles(sourceDocument);
        if (signal.aborted) return;

        panelContent.innerHTML = sourceContent.innerHTML;
        activatePanelScripts(panelContent);
        panel.scrollTo({ top: 0, behavior: "auto" });
        panelStatus.hidden = true;
        panel.removeAttribute("aria-busy");
        syncPrimaryNavigation(requestedPath);

        if (options.pushHistory) updateHistory(requestedPath);

        document.dispatchEvent(
          new CustomEvent("atlas:desktop-panel-change", {
            detail: { path: targetPath },
          }),
        );
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError")
          return;
        showPanelError(targetPath);
      }
    };

    const interceptWorkspaceLink = (event: MouseEvent) => {
      if (
        !desktopWorkspace.matches ||
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest<HTMLAnchorElement>("a[href]");
      if (!link || link.target || link.hasAttribute("download")) return;

      const url = new URL(link.href, window.location.href);
      if (
        url.origin !== window.location.origin ||
        !supportsPanelPath(url.pathname)
      ) {
        return;
      }

      event.preventDefault();
      void loadPanel(url.pathname, { pushHistory: true });
    };

    if (panel && panelContent && panelStatus) {
      document.addEventListener("click", interceptWorkspaceLink);
      window.addEventListener("popstate", () => {
        void loadPanel(panelPathFromLocation());
      });
      desktopWorkspace.addEventListener("change", ({ matches }) => {
        if (matches) void loadPanel(panelPathFromLocation());
      });

      if (desktopWorkspace.matches) {
        void loadPanel(panelPathFromLocation());
      }
    }
  </script>
</BaseLayout>

<style>
  .front-page {
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .issue-line {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .issue-line p {
    margin: 0;
  }
  .issue-line p:last-child {
    text-align: right;
  }
  .lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    border-bottom: 5px double var(--rule);
  }
  .lead-story {
    padding: clamp(2rem, 5vw, 4.5rem) 0 3rem;
    border-right: 0;
  }
  .headline-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 0 0.8rem;
    border-top: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
  }
  .headline-tab {
    min-width: 0;
    padding: 0.62rem 0.55rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font: 800 0.68rem/1.2 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .headline-tab + .headline-tab {
    border-left: 1px solid rgba(31, 29, 23, 0.16);
  }
  .headline-tab.is-active {
    background: rgba(31, 29, 23, 0.045);
    color: var(--accent);
  }
  .headline-tab[data-front-page-tab="senales"]::after {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-left: 0.42rem;
    border-radius: 50%;
    vertical-align: 0.08em;
    background: var(--accent);
    box-shadow: 0 0 5px rgba(142, 47, 36, 0.22);
    animation: headline-signal-active 1.8s ease-in-out infinite;
  }
  @keyframes headline-signal-active {
    0%,
    100% {
      opacity: 0.48;
    }

    50% {
      opacity: 0.95;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .headline-tab[data-front-page-tab="senales"]::after {
      animation: none;
      opacity: 0.88;
    }
  }
  .headline-tab:hover,
  .headline-tab:focus-visible {
    background: rgba(31, 29, 23, 0.035);
  }
  .headline-tab-panel[hidden] {
    display: none !important;
  }
  .headline-tab-panel--signals :global(.daily-signals) {
    padding: 0.15rem 0 0.35rem;
    border-top: 0;
  }
  .headline-tab-panel--signals :global(.daily-signals__title) {
    display: none;
  }
  .headline-tab-panel--signals :global(.daily-signals__group:first-child) {
    padding-top: 0.3rem;
  }
  .kicker,
  .headline-board-title {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .headline-list {
    margin-top: 0.8rem;
  }
  .edition-rail {
    padding: clamp(1.9rem, 3.8vw, 3.2rem) 0 clamp(2.1rem, 4vw, 3.6rem);
    border-top: 4px double var(--rule);
  }
  .rail-title {
    margin: 0;
    padding: 0 0 clamp(1rem, 1.9vw, 1.45rem);
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    font: 700 clamp(2.2rem, 4.4vw, 4.25rem) / 0.95 var(--serif);
    letter-spacing: -0.04em;
    text-transform: none;
  }
  .edition-rail ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: point;
  }
  .edition-rail li {
    display: grid;
    grid-template-columns: clamp(3.5rem, 5vw, 4.5rem) minmax(0, 1fr);
    padding: clamp(1rem, 1.7vw, 1.35rem) 0;
    border-top: 1px solid var(--rule);
    counter-increment: point;
  }
  .edition-rail li:first-child {
    border-top: 0;
  }
  .edition-rail li::before {
    content: "0" counter(point);
    color: var(--accent);
    font: 700 clamp(1.55rem, 2.6vw, 2rem) / 1 var(--serif);
    font-variant-numeric: tabular-nums;
  }
  .edition-rail strong,
  .edition-rail span {
    grid-column: 2;
  }
  .edition-rail strong {
    margin-bottom: 0.35rem;
    font: 700 clamp(1rem, 1.5vw, 1.2rem) / 1.14 var(--serif);
    letter-spacing: -0.01em;
    text-transform: none;
  }
  .edition-rail span {
    color: var(--ink-soft);
    font: 400 clamp(1.08rem, 1.9vw, 1.45rem) / 1.28 var(--serif);
  }
  .news-grid {
    padding-top: 2.5rem;
  }
  .section-rule {
    padding: 0.65rem 0;
    border-top: 4px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .section-rule h2 {
    margin: 0;
    font: 800 1.2rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
  .columns :global(.card) {
    padding-right: 1.5rem;
  }
  .columns :global(.card + .card) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }
  .closing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3rem;
    border-top: 5px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .closing-grid article {
    padding: 1.5rem;
  }
  .closing-grid article:first-child {
    padding-left: 0;
  }
  .closing-grid article + article {
    border-left: 1px solid var(--rule);
  }
  .closing-grid h2 {
