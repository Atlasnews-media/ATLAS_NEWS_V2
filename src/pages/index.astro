---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ATLAS NEWS">
  <main>
    <p class="eyebrow">MVP · Fundación técnica</p>
    <h1>ATLAS NEWS</h1>
    <p class="dek">
      Codex construye. GPT publica. ATLAS NEWS conserva, organiza y presenta.
    </p>
  </main>
</BaseLayout>

<style>
  main {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0;
    border-top: 0.25rem solid currentColor;
  }

  .eyebrow {
    font:
      700 0.75rem/1.2 system-ui,
      sans-serif;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 1rem 0;
    font-size: clamp(3rem, 12vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .dek {
    max-width: 45rem;
    font-size: clamp(1.25rem, 3vw, 2rem);
    line-height: 1.25;
  }
</style>
