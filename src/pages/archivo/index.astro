---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  dailyIssueNumber,
  editionDisplayLabel,
  formatEditorialDate,
  getPublishedEditions,
  getPublishedMarkets,
  getPublishedNational,
  getPublishedReadings,
} from "../../lib/content";

const [editions, national, markets, readings] = await Promise.all([
  getPublishedEditions(),
  getPublishedNational(),
  getPublishedMarkets(),
  getPublishedReadings(),
]);
---

<BaseLayout
  title="Archivo — ATLAS NEWS"
  description="Archivo cronológico de ediciones, Nacional, Mercados y Contingencia de ATLAS NEWS."
>
  <main class="page-shell">
    <p class="page-kicker">Historia editorial</p>
    <h1 class="page-title">Archivo</h1>

    <section aria-labelledby="archivo-ediciones">
      <h2 id="archivo-ediciones">Ediciones</h2>
      <ol>
        {
          editions.map((edition) => (
            <li>
              <time>{formatEditorialDate(edition.data.publishedAt)}</time>
              <a href={`/ediciones/${edition.id}/`}>{edition.data.title}</a>
              <span>
                {editionDisplayLabel(
                  edition,
                  dailyIssueNumber(edition, editions),
                )}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="archivo-nacional">
      <h2 id="archivo-nacional">Nacional</h2>
      <ol>
        {
          national.map((briefing) => (
            <li>
              <time>{formatEditorialDate(briefing.data.publishedAt)}</time>
              <a href={`/nacional/${briefing.id}/`}>{briefing.data.title}</a>
              <span>Nacional</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="archivo-mercados">
      <h2 id="archivo-mercados">Mercados</h2>
      <ol>
        {
          markets.map((briefing) => (
            <li>
              <time>{formatEditorialDate(briefing.data.publishedAt)}</time>
              <a href={`/mercados/${briefing.id}/`}>{briefing.data.title}</a>
              <span>Mercados</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="archivo-contingencia">
      <h2 id="archivo-contingencia">Contingencia</h2>
      <ol>
        {
          readings.map((reading) => (
            <li>
              <time>{formatEditorialDate(reading.data.publishedAt)}</time>
              <a href={`/lecturas/${reading.id}/`}>{reading.data.title}</a>
              <span>Contingencia</span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  section {
    margin-top: 3rem;
  }
  section h2 {
    padding: 0.65rem 0;
    border-top: 4px double var(--rule);
    border-bottom: 1px solid var(--rule);
    font: 800 1.2rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 12rem 1fr auto;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
  }
  a {
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }
  time,
  li span {
    font: 0.72rem/1.4 var(--sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @media (max-width: 42rem) {
    li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
