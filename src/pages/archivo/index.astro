---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  editionTypeLabel,
  formatEditorialDate,
  getPublishedEditions,
  getPublishedReadings,
} from "../../lib/content";

const [editions, readings] = await Promise.all([
  getPublishedEditions(),
  getPublishedReadings(),
]);
---

<BaseLayout
  title="Archivo — ATLAS NEWS"
  description="Archivo cronológico de ATLAS NEWS."
>
  <main>
    <p class="eyebrow">Historia editorial</p>
    <h1>Archivo</h1>
    <section aria-labelledby="archivo-ediciones">
      <h2 id="archivo-ediciones">Ediciones</h2>
      <ol>
        {
          editions.map((edition) => (
            <li>
              <time>{formatEditorialDate(edition.data.publishedAt)}</time>
              <a href={`/ediciones/${edition.id}/`}>{edition.data.title}</a>
              <span>{editionTypeLabel(edition.data.type)}</span>
            </li>
          ))
        }
      </ol>
    </section>
    <section aria-labelledby="archivo-lecturas">
      <h2 id="archivo-lecturas">Lecturas seleccionadas</h2>
      <ol>
        {
          readings.map((reading) => (
            <li>
              <time>{formatEditorialDate(reading.data.publishedAt)}</time>
              <a href={`/lecturas/${reading.id}/`}>{reading.data.title}</a>
              <span>Lectura seleccionada</span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0;
  }
  .eyebrow {
    font:
      700 0.75rem/1.2 system-ui,
      sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0.75rem 0 4rem;
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.9;
  }
  section {
    margin-top: 3rem;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid currentColor;
  }
  li {
    display: grid;
    grid-template-columns: 12rem 1fr auto;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid currentColor;
  }
  a {
    color: inherit;
    font-weight: 700;
  }
  time,
  li span {
    font:
      0.78rem/1.4 system-ui,
      sans-serif;
  }
  @media (max-width: 42rem) {
    li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
