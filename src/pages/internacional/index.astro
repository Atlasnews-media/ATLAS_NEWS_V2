---
import AtlasAudioPlayer from "../../components/AtlasAudioPlayer.astro";
import ContentCard from "../../components/ContentCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatEditorialDate,
  getPublishedInternational,
} from "../../lib/content";
import internationalLatest from "../../../config/audio/international-latest.json";

const editions = await getPublishedInternational();
const currentInternational = editions[0];
const activeInternationalAudio =
  currentInternational &&
  internationalLatest.sourceId === currentInternational.id
    ? internationalLatest.audio
    : undefined;
---

<BaseLayout
  title="Internacional — ATLAS NEWS"
  description="Seguimiento internacional de ATLAS NEWS: hechos globales, transmisión económica y riesgos que condicionan la jornada."
>
  <main class="page-shell">
    <p class="page-kicker">Contexto global</p>
    <h1 class="page-title">Internacional</h1>
    <p class="page-intro">
      Los hechos internacionales que marcan la edición diaria de ATLAS NEWS, con
      su contexto, implicancias y señales a observar.
    </p>

    {
      activeInternationalAudio && (
        <section
          class="international-analysis-audio"
          aria-labelledby="international-analysis-audio-title"
        >
          <div class="audio-copy">
            <p class="audio-kicker" id="international-analysis-audio-title">
              Escuchar el análisis internacional
            </p>
            <p>
              Una conversación breve para entender qué hay detrás de las señales
              que están moviendo al mundo.
            </p>
          </div>
          <div class="audio-player">
            <AtlasAudioPlayer
              src={activeInternationalAudio.src}
              preload="metadata"
              ariaLabel="Análisis internacional de ATLAS NEWS"
            />
          </div>
        </section>
      )
    }

    {
      editions.length > 0 ? (
        <div class="briefing-list">
          {editions.map((edition) => (
            <ContentCard
              href={`/ediciones/${edition.id}/`}
              eyebrow="Internacional"
              title={edition.data.title}
              summary={edition.data.summary}
              date={formatEditorialDate(edition.data.publishedAt)}
              demo={edition.data.demo}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">
          Aún no hay publicaciones internacionales disponibles.
        </p>
      )
    }
  </main>
</BaseLayout>

<style>
  .international-analysis-audio {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
    margin-top: 1.75rem;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .audio-kicker {
    margin: 0;
    color: var(--accent);
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .audio-copy > p:last-child {
    max-width: 45rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .audio-player {
    min-width: 0;
  }
  .briefing-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 5px double var(--rule);
  }
  .briefing-list :global(.card) {
    padding: 1.75rem;
    border-top-width: 1px;
  }
  .briefing-list :global(.card:nth-child(odd)) {
    padding-left: 0;
    border-right: 1px solid var(--rule);
  }
  .empty-state {
    margin-top: 2rem;
    padding: 2rem 0;
    border-top: 5px double var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    font: 0.95rem/1.5 var(--sans);
  }
  @media (max-width: 42rem) {
    .page-intro {
      display: none;
    }
    .international-analysis-audio {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 1.35rem;
      padding: 1.1rem 0 1.25rem;
    }
    .briefing-list {
      grid-template-columns: 1fr;
    }
    .briefing-list :global(.card),
    .briefing-list :global(.card:nth-child(odd)) {
      padding-right: 0;
      padding-left: 0;
      border-right: 0;
    }
  }
</style>
