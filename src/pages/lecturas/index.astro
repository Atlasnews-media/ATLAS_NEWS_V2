---
import ContentCard from "../../components/ContentCard.astro";
import ReadingAudio from "../../components/ReadingAudio.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatEditorialDate, getPublishedReadings } from "../../lib/content";
import { resolveFrontPageVisual } from "../../lib/front-page-visuals";
import contingencyLatest from "../../../config/audio/contingency-latest.json";

const readings = await getPublishedReadings();
const currentReading = readings[0];
const activeAudio = currentReading
  ? contingencyLatest.sourceId === currentReading.id
    ? contingencyLatest.audio
    : currentReading.data.audio
  : undefined;

function readingEyebrow(tags: string[]) {
  if (tags.includes("radar-ipsa")) return "Radar IPSA";
  if (tags.includes("buzon-editorial")) return "Buzón editorial";
  return "Contingencia";
}
---

<BaseLayout
  title="Contingencia — ATLAS NEWS"
  description="Publicaciones eventuales de Contingencia de ATLAS NEWS."
>
  <main class="page-shell section-page">
    <p class="page-kicker">Cobertura eventual</p>
    <h1 class="page-title">Contingencia</h1>
    <p class="page-intro">
      Publicaciones activadas cuando un hecho requiere contexto adicional, una
      lectura especial o seguimiento fuera del flujo diario.
    </p>

    {currentReading && <ReadingAudio audio={activeAudio} />}

    <div class="reading-list">
      {
        readings.map((reading) => (
          <ContentCard
            href={`/lecturas/${reading.id}/`}
            eyebrow={readingEyebrow(reading.data.tags)}
            title={reading.data.title}
            summary={reading.data.summary}
            date={formatEditorialDate(reading.data.publishedAt)}
            demo={reading.data.demo}
            visual={resolveFrontPageVisual({
              section: "national",
              id: reading.id,
              title: reading.data.title,
              tags: reading.data.tags,
              editorialVisual: reading.data.editorialVisual,
            })}
          />
        ))}
      }
    </div>
  </main>
</BaseLayout>

<style>
  .reading-list {
    max-width: 64rem;
    border-top: 5px double var(--rule);
  }
  .reading-list :global(.card) {
    padding: 1.15rem 0 1.2rem;
  }
  @media (max-width: 42rem) {
    .page-intro {
      display: none;
    }
  }
</style>
