---
import ContentCard from "../../components/ContentCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatEditorialDate, getPublishedReadings } from "../../lib/content";
const readings = await getPublishedReadings();
---

<BaseLayout
  title="Lecturas seleccionadas — ATLAS NEWS"
  description="Selección editorial de lecturas de ATLAS NEWS."
>
  <main class="page-shell">
    <p class="page-kicker">Curaduría</p>
    <h1 class="page-title">Lecturas seleccionadas</h1>
    <p class="page-intro">
      Textos elegidos por su capacidad de aportar contexto, método o una
      perspectiva verificable.
    </p>
    <div class="reading-list">
      {
        readings.map((reading) => (
          <ContentCard
            href={`/lecturas/${reading.id}/`}
            eyebrow="Lectura seleccionada"
            title={reading.data.title}
            summary={reading.data.summary}
            date={formatEditorialDate(reading.data.publishedAt)}
            demo={reading.data.demo}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .reading-list {
    max-width: 64rem;
    border-top: 5px double var(--rule);
  }
  .reading-list :global(.card) {
    padding: 2rem 0;
  }
</style>
