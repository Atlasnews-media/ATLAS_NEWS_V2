---
import { render } from "astro:content";
import ArticleHeader from "../../components/ArticleHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatEditorialDate,
  getPublishedReadings,
  type Reading,
} from "../../lib/content";

export async function getStaticPaths() {
  const readings = await getPublishedReadings();
  return readings.map((reading) => ({
    params: { id: reading.id },
    props: { reading },
  }));
}

interface Props {
  reading: Reading;
}
const { reading } = Astro.props;
const { Content } = await render(reading);
---

<BaseLayout
  title={`${reading.data.title} — ATLAS NEWS`}
  description={reading.data.summary}
>
  <main class="article-page">
    <ArticleHeader
      eyebrow="Lectura seleccionada"
      title={reading.data.title}
      summary={reading.data.summary}
      date={formatEditorialDate(reading.data.publishedAt)}
      demo={reading.data.demo}
      tags={reading.data.tags}
    />
    {
      reading.data.audio && (
        <section class="reading-audio" aria-label="Audio de la Lectura Seleccionada">
          <div class="reading-audio__copy">
            <p class="reading-audio__eyebrow">Escuchar esta lectura</p>
            <p class="reading-audio__meta">
              Narrada por {reading.data.audio.voice} · {reading.data.audio.durationLabel}
            </p>
          </div>
          <audio controls preload="metadata">
            <source src={reading.data.audio.src} type="audio/mpeg" />
            Tu navegador no puede reproducir este audio.
          </audio>
        </section>
      )
    }
    <article class="prose"><Content /></article>
    <p class="source">
      <strong>Fuente original:</strong>
      <a href={reading.data.source.url}>{reading.data.source.name}</a>
    </p>
  </main>
</BaseLayout>

<style>
  .article-page {
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }
  .reading-audio {
    max-width: 52rem;
    margin: 2.25rem auto 0;
    padding: 1.1rem 0 1.25rem;
    border-top: 4px double var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .reading-audio__copy {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }
  .reading-audio__eyebrow,
  .reading-audio__meta {
    margin: 0;
    font-family: var(--sans);
  }
  .reading-audio__eyebrow {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .reading-audio__meta {
    color: var(--muted);
    font-size: 0.86rem;
  }
  .reading-audio audio {
    display: block;
    width: 100%;
  }
  .prose {
    max-width: 52rem;
    margin: 3.5rem auto;
    font-size: 1.1rem;
    line-height: 1.72;
  }
  .prose :global(p:first-of-type:first-letter) {
    float: left;
    margin: 0.08em 0.08em 0 0;
    color: var(--accent);
    font-size: 4.6rem;
    font-weight: 700;
    line-height: 0.72;
  }
  .prose :global(h2) {
    margin: 3.5rem 0 1rem;
    padding-top: 0.65rem;
    border-top: 4px double var(--rule);
    font: 800 clamp(1.55rem, 4vw, 2.45rem)/1 var(--sans);
  }
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-top: 2px solid var(--rule);
    border-bottom: 2px solid var(--rule);
    font: 700 1.25rem/1.45 var(--serif);
  }
  .source {
    max-width: 52rem;
    margin: 4rem auto;
    padding-top: 1.5rem;
    border-top: 4px double var(--rule);
  }
  @media (max-width: 42rem) {
    .article-page {
      width: min(100% - 1.25rem, 88rem);
    }
    .reading-audio__copy {
      display: block;
    }
    .reading-audio__meta {
      margin-top: 0.25rem;
    }
  }
</style>
