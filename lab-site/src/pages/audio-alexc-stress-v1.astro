---
import "../../../src/styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#f2efe5" />
    <title>ATLAS NEWS LAB · Acentuación Alex C</title>
  </head>
  <body>
    <main class="lab-shell">
      <p class="lab-kicker">ATLAS NEWS · AUDIO LAB</p>
      <h1>Acentuación Alex C</h1>
      <p class="lead">
        Una sola muestra. Mismo perfil de Alex C, con marcas de acento añadidas
        únicamente al texto hablado para comprobar si mejora la sílaba tónica.
      </p>

      <div class="rule" aria-hidden="true"></div>

      <section class="audio-card">
        <p class="status">Muestra corregida · Speech-only</p>
        <h2>Alex C con acentuación explícita</h2>
        <audio controls preload="metadata">
          <source
            src="/lab/audio/alexc-stress-v1/alexc-accent-corrected.mp3"
            type="audio/mpeg"
          />
        </audio>
      </section>

      <div class="rule" aria-hidden="true"></div>

      <p class="note">
        Producción no fue modificada. Esta prueba sólo evalúa acentuación.
      </p>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #f2efe5;
    color: #151515;
  }

  .lab-shell {
    width: min(52rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(3.5rem, 10vw, 7rem) 0;
  }

  .lab-kicker,
  .status {
    margin: 0;
    font: 800 0.72rem/1.2 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.75rem 0 1rem;
    font: 700 clamp(2.7rem, 9vw, 6rem) / 0.92 var(--display);
    letter-spacing: -0.04em;
  }

  h2 {
    margin: 0.45rem 0 1rem;
    font: 700 clamp(1.6rem, 4vw, 2.5rem) / 1 var(--display);
  }

  .lead,
  .note {
    max-width: 46rem;
    font: 400 1rem/1.6 var(--serif);
  }

  .rule {
    height: 4px;
    margin: 2.5rem 0;
    border-top: 1px solid #151515;
    border-bottom: 1px solid #151515;
  }

  .audio-card {
    padding: 1.25rem;
    border: 1px solid #151515;
    border-top: 5px solid #a71920;
    background: rgba(255, 255, 255, 0.18);
  }

  audio {
    width: 100%;
  }
</style>
