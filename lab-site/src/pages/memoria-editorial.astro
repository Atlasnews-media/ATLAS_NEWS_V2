---
import BaseLayout from "../../../src/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Internacional — ATLAS NEWS LAB"
  description="Versión experimental de Internacional generada con memoria editorial."
>
  <main class="article-page" data-lab-experiment="EXP-011">
    <header class="article-header">
      <div class="article-header-copy">
        <div class="meta">
          <span>Internacional</span>
          <span aria-hidden="true">◆</span>
          <span>ATLAS NEWS</span>
        </div>

        <h1 id="articleTitle">Cargando publicación…</h1>
        <p class="summary" id="articleSummary">
          Preparando la versión experimental.
        </p>

        <div class="publication-data">
          <dl>
            <div>
              <dt>Publicado</dt>
              <dd id="publishedAt">—</dd>
            </div>
            <div>
              <dt>Cierre</dt>
              <dd id="cutoffAt">—</dd>
            </div>
          </dl>
          <ul class="tags" id="articleTags" aria-label="Etiquetas"></ul>
        </div>
      </div>
    </header>

    <article class="prose" id="articleBody">
      <p>
        La vista se completará cuando exista una corrida válida del experimento.
      </p>
    </article>

    <section class="sources" aria-labelledby="fuentes-documentadas">
      <h2 id="fuentes-documentadas">Fuentes documentadas</h2>
      <ul id="sourceList">
        <li>Esperando datos de la publicación experimental.</li>
      </ul>
    </section>

    <p class="lab-disclaimer">
      LAB · Versión experimental de memoria editorial. No modifica la publicación
      productiva de ATLAS NEWS.
    </p>

    <p class="return-link">
      <a href="/lab/">← Volver al laboratorio</a>
    </p>
  </main>

  <script>
    const runtimeUrl = "/lab/editorial-memory-judge/latest.json";
    const bootstrapUrl = "/lab/editorial-memory-judge/bootstrap.json";
    const inputUrl = "/lab/editorial-memory-judge/input.json";

    function formatDate(value) {
      if (!value) return "—";
      const date = new Date(value);
      if (Number.isNaN(date.valueOf())) return value;
      return new Intl.DateTimeFormat("es-CL", {
        dateStyle: "medium",
        timeStyle: "short",
        timeZone: "America/Santiago",
      }).format(date);
    }

    function renderTags(tags) {
      const list = document.querySelector("#articleTags");
      if (!(list instanceof HTMLUListElement)) return;
      const safeTags = Array.isArray(tags) ? tags : [];
      list.replaceChildren(
        ...safeTags.map((tag) => {
          const li = document.createElement("li");
          li.textContent = tag;
          return li;
        }),
      );
    }

    function renderSources(sources) {
      const list = document.querySelector("#sourceList");
      if (!(list instanceof HTMLUListElement)) return;

      const safeSources = Array.isArray(sources) ? sources : [];
      if (safeSources.length === 0) {
        const li = document.createElement("li");
        li.textContent = "Sin fuentes disponibles.";
        list.replaceChildren(li);
        return;
      }

      list.replaceChildren(
        ...safeSources.map((source) => {
          const li = document.createElement("li");
          if (source?.url) {
            const link = document.createElement("a");
            link.href = source.url;
            link.textContent = source.name ?? source.url;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            li.append(link);
          } else {
            li.textContent = source?.name ?? "Fuente";
          }
          return li;
        }),
      );
    }

    function renderMarkdownBody(markdown) {
      const body = document.querySelector("#articleBody");
      if (!(body instanceof HTMLElement)) return;

      const source = typeof markdown === "string" ? markdown.trim() : "";
      if (!source) {
        const paragraph = document.createElement("p");
        paragraph.textContent =
          "La corrida experimental no incluyó un cuerpo editorial completo.";
        body.replaceChildren(paragraph);
        return;
      }

      const fragment = document.createDocumentFragment();
      const blocks = source.split(/\n\s*\n/);

      for (const rawBlock of blocks) {
        const block = rawBlock.trim();
        if (!block) continue;

        if (block.startsWith("## ")) {
          const heading = document.createElement("h2");
          heading.textContent = block.slice(3).trim();
          fragment.append(heading);
          continue;
        }

        const paragraph = document.createElement("p");
        paragraph.textContent = block.replace(/\n/g, " ").trim();
        fragment.append(paragraph);
      }

      body.replaceChildren(fragment);
    }

    async function loadJson(url) {
      const response = await fetch(url, { cache: "no-store" });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return await response.json();
    }

    async function loadExperimentData() {
      let runtime = null;
      try {
        runtime = await loadJson(runtimeUrl);
      } catch {
        runtime = await loadJson(bootstrapUrl);
      }
      const input = await loadJson(inputUrl);
      return { runtime, input };
    }

    loadExperimentData()
      .then(({ runtime, input }) => {
        const article = runtime.experimentalArticle;
        const candidate = input.candidates?.find(
          (item) => item.section === "general",
        );

        if (!article || article.section !== "general") {
          throw new Error("Sin artículo experimental Internacional");
        }

        const title = document.querySelector("#articleTitle");
        const summary = document.querySelector("#articleSummary");
        const publishedAt = document.querySelector("#publishedAt");
        const cutoffAt = document.querySelector("#cutoffAt");

        if (title) title.textContent = article.title;
        if (summary) summary.textContent = article.summary;
        if (publishedAt) {
          publishedAt.textContent = formatDate(
            article.publishedAt ?? candidate?.published_at,
          );
        }
        if (cutoffAt) {
          cutoffAt.textContent = formatDate(
            article.cutoffAt ?? candidate?.cutoff_at,
          );
        }

        renderTags(article.tags ?? candidate?.tags);
        renderMarkdownBody(article.bodyMarkdown);
        renderSources(article.sources ?? candidate?.sources);
      })
      .catch(() => {
        const title = document.querySelector("#articleTitle");
        const summary = document.querySelector("#articleSummary");
        const body = document.querySelector("#articleBody");

        if (title) title.textContent = "Experimento sin publicación completa";
        if (summary) {
          summary.textContent =
            "La corrida disponible todavía no contiene una versión editorial comparable.";
        }
        if (body) {
          const paragraph = document.createElement("p");
          paragraph.textContent =
            "No se muestra una versión parcial para evitar comparaciones engañosas.";
          body.replaceChildren(paragraph);
        }
      });
  </script>
</BaseLayout>

<style>
  .article-page {
    width: min(88rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .article-header {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(1.4rem, 4vw, 2.8rem) 0 1.5rem;
    border-bottom: 4px double var(--rule);
  }

  .article-header-copy {
    position: relative;
    z-index: 2;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    color: var(--accent);
    font: 800 0.7rem/1.2 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-header h1 {
    max-width: 76rem;
    margin: 0.9rem 0 1rem;
    font-size: clamp(2.25rem, 6.375vw, 5.625rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .summary {
    max-width: 58rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 2.2vw, 1.45rem);
    line-height: 1.38;
  }

  .publication-data {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .publication-data dl,
  .publication-data dl div,
  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .publication-data dl {
    gap: 0.45rem 1.4rem;
    margin: 0;
    font: 0.7rem/1.35 var(--sans);
    text-transform: uppercase;
  }

  .publication-data dl div {
    gap: 0.35rem;
  }

  .publication-data dt {
    font-weight: 800;
  }

  .publication-data dd {
    margin: 0;
  }

  .tags {
    justify-content: flex-end;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.18rem 0.4rem;
    border: 1px solid var(--rule);
    font: 0.62rem/1.2 var(--sans);
    text-transform: uppercase;
  }

  .prose {
    max-width: 52rem;
    margin: 2.5rem auto 3.5rem;
    font-size: 1.1rem;
    line-height: 1.72;
  }

  .prose :global(p:first-of-type:first-letter) {
    float: left;
    margin: 0.08em 0.08em 0 0;
    color: var(--accent);
    font-size: 4.6rem;
    font-weight: 700;
    line-height: 0.72;
  }

  .prose :global(h2) {
    margin: 3rem 0 1rem;
    padding-top: 0.65rem;
    border-top: 4px double var(--rule);
    font: 800 clamp(1.55rem, 4vw, 2.45rem) / 1 var(--sans);
    letter-spacing: -0.02em;
  }

  .sources,
  .return-link,
  .lab-disclaimer {
    max-width: 52rem;
    margin: 4rem auto;
  }

  .sources {
    padding-top: 1.5rem;
    border-top: 4px double var(--rule);
  }

  .sources h2 {
    font: 800 1.1rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sources li {
    margin: 0.7rem 0;
  }

  .lab-disclaimer {
    margin-top: 2rem;
    margin-bottom: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font: 0.7rem/1.5 var(--sans);
    letter-spacing: 0.02em;
  }

  .return-link {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font: 800 0.8rem/1.4 var(--sans);
    text-transform: uppercase;
  }

  @media (max-width: 42rem) {
    .article-page {
      width: min(100% - 1.25rem, 88rem);
    }

    .article-header {
      padding: 0.72rem 0 0.85rem;
    }

    .article-header h1 {
      margin: 0.58rem 0 0.72rem;
      font-size: clamp(2.15rem, 9.2vw, 2.85rem);
      line-height: 0.92;
    }

    .summary {
      font-size: 0.98rem;
      line-height: 1.34;
    }

    .publication-data {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.55rem;
      margin-top: 0.85rem;
    }

    .tags {
      justify-content: flex-start;
    }

    .prose {
      margin-top: 1.55rem;
      font-size: 1.03rem;
    }
  }
</style>
