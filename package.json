{
  "name": "atlas-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "audit:production": "node scripts/audit-publication.mjs",
    "build": "npm run update:indicators && npm run build:site",
    "build:site": "npm run validate:content && npm run status:generate && astro check && astro build && npm run validate:build",
    "check": "astro check",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --write scripts/audit-publication.mjs scripts/validate-build.mjs && git diff -- scripts/audit-publication.mjs scripts/validate-build.mjs && exit 1",
    "editorial:from-issue": "node scripts/create-reading-from-issue.mjs",
    "radar:discover": "node scripts/discover-radar-readings.mjs",
    "status:generate": "node scripts/generate-publication-status.mjs",
    "update:indicators": "node scripts/update-economic-indicators.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:build": "node scripts/validate-build.mjs"
  },
  "dependencies": {
    "astro": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
